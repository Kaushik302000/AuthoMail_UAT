<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <add name="AuthoMail" connectionString="Data Source=(localdb)\v19;Initial Catalog=AuthoMail;Connection Timeout=120;pooling=true;" providerName="System.Data.SqlClient" />
    <add name="AMTesting" connectionString="Data Source =E:\Database\AMTesting.db;" providerName="System.Data.SQLite" />
  </connectionStrings>
  <appSettings>
    <!-- Local Configuration -->
    <add key="TokenURL" value="http://localhost:17005/token" />
    <add key="RequestURL" value="http://localhost:17005/api/mailrequest" />
    <add key="ResponseURL" value="http://localhost:17005/api/mailresponse?mailPieceIds={0}" />
    <add key="Uname" value="amtest" />
    <add key="Password" value="Amtest@123" />
