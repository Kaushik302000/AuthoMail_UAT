<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
	</startup>
	<connectionStrings>
		<add name="AuthoMail" connectionString="Data Source=cet_01_ps_sq_uw1_reg.data.solutions.corelogic.com;Initial Catalog=AuthoMail;Persist Security Info=True;User ID=AuthomailUser;Password=Authomail@User" providerName="System.Data.SqlClient" />

		<!-- <add name="AuthoMail" connectionString="Data Source={DbServerName};Initial Catalog={dbName};Connection Timeout=120;user id={UserId};password={password};pooling=true;Max Pool Size=600" providerName="System.Data.SqlClient" /> -->
	</connectionStrings>
	<appSettings>
		<add key="log4net.Config" value="log4net.config"/>
		<add key="log4net.Config.Watch" value="True"/>
	</appSettings>
	<system.net>
		<mailSettings>
			<smtp deliveryMethod="Network" from="donotreply@corelogic.com">
				<network host="smtp.solutions.corelogic.com" defaultCredentials="true" />
			</smtp>
		</mailSettings>
	</system.net>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0"/>
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>
