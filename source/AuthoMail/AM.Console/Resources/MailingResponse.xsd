<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.corelogic.com/ade/authomail/v1.19.0" elementFormDefault="qualified" targetNamespace="http://schemas.corelogic.com/ade/authomail/v1.19.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="MailBatchResponse" type="tns:MailBatchResponse" />
	<xs:complexType name="MailBatchResponse">
		<xs:all>
			<xs:element minOccurs="0" maxOccurs="1" name="MailPiecesReport" type="tns:MailPiecesReport" />
		</xs:all>
		<xs:attribute name="Id" type="tns:guid" use="optional" />
		<xs:attribute name="ClientCode" type="tns:nonEmptyString" use="required" />
		<xs:attribute name="ClientBatchId" type="tns:nonEmptyString" use="optional" />
		<xs:attribute name="BatchName" type="xs:string" use="optional" />
		<xs:attribute name="ErrorDescription" type="xs:string" use="optional" />
	</xs:complexType>
	<xs:complexType name="MailPiecesReport">
		<xs:sequence>
			<xs:element minOccurs="1" maxOccurs="unbounded" name="MailPieceReport" type="tns:MailPieceReport" />
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MailPieceReport">
		<xs:attribute name="Id" type="tns:guid" use="optional" />
		<xs:attribute name="BusinessFriendlyIdName" type="tns:nonEmptyString" use="optional" />
		<xs:attribute name="BusinessFriendlyIdValue" type="tns:nonEmptyString" use="optional" />
		<xs:attribute name="DocumentOrPackageType" type="tns:nonEmptyString" use="optional" />
		<xs:attribute name="FileName" type="tns:nonEmptyString" use="optional" />
		<xs:attribute name="MailingStatus" type="tns:MailingStatus" use="required" />
		<xs:attribute name="TrackingNumber" type="tns:nonEmptyString" use="optional"/>
		<xs:attribute name="TotalSheets" type="tns:TotalSheets" use="optional" />
		<xs:attribute name="ShippedOn" type="xs:dateTime" use="optional" />
		<xs:attribute name="PulledBackOn" type="xs:dateTime" use="optional" />
		<xs:attribute name="Postage" type="tns:Money" use="optional" />
		<xs:attribute name="WeightMeasured" type="tns:WeightMeasured" use="optional" />
		<xs:attribute name="ErrorCode" type="xs:string" use="optional" />
		<xs:attribute name="ErrorDesc" type="xs:string" use="optional" />
	</xs:complexType>
	<xs:simpleType name="guid">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="nonEmptyString">
		<xs:restriction base="xs:string">
			<xs:pattern value="(\s*\S\s*)+"></xs:pattern>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TotalSheets">
		<xs:restriction base="xs:nonNegativeInteger">
			<xs:minInclusive value="1"></xs:minInclusive>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MailingStatus">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Shipped"/>
			<xs:enumeration value="Error"/>
			<xs:enumeration value="PulledBack" />
			<xs:enumeration value="eDelivered" />
      <xs:enumeration value="eSigned" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Money">
		<xs:restriction base="xs:decimal">
			<xs:pattern value="(^\d{1,9}$)|(^\.\d{1,4}$)|(^\d{1,9}\.\d{1,4}$)"/>
			<xs:minInclusive value="0" />
			<xs:maxInclusive value="999999999.9999" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="WeightMeasured">
		<xs:restriction base="xs:decimal">
			<xs:pattern value="(^\d{1,3}$)|(^\.\d{1,4}$)|(^\d{1,3}\.\d{1,4}$)"/>
			<xs:minInclusive value="0" />
			<xs:maxInclusive value="9.9999" />
		</xs:restriction>
	</xs:simpleType>
</xs:schema>