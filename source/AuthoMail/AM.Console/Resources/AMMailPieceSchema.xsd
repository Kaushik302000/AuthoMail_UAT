<?xml version="1.0" encoding="utf-8"?>
<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="MailPiece" type="MailPiece" />
  <xs:complexType name="MailPiece">
    <xs:all>
      <xs:element minOccurs="1" maxOccurs="1" name="DocumentOrPackage" type="DocumentOrPackage" />
      <xs:element minOccurs="0" maxOccurs="1" name="eDelivery" type="eDelivery" />
      <xs:element minOccurs="0" maxOccurs="1" name="RecipientInfo" type="RecipientInfo" />
      <xs:element minOccurs="0" maxOccurs="1" name="ReturnInfo" type="ReturnInfo" />
      <xs:element minOccurs="0" maxOccurs="1" name="CustomInfo" type="CustomInfo" />
    </xs:all>
    <xs:attribute name="Id" type="guid" use="optional" />
    <xs:attribute name="BusinessFriendlyIdName" type="nonEmptyString" use="optional" />
    <xs:attribute name="BusinessFriendlyIdValue" type="nonEmptyString" use="optional" />
    <xs:attribute name="DocumentOrPackageType" type="nonEmptyString" use="optional" />
  </xs:complexType>
  <xs:complexType name="DocumentOrPackage">
    <xs:attribute name="Name" type="nonEmptyString" use="optional" />
    <xs:attribute name="Pattern" type="nonEmptyString" use="optional" />
    <xs:attribute name="Base64String" type="xs:base64Binary" use="optional" />
    <xs:attribute name="Inserts" type="xs:string" use="optional" />
  </xs:complexType>
  <xs:complexType name="RecipientInfo">
    <xs:all>
      <xs:element minOccurs="1" maxOccurs="1" name="Recipient" type="Recipient" />
      <xs:element minOccurs="0" maxOccurs="1" name="Address" type="Address" />
    </xs:all>
  </xs:complexType>
  <xs:complexType name="Recipient">
    <xs:attribute name="Organization" type="xs:string" use="optional" />
    <xs:attribute name="Prefix" type="xs:string" use="optional" />
    <xs:attribute name="FirstName" type="xs:string" use="optional"  />
    <xs:attribute name="MiddleName" type="xs:string" use="optional"  />
    <xs:attribute name="LastName" type="xs:string" use="optional"  />
    <xs:attribute name="Suffix" type="xs:string"  use="optional" />
    <xs:attribute name="Phone" type="NAPhone" use="optional" />
    <xs:attribute name="EmailAddress" type="nonEmptyString" use="optional"  />
  </xs:complexType>
  <xs:complexType name="Address">
    <xs:attribute name="OptionalLine1AboveStreet" type="xs:string" use="optional"  />
    <xs:attribute name="OptionalLine2AboveStreet" type="xs:string" use="optional"  />
    <xs:attribute name="Street" type="nonEmptyString" use="optional"  />
    <xs:attribute name="AptOrSuiteOrOther" type="xs:string" use="optional"  />
    <xs:attribute name="OptionalLine1BelowStreet" type="xs:string" use="optional"  />
    <xs:attribute name="OptionalLine2BelowStreet" type="xs:string" use="optional"  />
    <xs:attribute name="City" type="nonEmptyString" use="optional"  />
    <xs:attribute name="State" type="nonEmptyString" use="optional"  />
    <xs:attribute name="Zip" type="nonEmptyString" use="optional"  />
    <xs:attribute name="Country" type="nonEmptyString" use="optional"  />
  </xs:complexType>
  <xs:complexType name="eDelivery">
    <xs:attribute name="ExpiryDate" type="xs:date" use="optional" />
    <xs:attribute name="IsEsign" type="xs:boolean" use="optional" />
    <xs:attribute name="PrintAndShipOnExpiry" type="xs:boolean" use="required" />
  </xs:complexType>
  <xs:complexType name="ReturnInfo">
    <xs:all>
      <xs:element minOccurs="1" maxOccurs="1" name="Recipient" type="Recipient" />
      <xs:element minOccurs="1" maxOccurs="1" name="Address" type="Address" />
    </xs:all>
  </xs:complexType>
  <xs:complexType name="CustomInfo">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="unbounded" name="Metadata" type="Metadata" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Metadata">
    <xs:attribute name="Key" type="nonEmptyString" use="required" />
    <xs:attribute name="DataType" type="DataType" use="required" />
    <xs:attribute name="Value" type="xs:string" use="required" />
  </xs:complexType>
  <xs:simpleType name="Priority">
    <xs:restriction base="xs:string">
      <xs:enumeration value="High" />
      <xs:enumeration value="Medium" />
      <xs:enumeration value="Low" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DataType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="String" />
      <xs:enumeration value="DateTime" />
      <xs:enumeration value="Boolean" />
      <xs:enumeration value="Integer" />
      <xs:enumeration value="Float" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="guid">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="nonEmptyString">
    <xs:restriction base="xs:string">
      <xs:pattern value="(\s*\S\s*)+"></xs:pattern>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="USZIP">
    <xs:restriction base="xs:string">
      <xs:pattern value="^(?(^00000(|-0000))|\d{5}(?:|[-\s]+\d{4}))$"></xs:pattern>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="NAPhone">
    <xs:restriction base="xs:string">
      <xs:pattern value="^\(?([2-9][0-8][0-9])\)?[-. ]?([2-9][0-9]{2})[-. ]?([0-9]{4})$"></xs:pattern>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
