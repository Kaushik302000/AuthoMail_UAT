<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="AuthoMail" connectionString="Data Source=cet_01_ps_sq_uc1_dr.data.solutions.corelogic.com;Initial Catalog=AuthoMail;Persist Security Info=True;User ID=AuthomailUser;Password=Authomail@User" providerName="System.Data.SqlClient" />
    <!--<add name="AuthoMail" connectionString="Data Source=cet_01_ps_sq_uw1_reg.data.solutions.corelogic.com;Initial Catalog=AuthoMail_UAT;Persist Security Info=True;User ID=AuthomailUser;Password=Authomail@User" providerName="System.Data.SqlClient" />-->
    <!--<add name="AuthoMail" connectionString="Data Source={DbServerName};Initial Catalog={dbName};Connection Timeout=120;user id={UserId};password={password};pooling=true;Max Pool Size=600" providerName="System.Data.SqlClient" /> -->
    <!--<add name="AuthoMail" connectionString="Data Source=cet_01_ps_sq_uw1_uat.data.solutions.corelogic.com;Initial Catalog=Authomail_UAT;Connection Timeout=120;Integrated Security=True;pooling=true;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />-->
  </connectionStrings>
  <appSettings>
    <add key="log4net.Config" value="log4net.config" />
    <add key="log4net.Config.Watch" value="True" />
    <add key="UseUSPSV3API" value="false" />
  </appSettings>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" from="donotreply@corelogic.com">
        <network host="smtp.solutions.corelogic.com" defaultCredentials="true" />
      </smtp>
    </mailSettings>
  </system.net>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IUSPSIM" />
        <binding name="ShipServiceSoapBinding">
          <security mode="Transport" />
        </binding>
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://10.111.160.164/USPSIMBService/USPSIM.svc" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IUSPSIM" contract="USPSIMService.IUSPSIM" name="BasicHttpBinding_IUSPSIM" />
      <endpoint address="https://wsbeta.fedex.com:443/web-services/ship" binding="basicHttpBinding" bindingConfiguration="ShipServiceSoapBinding" contract="ShipWebServiceRef.ShipPortType" name="ShipServicePort" />
    </client>
  </system.serviceModel>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.ValueTuple" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
    </assemblyBinding>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>