                                                        <i class="glyphicon glyphicon-calendar fa fa-calendar"></i>
                                                        <span id="printedOn"></span><b class="caret"></b>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-3 control-lable" for="exampleInputPassword3">Shipped On</label>
                                                <div class="col-md-6">
                                                    <div id="reportrange1" class="pull-right" style="background: #fff; cursor: pointer; padding: 5px 10px; border: 1px solid #ccc">
                                                        <i class="glyphicon glyphicon-calendar fa fa-calendar"></i>
                                                        <span id="shippedOn"></span><b class="caret"></b>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                        <div style="float: right; margin-top: -6%" class="col-md-3">
                                            <button id="ClearData" style="margin-right: -5%; margin-left: 4%;" class="btn btn-warning btn-sm pull-right" type="reset"><i class="glyphicon glyphicon-clear"></i>Clear</button>
