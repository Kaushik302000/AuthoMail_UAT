                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-lable">Shipped On</label>
                                            <div id="reportrange1" class="form-control" style="background: #fff; cursor: pointer; padding: 5px 10px; border: 1px solid #ccc">
                                                <i class="glyphicon glyphicon-calendar fa fa-calendar"></i>
                                                <span id="shippedOn"></span><b class="caret"></b>
                                            </div>
                                        </div>
                                    </div>
