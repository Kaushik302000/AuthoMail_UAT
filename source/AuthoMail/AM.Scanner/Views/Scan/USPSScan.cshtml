    <!--<![endif]-->
    <div style="margin-top: 4%;">
        <h2 class="text-center alert alert-info">USPS Express Mail Tracking Number Scanning Page</h2>
    </div>
    <div class="col-md-6">
        <div class="form-inline">
            <div class="form-group">
                <label class="sr-only" for="exampleInputEmail3">Document Barcode</label>
                <input type="text" class="form-control" id="code1" placeholder="Document Barcode" tabindex="1">
            </div>
            <div class="form-group">
                <label class="sr-only" for="exampleInputPassword3">USPS Tracking Number</label>
                <input type="text" class="form-control" id="code2" placeholder="USPS Tracking Number" tabindex="2">
            </div>

            <button type="button" id="nextBatch" class="btn btn-info" tabindex="3" data-toggle="modal" data-target="#smallModal">Scan Next Batch</button>
            <button type="reset" id="clearData" class="btn btn-warning" tabindex="4">Clear</button>
            <div id="Messagedata" style="height: 35px; margin-top: 8px; margin-left: -1px;">
                <div id="message" class="form-group">
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">

        <div class="pull-left">
            <div class="form-inline pie_progress" role="progressbar" id="pie_todaycount" data-goal="-50" data-barcolor="#3daf2c" data-barsize="12" aria-valuemin="0" aria-valuemax="50">
                <div class="pie_progress__content" id="countsuccess" style="font-size: 50px;">0</div>
            </div>
        </div>
        @*<div class="pull-left">
                <div class="form-inline pie_progress" style="font-size: 13px; text-align: center;" role="progressbar" id="pie_totalscancount" data-goal="-100" data-barcolor="#3a87ad" data-barsize="10" aria-valuemin="0" aria-valuemax="100">
                    <div class="pie_progress__content" id="todayscount" style="font-size: 17px;color: #456C7F;">0/0</div>
                </div>
            </div>*@

    </div>

    <div class="clearfix">
    </div>
    <div class="col-md-6 pull-left" style="margin-top: 20px;">
        <fieldset class="rows scheduler-border" style="border: 1px solid #59ba4a; margin-bottom: 8px;" id="successRow">
            <legend class="scheduler-border" style="color: rgba(76,174,76,1);">Successful Scan Attempts </legend>
            <div id="SuccessscannedCode" class="form-inline" style="padding: 2px;">
            </div>
        </fieldset>
    </div>

    <div class="col-md-3 pull-right" style="margin-top: 20px;">
        <fieldset class="rows scheduler-border" style="border: 1px solid #eea236; margin-bottom: 8px;" id="rescanRow">
            <legend class="scheduler-border" style="color: rgba(238,162,54,1);">Duplicate Scan Attempts </legend>
            <div id="RescannedCode" class="form-inline" style="padding: 2px;">
            </div>
        </fieldset>
    </div>

    <div class="col-md-3 pull-right" style="margin-top: 20px;">
        <fieldset class="rows scheduler-border" style="border: 1px solid #ff0000; margin-bottom: 5px;" id="wrongRow">
            <legend class="scheduler-border" style="color: rgba(212,63,58,1);">Failed Scan Attempts</legend>
            <div id="WrongCode" class="form-inline" style="padding: 2px;">
            </div>

        </fieldset>
    </div>

    <!--ScanComplete Modal-->
    <div class="modal fade" id="smallModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog modalMarginTop">

            <div class="modal-content">
                <div class="modal-header">
                    <h3 id="modalTitle" class="alert alert-danger">Are you sure you want to start new batch?</h3>
                </div>
                <div class="modal-body" style="text-align: center;">
                    <button type="submit" id="submitModal" tabindex="10" class=" btn btn-success">Yes</button>
                    <button type="button" id="cancelModal" tabindex="11" class="btn btn-danger" data-dismiss="modal">No</button>
                </div>
            </div>
        </div>
    </div>
    <!--End ScanComplete Modal-->
    <!--QC and Pulledback Modal-->
    <div class="modal fade" id="generalmodal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog modalMarginTop">

            <div class="modal-content">
                <div class="modal-header">
                    <h3 id="genmodalTitle"></h3>
                </div>
                <div class="modal-body" style="text-align: center;">
                    <button type="button" tabindex="11" class="btn btn-danger" data-dismiss="modal">Ok</button>
                </div>
            </div>
        </div>
    </div>
    <!--End ScanComplete Modal-->
    <!--No more Scan Modal-->
    <div class="modal fade" id="noMoreDocument" tabindex="-2" role="dialog">
        <div class="modal-dialog modal-dialog modalMarginTop">

            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="alert alert-info" id="modalInfo">There are no more document(s) for scan.</h3>
                </div>
                <div class="modal-body" style="text-align: center;">
                    <button type="button" id="okModal" tabindex="10" data-dismiss="modal" class=" btn btn-success">OK</button>
                </div>
            </div>
        </div>
    </div>

    <button type="button" id="noBatch" class="btn btn-primary" tabindex="3" data-toggle="modal" style="display: none;" data-target="#noMoreDocument">noBatch</button>
    <!--End No more Scan Modal-->
    <input type="hidden" id="Environment" value="@AM.Scanner.Common.Common.Environment" />
    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
        <script src="~/Scripts/rainbow.min.js"></script>
        <script src="~/Scripts/jquery-asPieProgress.js"></script>
        <script src="~/Scripts/jquery.ui.core.js"></script>
        <script src="~/Scripts/jquery.ui.widget.js"></script>
        <script src="~/Scripts/jquery.ui.mouse.js"></script>
        <script src="~/Scripts/jquery.ui.draggable.js"></script>
        <script src="~/Scripts/tooltip.js"></script>
        <script type="text/javascript">
            /*---- Global Messages ----*/

            $("#okModal").click(function () {
                $("#code1").blur();
            });


            //debugger;
            var clientCode = "";// "AMC";// "HTL"; //
            var successmsg = "Document scanned.";
            var notStartWithClientCode = "";
            var emptymsg = "Please scan a document.";
            var duplicatemsg = "Document already scanned.";
            // var notInDatabase = "";
            var mismatch = "Barcode value does not match with ";
            var databaseError = "Communication error. Please try to scan after some time.";
            var ActiveBatchCount = 1;
            var nomoreBatch = "There are no more document(s) for scan.";
            var modalsuccess = "Your batch is completed, start a new batch.";
            //var modalsuccess = "All documents has been scanned.";
            var modalInfo = "Please start a new batch.";
            var validScanMsg = "Please scan valid a doument.";
            var codespace = "123456789012";// "HTL00000000000";//
            var environment = $("#Environment").val();

            /*---- Scanned Batch Count using Ajax  ----*/
            /*---- Parameter:{ operationcode , clientCode }  ----*/
            jQuery(document).ready(function ($) {

                var isIE11 = !!navigator.userAgent.match(/Trident.*rv\:11\./);
                // debugger;

                if (isIE11) {
                    $("#countsuccess").addClass("counterIe10");
                    //$("#todayscount").addClass("counterTotalIe10");
                }
                else {
                    $("#countsuccess").removeClass("counterIe10");
                    //$("#todayscount").removeClass("counterTotalIe10");
                }
                $('.modal-dialog').draggable({ handle: ".modal-header" });
                $('.modal-dialog').find(".modal-header").css('cursor', 'move');

                clientCode = getParameterByName('clientCode');
                notStartWithClientCode = "Barcode must be start with " + clientCode + ". Please scan again.";

                var cnt = 0;

                $('#pie_todaycount').asPieProgress({
                    namespace: 'pie_progress',
                    min: 0

                });
                $('#pie_totalscancount').asPieProgress({
                    namespace: 'pie_progress',
                    min: 0,

                });

                $("#code1").val("");
                $("#code1").focus();
            });
            /*---- End of Scanned Batch Count Ajax ----*/






            /*---- Validate for New Batch  ----*/
            function startNewBatch() {
                //var batchtotalCount = $("#todayscount").text();
                //var totalScanValues = $("#todayscount").text().split('/');
                //var totalfiles = totalScanValues[1];
                //var totalscannedValue = totalScanValues[0];

                var batchCountTotal = $("#countsuccess").text();
                // alert(totalfiles + " / " + totalscannedValue + "batch count"+batchCountTotal);
                $("#message").empty();
                if (batchCountTotal > 0) {

                    $("#modalTitle").removeClass("alert alert-danger");
                    $("#submitModal").text("OK");
                    $("#cancelModal").text("CANCEL");
                    $("#modalTitle").text(modalInfo);
                    $("#modalTitle").addClass("alert alert-info");
                    $("#nextBatch").click();

                }
            }
            /*---- End Validate for New Batch  ----*/

            /*---- Code1 validate Barcode  ----*/
            $("#code1").blur(function () {
                //startNewBatch(); // calling startNewBatch() Method
                if (parseInt($("#countsuccess").text().trim()) == 50) {
                    $("#modalTitle").removeClass("alert alert-danger");
                    $("#modalTitle").text(modalsuccess);
                    $("#modalTitle").addClass("alert alert-success");
                    $("#nextBatch").click();
                    return;
                }

                var code1Value = $("#code1").val().trim().toUpperCase();

                if (code1Value != "") {

                    var code1ValueReverse = code1Value.split("").reverse().join("");
                    if (code1ValueReverse.indexOf(clientCode) != -1) {
                        code1Value = code1ValueReverse.replace(clientCode, '');
                        //console.log(code1Value);
                    }

                    if (isNaN(code1Value)) {
                        $("#message").empty();
                        $("#message").show();
                        $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'><strong>Oops! </strong>" + validScanMsg + "</div>");
                        $("#code1").val("");
                        $("#code1").focus();
                    } else {
                        $("#code2").focus();
                    }
                } else {
                    $("#message").empty();
                    $("#message").show();
                    $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'><strong>Oops! </strong>" + emptymsg + "</div>");
                    $("#code1").val("");
                    $("#code1").focus();

                }

            });
            /*---- End Code1 validate Barcode  ----*/

            /*---- Code2 validate Barcode  ----*/
            $("#code2").blur(function () {
                if ($("#clearData").data("mouseDown") != true) {
                   // startNewBatch();// calling startNewBatch() Method
                    //    var batchtotalCount = $("#todayscount").text();
                    $("#message").empty();
                    //if (batchtotalCount.split('/')[0] == batchtotalCount.split('/')[1]) {
                    //if (batchtotalCount == "0/0") {

                    //    $("#message").empty();
                    //    $("#message").show();
                    //    $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'><strong>Oops! </strong>" + nomoreBatch + "</div>");
                    //    $("#code1").val("");
                    //    $("#code1").focus();

                    //}
                    //else {

                    var code1Value = $("#code1").val().trim().toUpperCase();
                    var code1ValueReverse = code1Value.split("").reverse().join("");
                    if (code1ValueReverse.indexOf(clientCode) != -1) {
                        code1Value = code1ValueReverse.replace(clientCode, '');

                    }
                    var code2Value = $("#code2").val().trim().toUpperCase();
                    if (code2Value != "") {
                        //var totalScanValues = $("#todayscount").text().split('/');
                        //var totalScanned = totalScanValues[0];
                        //var totalfiles = totalScanValues[1];
                        var scanCount = parseInt($("#countsuccess").text());
                        $.ajax({
                            type: "POST",
                            url:  '@Url.Content("~/Scan/RegisterUSPSScan")',
                            data: { mailPieceId: parseInt(code1Value), trackingNo: code2Value, clientCode: clientCode },
                            success: function (response) {
                                var object = response;
                                var code = object.model.Code;
                                var trackingNo = object.model.TrackingNo;
                                var message = object.model.Message;
                                var mailPieceId = object.model.MailPieceId;
                                if (code == "Valid") {
                                    //totalfiles = object.model.TotalCount;
                                    //$("#todayscount").text(object.model.ScanCount + "/" + totalfiles);
                                    if (message == null || message == "") {
                                        message = successmsg;
                                    }
                                    //UpdateProgressCount(object.model.ScanCount, totalfiles);
                                    //check//$('#pie_totalscancount').asPieProgress('go', String(piePreInt + "%"));
                                    //console.log(object.model);
                                    $("#message").empty();
                                    $("#message").show();
                                    $("#message").append("<div class='alert alert-success' style=' font-family:Copperplate Gothic;'><strong>" + message + "</strong></div>");
                                    $('#message').delay(2000).fadeOut('slow');
                                    //if (code == "QC") {

                                    //    $("#SuccessscannedCode").prepend("<label data-toggle='tooltip' data-container='body' data-placement='top' data-html='true' title='Batch Name: " + object.model.BatchName + "<br>  Code: " + code + "'  class='lblAMC lbl-warning' for='success'>" + trackingNo + "</lable>");
                                    //    $("#genmodalTitle").removeClass("alert alert-danger");
                                    //    $("#genmodalTitle").text("QC is requested for this mailpiece, please perform quality check before mailing.");
                                    //    $("#genmodalTitle").addClass("alert alert-info");
                                    //    $("#generalmodal").modal("show");
                                    //}
                                    //if (code == "Pulledback") {
                                    //    $("#SuccessscannedCode").prepend("<label data-toggle='tooltip' data-container='body' data-placement='top' data-html='true' title='Batch Name: " + object.model.BatchName + "<br>  Code: " + code + "'  class='lblAMC lbl-danger' for='success'>" + trackingNo + "</lable>");
                                    //    $("#genmodalTitle").removeClass("alert alert-info");
                                    //    $("#genmodalTitle").text("Pullback is requested for this mailpiece, please DO NOT mail.");
                                    //    $("#genmodalTitle").addClass("alert alert-danger");
                                    //    $("#generalmodal").modal("show");
                                    //}
                                    if (code == "Valid") {
                                        $("#SuccessscannedCode").prepend("<label data-toggle='tooltip' data-container='body' data-placement='top' data-html='true' title='MailPiece Id: " + mailPieceId + "<br>  Code: " + code + "'  class='lblAMC lbl-success' for='success'>" + trackingNo + "</lable>");

                                    }
                                    $('[data-toggle="tooltip"]').tooltip();
                                    var successcnt = $("#countsuccess").text();
                                    successcnt++;
                                    $('label[for="default' + successcnt + '"]').closest('label').remove();
                                    //$('#pie_todaycount').asPieProgress('stop');
                                    $('#pie_todaycount').asPieProgress('go', parseInt(successcnt));
                                    $("#countsuccess").text(successcnt);
                                    if (successcnt > 51) {
                                        $("#modalTitle").removeClass("alert alert-danger");
                                        $("#modalTitle").text(modalsuccess);
                                        $("#modalTitle").addClass("alert alert-success");
                                        $("#nextBatch").click();
                                    }
                                    $("#code1").val("");
                                    $("#code2").val("");
                                    $("#code1").focus();

                                }
                                else if (code == "Rescan") {
                                    $("#message").empty();
                                    $("#message").show();
                                    if (message == null || message == "") {
                                        message = duplicatemsg;
                                    }
                                    $("#message").append("<div class='alert alert-warning' style=' font-family:Copperplate Gothic;'><strong>Oops! </strong>" + message + "</div>");
                                    $("#RescannedCode").prepend("<div style='margin:2px;' class='form-group'><button class='lblAMC lbl-warning' disabled >" + trackingNo + "</button></div>");
                                    $("#code1").val("");
                                    $("#code2").val("");
                                    $("#code1").focus();
                                }
                                else if (code == "Invalid") {
                                    if (message == null || message == "") {
                                        message = "Document with barcode " + code2Value + " could not be found.";
                                    }
                                    $("#message").empty();
                                    $("#message").show();
                                    $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'><strong>Oops!" + message + " </strong></div>");
                                    $("#code1").val("");
                                    $("#code2").val("");
                                    $("#code1").focus();
                                    $("#WrongCode").prepend("<div style='margin:2px;' class='form-group'><label class='lblAMC lbl-danger' disabled>" + code2Value + "</label></div>");
                                }
                                else if (code == "RESNotFound") {
                                    $("#message").empty();
                                    $("#message").show();
                                    $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'><strong>Oops! </strong>Please scan front and rear barcode first.Please <a href='" + baseUrl +"Scan/Index?clientCode=" + clientCode + "' target='_blank'>click here</a> to scan </div>");
                                    $("#code1").val("");
                                    $("#code2").val("");
                                    //$("#code1").focus();
                                    $("#WrongCode").prepend("<div style='margin:2px;' class='form-group'><label class='lblAMC lbl-danger' disabled>" + code2Value + "</label></div>");
                                }
                                else {
                                    $("#message").empty();
                                    $("#message").show();
                                    $("#wrongRow").show();
                                    $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'><strong>Oops! </strong> Not found.</div>");
                                    $("#code2").val("");
                                    $("#code2").focus();
                                    $("#WrongCode").prepend("<div style='margin:2px;' class='form-group'><label class='lblAMC lbl-danger' disabled>" + code2Value + "</label></div>");
                                }

                            },
                            error: function (response) {
                                $("#message").empty();
                                $("#message").show();
                                $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'><strong>Oops! </strong>" + databaseError + "</div>");
                                $("#code1").val("");
                                $("#code2").val("");
                                $("#code1").focus();

                            }
                        });


                    }
                    else {
                        $("#message").empty();
                        $("#message").show();
                        $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'><strong>Oops! </strong>" + emptymsg + "</div>");
                        $("#code2").val("");

                    }
                    //}
                }
            });
            /*---- End Code2 validate Barcode  ----*/

            /*---- Start next batch and clear cookies on client side ----*/
            $("#submitModal").click(function () {
                startNewBatch();
            });
            /*----End Clear Cookies on Client side of Barcode scan ----*/

            $("#clearData").on("mousedown", function (e) {
                $("#clearData").data("mouseDown", true);
            });

            $("#clearData").on("mouseup", function (e) {
                $("#clearData").data("mouseDown", false);
            });
            $("#clearData").click(function () {
                $("#code1").val("");
                $("#code2").val("");
                $("#code1").focus();
            });
        </script>
    }
</div>
