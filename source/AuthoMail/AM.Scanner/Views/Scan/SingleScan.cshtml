                                        totalScanned = parseInt(totalScanned) + 1;
                                        $("#todayscount").text(totalScanned + "/" + totalfiles);
                                        if (message == null || message == "") {
                                            message = successmsg;
                                        }
                                        UpdateProgressCount(totalScanned, totalfiles);
                                        //check//$('#pie_totalscancount').asPieProgress('go', String(piePreInt + "%"));
                                        //console.log(object.model);
                                        $("#message").empty();
                                        $("#message").show();
                                        $("#message").append("<div class='alert alert-success' style=' font-family:Copperplate Gothic;'>" + message + "</div>");
                                        $('#message').delay(2000).fadeOut('slow');
                                        if (code == "QC") {

                                            $("#SuccessscannedCode").prepend("<label data-toggle='tooltip' data-container='body' data-placement='top' data-html='true' title='Batch Name: " + object.model.JobName + "<br>  Code: " + code + "'  class='lblAMC lbl-warning' for='success'>" + trackingNo + "</lable>");
                                            $("#genmodalTitle").removeClass("alert alert-danger");
                                            $("#genmodalTitle").text("QC is requested for this mailpiece, please perform quality check before mailing.");
