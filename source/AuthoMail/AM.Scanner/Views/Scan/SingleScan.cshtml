    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
        <script src="~/Scripts/rainbow.min.js"></script>
        <script src="~/Scripts/jquery-asPieProgress.js"></script>
        <script src="~/Scripts/jquery.ui.core.js"></script>
        <script src="~/Scripts/jquery.ui.widget.js"></script>
        <script src="~/Scripts/jquery.ui.mouse.js"></script>
        <script src="~/Scripts/jquery.ui.draggable.js"></script>
        <script src="~/Scripts/tooltip.js"></script>
        <script type="text/javascript">
            /*---- Global Messages ----*/

            $("#okModal").click(function () {
                $("#code1").blur();
            });
            $(".okclick").click(function () {
                $("#code1").val("");
                //$("#code2").val("");
                $("#code1").focus();
            });
            $(document).keypress(function (e) {
                if (e.which == 13) {
                    if ($("#generalmodal").hasClass('in')) {
                        $(".okclick").click();

                    }
                }
            });

            function GetScanCountByBatchName(clientCode, batchName) {
                $.ajax({
                    type: "GET",
                    url: '@Url.Content("~/Scan/GetScanCountByBatchName")',
                    data: { clientCode: clientCode, batchName: batchName },
                    success: function (response) {
                        if (typeof response.ScanCount === "undefined" || typeof response.TotalCount === "undefined") {
                            $("#todayscount").text("--/--");
                            window.location.reload();
                            return;
                        }

                        if (response != null) {
                            $("#todayscount").text(response.ScanCount + "/" + response.TotalCount);
                            UpdateProgressCount(response.ScanCount, response.TotalCount);
                        }
                        //else {
                        //    $("#todayscount").text(response.ScanCount + "/" + response.TotalCount);
                        //    var totalBatch = $("#todayscount").text().split('/');
                        //   // ActiveBatchCount = totalBatch[0];;
                        //    $("#todayscount").text(totalBatch[0] + "/" + totalBatch[1]);
                        //}
                    },
                    error: function (xhr, response) {
                        $("#message").empty();
                        $("#message").show();
                        $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'><strong>Error Code " + xhr.status + ":</strong> " + databaseError + "</div>");
                        $("#code1").val("");
                        //$("#code2").val("");
                        $("#code1").focus();
                    }
                });
            }
            /*---- asPieProgress  ----*/
            function UpdateProgressCount(ScanCount, TotalCount) {
                var piePreInt = parseFloat((parseInt(ScanCount) / parseInt(TotalCount)) * 100);
                $('#pie_totalscancount').asPieProgress('go', piePreInt);// String(count + "%"));
            }
            /*---- asPieProgress End ----*/

            function GetScannedDocuments(clientCode, batchName) {
                $.ajax({
                    type: "GET",
                    url: '@Url.Content("~/Scan/GetScannedDocuments")',
                    data: { clientCode: clientCode, batchName: batchName },
                    success: function (response) {
                        var totalMailPieces = response.model;
                        if (totalMailPieces.length > 0) {
                            for (var i = 0; i < totalMailPieces.length; i++) {
                                if (totalMailPieces[i].Code == "Valid") {//Valid
                                    $("#SuccessscannedCode").prepend("<label data-toggle='tooltip' data-container='body' data-placement='top' data-html='true' title='Batch Name: " + totalMailPieces[i].JobName + "<br>  Code: Valid' class='lblAMC lbl-success' for='success" + i + "' > " + totalMailPieces[i].TrackingNo + " </label>");
                                }
                                if (totalMailPieces[i].Code == "QC") {//QC
                                    $("#SuccessscannedCode").prepend("<label data-toggle='tooltip' data-container='body' data-placement='top' data-html='true' title='Batch Name: " + totalMailPieces[i].JobName + "<br>  Code: QC'  class='lblAMC lbl-warning' for='warning" + i + "' > " + totalMailPieces[i].TrackingNo + " </label>");

                                }
                                if (totalMailPieces[i].Code == "Pulledback") {//Pulledback
                                    $("#SuccessscannedCode").prepend("<label data-toggle='tooltip' data-container='body' data-placement='top' data-html='true' title='Batch Name: " + totalMailPieces[i].JobName + "<br>  Code: Pulledback'  class='lblAMC lbl-danger' for='danger" + i + "' > " + totalMailPieces[i].TrackingNo + " </label>");
                                }
                            }
                        }

                        GetScanCountByBatchName(clientCode, batchName);
                        $('[data-toggle="tooltip"]').tooltip();
                    },
                    error: function (xhr, response) {
                        $("#message").empty();
                        $("#message").show();
                        $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'><strong>Error Code " + xhr.status + ":</strong> " + databaseError + "</div>");
                        $("#code1").val("");
                        //$("#code2").val("");
                        $("#code1").focus();
                    }
                });

            }

            //debugger;
            var clientCode = "";// "AMC";// "HTL"; //
            var successmsg = "Document scanned.";
            var notStartWithClientCode = "";
            var emptymsg = "Please scan a document.";
            var duplicatemsg = "Document already scanned.";
            // var notInDatabase = "";
            var mismatch = "Barcode value does not match with ";
            var databaseError = "Communication error. Please try to scan after some time.";
            var ActiveBatchCount = 1;
            var nomoreBatch = "There are no more document(s) for scan.";
            var modalsuccess = "Your batch is completed, start a new batch.";
            //var modalsuccess = "All documents has been scanned.";
            var modalInfo = "Please start a new batch.";
            var codespace = "123456789012";// "HTL00000000000";//
            var environment = $("#Environment").val();
            var batchName = "";
            /*---- Scanned Batch Count using Ajax  ----*/
            /*---- Parameter:{ operationcode , clientCode }  ----*/
            jQuery(document).ready(function ($) {

                //var isIE11 = !!navigator.userAgent.match(/Trident.*rv\:11\./);
                //// debugger;

                //if (isIE11) {
                //    $("#countsuccess").addClass("counterIe10");
                //    $("#todayscount").addClass("counterTotalIe10");
                //}
                //else {
                //    $("#countsuccess").removeClass("counterIe10");
                //    $("#todayscount").removeClass("counterTotalIe10");
                //}
                $('.modal-dialog').draggable({ handle: ".modal-header" });
                $('.modal-dialog').find(".modal-header").css('cursor', 'move');

                clientCode = getParameterByName('clientCode');
                batchName = getParameterByName('batchName');
                $("#batchNameDisplay").text(batchName);
                $("#cliencodeDisplay").text(clientCode.replace("AUT", ""));
                notStartWithClientCode = "Barcode must be start with " + clientCode + ". Please scan again.";

                var cnt = 0;

                //$('#pie_todaycount').asPieProgress({
                //    namespace: 'pie_progress',
                //    min: 0

                //});
                $('#pie_totalscancount').asPieProgress({
                    namespace: 'pie_progress',
                    min: 0,

                });
                GetScanCountByBatchName(clientCode, batchName);
                GetScannedDocuments(clientCode, batchName);
                /*  Updating Batch Count on every 12 Second using Ajax */
                window.setInterval(function () {
                    GetScanCountByBatchName(clientCode, batchName);
                }, 60000);
                /*  Updating Batch Count on every 12 Second using Ajax */
                $("#code1").val("");
                $("#code1").focus();
            });
            /*---- End of Scanned Batch Count Ajax ----*/






            /*---- Validate for New Batch  ----*/
            //need to remove
            function startNewBatch() {
                var batchtotalCount = $("#todayscount").text();
                var totalScanValues = $("#todayscount").text().split('/');
                var totalfiles = totalScanValues[1];
                var totalscannedValue = totalScanValues[0];

                //var batchCountTotal = $("#countsuccess").text();
                // alert(totalfiles + " / " + totalscannedValue + "batch count"+batchCountTotal);
                $("#message").empty();
