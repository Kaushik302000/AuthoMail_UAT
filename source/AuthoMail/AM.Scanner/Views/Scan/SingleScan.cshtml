                                            //$("#generalmodalOk").focus();
                                            $("#code1").val("");
                                            //$("#code2").val("");
                                        }
                                        if (code == "Pulledback") {
                                            $("#SuccessscannedCode").prepend("<label data-toggle='tooltip' data-container='body' data-placement='top' data-html='true' title='Batch Name: " + object.model.JobName + "<br>  Code: " + code + "'  class='lblAMC lbl-danger' for='success'>" + trackingNo + "</lable>");
