                                            $("#submitModal").text("OK");
                                            $("#cancelModal").hide();
                                            $("#code1").val("");
                                            //$("#code2").val("");
                                            $("#smallModal").modal("show");
                                            //$("#okModal").focus();
                                            return;
                                        }



                                    }
                                    else if (code == "Rescan") {
                                        $("#message").empty();
                                        $("#message").show();
                                        if (message == null || message == "") {
                                            message = duplicatemsg;
                                        }
                                        $("#message").append("<div class='alert alert-warning' style=' font-family:Copperplate Gothic;'>" + message + "</div>");
                                        $("#RescannedCode").prepend("<div style='margin:2px;' class='form-group'><button class='lblAMC lbl-warning' disabled >" + trackingNo + "</button></div>");
                                        $("#code1").val("");
                                        //$("#code2").val("");
                                        $("#code1").focus();
                                    }
                                    else if (code == "Invalid") {
                                        $("#message").empty();
                                        $("#message").show();
                                        if (message == null || message == "") {
                                            $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'>Document with barcode " + code1Value + " could not be found.</div>");
                                        }
                                        else {
                                            $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'><b>" + message + "</b></div>");
                                        }
                                        $("#code1").val("");
                                        //$("#code2").val("");
                                        $("#code1").focus();
                                        $("#WrongCode").prepend("<div style='margin:2px;' class='form-group'><label class='lblAMC lbl-danger' disabled>" + code1Value + "</label></div>");
                                    }
                                    else {
                                        $("#message").empty();
                                        $("#message").show();
                                        $("#wrongRow").show();
                                        $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'>" + code1Value + " " + mismatch + "" + code1Value + "</div>");
                                        //$("#code2").val("");
                                        //$("#code2").focus();
                                        $("#WrongCode").prepend("<div style='margin:2px;' class='form-group'><label class='lblAMC lbl-danger' disabled>" + code1Value + "</label></div>");
                                    }
                                    //GetScanCountByBatchName(clientCode, batchName);

                                },
                                error: function (xhr, response) {
                                    $("#message").empty();
                                    $("#message").show();
                                    $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'><strong>Error Code " + xhr.status + ":</strong>" + databaseError + "</div>");
                                    $("#code1").val("");
                                    //$("#code2").val("");
                                    $("#code1").focus();

                                }
                            });

                        //}
                        //else {
