                    $("#modalTitle").addClass("alert alert-info");
                    $("#smallModal").modal("show");
                    //$("#okModal").focus();

                }
            }
            /*---- End Validate for New Batch  ----*/

            /*---- Code1 validate Barcode  ----*/
            $("#code1").blur(function () {
                //startNewBatch(); // calling startNewBatch() Method
                var batchtotalCount = $("#todayscount").text();
                var totalScanValues = $("#todayscount").text().split('/');
                var totalfiles = totalScanValues[1];
                var totalscannedValue = totalScanValues[0];
                //if (parseInt($("#countsuccess").text().trim()) == 50) {
                //    $("#modalTitle").removeClass("alert alert-danger");
                //    $("#modalTitle").text(modalsuccess);
                //    $("#modalTitle").addClass("alert alert-success");
                //    $("#nextBatch").click();
                //    //$("#okModal").focus();
                //    return;
                //}
                if (batchtotalCount == "0/0") {
                    $('#pie_totalscancount').asPieProgress('reset');
                    $("#noBatch").click();
                    $("#code1").val("");
                    $("#code1").focus();

                }
                else {
                    var code1Value = $("#code1").val();
                    if (code1Value != "") {
                        //$("#code2").focus();
                    } else {
                        $("#message").empty();
                        $("#message").show();
                        $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'>" + emptymsg + "</div>");
                        $("#code1").val("");
                        $("#code1").focus();

                    }
                }

            });
            /*---- End Code1 validate Barcode  ----*/

            /*---- Code2 validate Barcode  ----*/
            $("#code1").blur(function () {
                if ($("#code1").val().trim() == "") {
                    $("#message").empty();
                    $("#message").show();
                    $("#message").append("<div class='alert alert-danger' style=' font-family:Copperplate Gothic;'>Please scan the front barcode first.</div>");
