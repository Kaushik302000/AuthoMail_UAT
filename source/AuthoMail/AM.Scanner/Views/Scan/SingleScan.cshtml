<div>
    <link href="~/Content/progress.css" rel="stylesheet" />

    <style>
        .pie_progress {
            width: 160px;
            /*margin: 10px auto;*/
        }

        .modalMarginTop {
            margin-top: 10%;
        }

        .modal-dialog {
            left: 0%;
        }

        .lblAMC {
            display: inline-block;
            padding: 6px 12px;
            margin-bottom: 0;
            font-size: 14px;
            font-weight: normal;
            line-height: 1.428571429;
            text-align: center;
            white-space: nowrap;
            vertical-align: middle;
            border: 1px solid transparent;
            border-radius: 4px;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            -o-user-select: none;
            user-select: none;
        }

        .lbl-success {
            color: rgba(255,255,255,1);
            background-color: rgba(92,184,92,1);
            border-color: rgba(76,174,76,1);
            margin: 1px;
        }

        .lbl-warning {
            color: rgba(255,255,255,1);
            background-color: rgba(240,173,78,1);
            border-color: rgba(238,162,54,1);
            margin: 1px;
        }

        .lbl-danger {
            color: rgba(255,255,255,1);
            background-color: rgba(217,83,79,1);
            border-color: rgba(212,63,58,1);
            margin: 1px;
        }

        .lbl-default {
            color: #333;
            background-color: #fff;
            border-color: #ccc;
            margin: 1px;
            color: white;
        }

        fieldset.scheduler-border {
            padding: 0 1.4em 1.4em 1.4em !important;
            margin: 0 0 1.5em 0 !important;
            -webkit-box-shadow: 0px 0px 0px 0px #000;
            box-shadow: 0px 0px 0px 0px #000;
        }

        legend.scheduler-border {
            font-size: 1.2em !important;
            font-weight: bold !important;
            text-align: left !important;
            width: auto;
            padding: 0 10px;
            border-bottom: none;
        }

        .pie_progress svg {
            width: 90px;
        }

        @@media all and (max-width: 768px) {
            .pie_progress svg {
                width: 90px;
                max-width: 300px;
            }
        }

        @@media (width: 340px) {
            body {
                width: 330px;
            }
        }

