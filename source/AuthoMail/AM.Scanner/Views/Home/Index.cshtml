<style>

    tr.hide-table-padding td {
        padding: 0;
    }

    .expand-button {
        position: relative;
    }

    .accordion-toggle .expand-button:after {
        position: absolute;
        left: .75rem;
        top: 50%;
        transform: translate(0, -50%);
        -webkit-transition: all 0.5s ease-in-out;
    }


    .accordion-toggle:hover {
        cursor: pointer;
    }


    .clientCode {
        font-size: 12px;
    }



    a:hover {
        color: none;
    }

    .preclass {
        padding: 4.5px;
        display: inline-block;
        margin: 0px;
        font-size: 18px;
        line-height: 1.428571429;
        color: #333333;
        word-break: break-all;
        word-wrap: break-word;
        background-color: #fffdfd;
        border: 1px solid #cccccc;
        border-radius: 4px;
        min-width: 15%;
        /*max-height: 43%;*/
        width: 81px;
    }

        .preclass:hover {
            background-color: #fff;
            border: 1px solid #ff6a00;
        }

    .preclassok {
        background-color: #72af46 !important;
        border: 1px solid #fff !important;
        color: #fff !important;
    }

    .report {
        border: 1px solid #72af46;
        color: #72af46;
    }

        .report:hover {
            color: #FFF;
            background: #72af46;
        }

    .reportLink {
        padding: 5px;
    }

    .bg-primary {
        border: 1px solid #cb4040 !important;
        /*color: #cb4040 !important;
        background-color: #fff !important;*/
        color: #fff !important;
        background-color: #cb4040 !important;
    }

    .bg-info {
        border: 1px solid #466baf !important;
        color: #fff !important;
        background-color: #466baf !important;
    }

    .bg-success {
        border: 1px solid #72af46 !important;
        color: #fff !important;
        background-color: #72af46 !important;
    }

    .bg-inverse {
        border: 1px solid #424242 !important;
        color: #fff !important;
        background-color: #424242 !important;
    }

    .bg-warning {
        border: 1px solid #2BBBAD !important;
        color: #fff !important;
        background-color: #2BBBAD !important;
    }
    /*rgba(255,136,0,1)*/
    .topbordernone {
        border-top: none !important;
    }

    .btn-warning {
        background: #2BBBAD !important;
        border-color: #2BBBAD !important;
        color: #fff !important;
    }

        .btn-warning:hover {
            background: none !important;
            color: #2BBBAD !important;
        }

    .aligncenter {
        text-align: center;
        vertical-align: middle !important;
    }

    .count0 {
        font-size: 18px;
        font-family: Monaco, Menlo, Consolas, "Courier New", monospace;
        vertical-align: middle !important;
    }

    .dataTables_scrollBody::-webkit-scrollbar {
        width: 6px;
    }

    .dataTables_scrollBody::-webkit-scrollbar-thumb {
        background: #666;
        border-radius: 20px;
    }

    .dataTables_scrollBody::-webkit-scrollbar-track {
        background: #ddd;
        border-radius: 20px;
    }

    table.dataTable.table-condensed > thead > tr > th {
        padding-right: 0px;
    }

    .redbg {
        background-color: #f8d7da !important;
        color: #bd362f !important;
    }

    .noprocess {
        /*background: #B4C6E7 !important;
        color: #203764 !important;*/
        background: #DBDBDB !important;
        color: #000 !important;
    }

    .completed {
        background: #C6EFCE !important;
        color: #006100 !important;
    }

    .incomplete {
        background: #FFEB9C !important;
        color: #9C5700 !important;
    }

    .label-warning {
        background-color: #f0ad4e !important;
    }
</style>

<section class="">
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">
                <div class="table-responsive" id="batchtable">

                </div>
            </div>
        </div>
    </div>
