<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="log4net" type="System.Configuration.IgnoreSectionHandler" />
  </configSections>

  <log4net>
    <root>
      <level value="ALL" />
      <appender-ref ref="Scanner" />
    </root>

    <!--Define some output appenders-->
    <appender name="Scanner" type="log4net.Appender.RollingFileAppender">
      <file value="\\Cmsuw1gefiler01\pns\AuthoMail\APPLICATIONS_FILES\Scanner\" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <!--<datePattern type="log4net.Util.PatternString" value="'logs'\\'DownloadJob-'yyyyMMdd'-%processid.log'" />-->
      <datePattern type="log4net.Util.PatternString" value="'logs'\\'log-'yyyyMMdd'.log'" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <header value="[APP START]%newline" type="log4net.Util.PatternString" />
        <footer value="[APP END]%newline" type="log4net.Util.PatternString" />
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
    </appender>
  </log4net>
</configuration>