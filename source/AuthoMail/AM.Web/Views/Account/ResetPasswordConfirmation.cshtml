@{
    ViewBag.Title = "Reset password confirmation";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div style="margin-top:2%">

</div>
<div class="title col-md-12" style="margin-bottom:2%;">
    <h1>@ViewBag.Title.</h1>

    <div class="alert alert-green">
        <div class="row">
            <i class="fa fa-check fa-2x"></i>
            Your password has been reset. Please <u>@Html.ActionLink("click here", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink", @class = "link", @style = "color:#fff;margin-left:0px;" })</u> to log in
        </div>
    </div>
</div>