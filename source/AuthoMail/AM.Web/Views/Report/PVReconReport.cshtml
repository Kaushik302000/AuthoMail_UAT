@{
    ViewBag.Title = "Print Vendor Recon Report";
}

<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<script src="~/clui/dist/js/vendor/moment.js"></script>
<style>
    .col-md-1, .col-md-2, .col-md-3 {
        padding-left: 10px !important;
        padding-right: 10px !important;
    }

    .show-calendar {
        width: 484px !important;
    }

    #dateFilter .bootstrap-select, #DocTypeSize .bootstrap-select {
        width: 100% !important;
    }

    .bootstrap-select {
        width: 205px !important;
    }
</style>
<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" id="headingOne">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#metaItem1">
                <div class="panel-title">
                    Print Vendor Recon Report
                    <div class="collapsed-icon pull-right">
                        <i class="fa fa-caret-left"></i>
                    </div>
                    <div class="expanded-icon pull-right">
                        <i class="fa fa-caret-down"></i>
                    </div>
                </div>
            </a>
        </div>
        <div id="metaItem1" class="panel-collapse collapse in">
            <div class="panel-body">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="date"><span id="ByDate">Print Vendor Submitted Date</span> (EST)</label>
                        <div class="input-group daterange" id="datepicker4">
                            <input type="text" class="form-control" id="date">
                            <span class="input-group-addon">
                                <i class="fa fa-calendar"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="PrintVendors">Print Vendors</label>
                        @Html.Action("_PrintVendorList", "Common")
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="Status">Shipping Status</label>
                        <select class="selectpicker" id="Status" data-live-search="true" data-live-search-placeholder="Search Status">
                            <option value="">Select Status</option>
                            <option value="InProgress">In Progress</option>
                            <option value="PulledBack">Pulledback</option>
                            <option value="Shipped">Shipped</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="ShippingMethod">Shipping Method</label>
                        <select class="selectpicker" id="ShippingMethod" multiple="multiple">
                            <option value="USPS-IMB">USPS-IMB</option>
                            <option value="USPS-PRIORITY">USPS-PRIORITY</option>
                            <option value="USPS-PRIORITY_EXPRESS">USPS-PRIORITY EXPRESS</option>
                            <option value="FedEx-PRIORITY_OVERNIGHT">FedEx-PRIORITY OVERNIGHT</option>
                        </select>
                    </div>
                </div>
                @if (User.IsInRole(AM.Entities.AMRoles.Admin))
                {
                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="ClientId">Clients</label>
                            @Html.DropDownList("ClientId", ViewBag.ClientId as IEnumerable<SelectListItem>, htmlAttributes: new { @class = "selectpicker", @multiple = "multiple", @data_live_search = "true", @data_live_search_placeholder = "Search Client" })
                        </div>
                    </div>
                }
                else
                {
                    <input type="hidden" name="ClientId" id="ClientId" value="@ViewBag.ClientId" />
                }
                <div class="clearfix"></div>
                <div class="col-md-1">
                    <div class="form-group ">
                        <label for="input1"></label>
                        <button type="button" id="filterData" class="btn btn-primary" style=" padding-top: 6%;">
                            <span class="sr-only">Filter</span>
                            <i class="fa fa-download"></i> Download Report
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end table template code -->
@section Scripts{
    @Scripts.Render("~/bundles/datatables")
<script>
        $(document).ready(function () {
            window.clui.dateTimePickerInit();
            window.clui.tooltipInit();
        });

        $("#filterData").click(function () {
            var selectedData = $("#date").val().split('-');
            var startDate = moment(selectedData[0].trim()).format("MM/DD/YY");
            var endDate = moment(selectedData[1].trim()).format("MM/DD/YY");
            var printVendorCode = $("#PrintVendors option:selected").text() != "Select Print Vendor" ? $("#PrintVendors option:selected").val() : null;
            $.ajax({
                type: "POST",
                url: baseUrl + "Report/_DownloadPVReconReport",
                data: JSON.stringify({
                    printVendorCode: printVendorCode,
                    clientIds:$("#ClientId").val(),
                    startDate: startDate,
                    endDate: endDate,
                    status: $("#Status").val(),
                    shippingMethods: $('#ShippingMethod').val(),
                    timezoneOffset: new Date().getTimezoneOffset()
                }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.Success) {
                         window.clui.globalAlert({
                             message: "Report generated and emailed successfully.",
                             alertType: 'green',
                             timeout: 5000
                        });
                    } else {

                            window.clui.globalAlert({
                                message: response.ErrorMessage,
                                alertType: 'red',
                                timeout: 5000
                            });
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    window.clui.globalAlert({
                        message: "@AM.Services.Config.Web_Msg_Ajax_CommonError",
                        alertType: 'red',
                        timeout: 5000
                    });

                }

            });

        });
</script>
}
