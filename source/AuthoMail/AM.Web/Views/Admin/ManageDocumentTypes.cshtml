        }
        function FormatObject(Model) {
            $(Model).each(function () {
                this.IsActiveFormatted = this.IsActive ? '<div class="toggle-container"><input id="isactive' + this.Id + '" onclick="MakeActiveOrDeactive(this)" data-id="' + this.Id + '" data-isam="1"  data-currentvalue="' + this.IsActive + '" class="cl-toggle toggle-orange" type="checkbox" checked="checked" name="toggle-demo"/><label for="isactive' + this.Id + '">Is Active</label></div>' : '<div class="toggle-container"><input id="isactive' + this.Id + '" onclick="MakeActiveOrDeactive(this)" data-currentvalue="' + this.IsActive + '" data-id="' + this.Id + '" data-isam="1" class="cl-toggle toggle-orange" type="checkbox" name="toggle-demo"/><label for="isactive' + this.Id + '">Is Active</label></div>';
                this.IsReturnInfoSpecified = this.IsReturnInfoSpecified ? '<span id="IsReturnInfoSpecified' + this.Id + '"><span class="label medium label-success">Yes</span></span>' : '<span id="IsReturnInfoSpecified' + this.Id + '"><span class="label medium label-red">NA</span></span>';
                this.IsBRE = this.IsBRE ? '<span id="IsBRE' + this.Id + '"><span  class="label medium label-success">Yes</span></span>' : '<span id="IsBRE' + this.Id + '"><span class="label medium label-yellow">No</span></span>';
                this.AllowInsertsOnly = this.AllowInsertsOnly ? '<span id="AllowInsertsOnly' + this.Id + '"><span  class="label medium label-success">Yes</span></span>' : '<span id="AllowInsertsOnly' + this.Id + '"><span class="label medium label-yellow">No</span></span>';
                this.SLACutOffTime = moment(this.SLACutOffTime).format("HH:mm:ss");
                this.CreatedOn = moment(this.CreatedOn).format("MM/DD/YY HH:mm:ss");
                this.ModifiedOn = moment(this.ModifiedOn).format("MM/DD/YY HH:mm:ss");
                this.Action = '<a style="cursor: pointer;font-size:1.2em;" a href="/Admin/CreateOrEditDocType?id='+this.ClientDocTypeId+'" ><i class="fa fa-edit text-blue" aria-hidden="true" title="Edit"><span class="sr-only">Edit</span></i></a>';
                this.CoverLetter = '<span style="cursor: pointer;font-size:1.2em;margin-right:10%;" onclick="GetCoverLetterFiles(this)" data-id="' + this.Id + '" data-doctypecode="' + this.ClientDocTypesName + '" ><i class=" fa fa-file-pdf-o text-red" aria-hidden="true" title="Remove Cover Letter"><span class="sr-only">Cover Letter</span></i></span>';
                this.MappingPT = '<a href="/Admin/PrintTrailMapByDocId/' + this.Id + '" style="cursor: pointer;font-size:1.2em;margin-right:10%;"  ><i class=" fa fa-list text-blue" aria-hidden="true" title="Print Trail Mapping"><span class="sr-only">Print Trail Mapping</span></i></a>';
                //this.ConfigurationView = '<a style="cursor: pointer;font-size:1.2em;" a href="/Admin/PrintConfigurationByPnSConfigId?pnsConfigId=' + this.PnSConfigId + '&documentType=' + this.DocTypeName + '" ><i class="fa fa-edit text-blue" aria-hidden="true" title="View Print Configuration"><span class="sr-only">Print Configuration</span></i></a>';
                this.ConfigurationView = '<span id="IsConfigurationView' + this.Id + '" onclick="GetPrintConfigurationByPnSConfigId(this)" data-doctypename="' + this.DocTypeName + '" data-pnsconfigid="' + this.PnSConfigId + '" style="cursor:pointer;font-size: 20px;" ><i class="fa fa-eye text-blue" aria-hidden="true" title="View Print Configuration"><span class="sr-only">View Configuration</span></i></span>' ;
            });
            return Model;
        }


        function MakeActiveOrDeactive(obj) {
            var isActive = $(obj).is(":checked");
            var Id = $(obj).data("id");
            var el = $("#myModal").find(".modal-body");
            el.empty();
            $.ajax({
                type: "POST",
                url: baseUrl + "Admin/MakeActiveOrDeactiveDocType",
                data: JSON.stringify({ isActive: isActive, Id: Id }),
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (response) {
                    //Spinners("#pullback", "fa-reply");
                    if (response.Success) {
                        if (response.Object != null) {
                            //if (response.Object == 1 && isActive) {

                            //    el.html("<div class='alert alert-green'>Document Type activated successfully.</div>");
                            //}
                            //if (response.Object == 1 && !isActive) {
                            //    el.html("<div class='alert alert-green'>Document Type deactivated successfully.</div>");
                            //}
                        }
                        GetDocTypes();
                    }
                    else {
                        $(obj).prop('checked', !isActive);
                        el.html("<div class='alert alert-red'>" + response.ErrorMessage + "</div>");
                        $("#myModal").modal("show");
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $(obj).prop('checked', !isActive);
                    //Spinners(".spinnericon", "faspinner");
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#myModal").modal("show");
                }

            });

        }

