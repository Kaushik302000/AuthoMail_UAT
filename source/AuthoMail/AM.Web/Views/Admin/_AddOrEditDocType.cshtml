@model AM.Services.DocTypes

@{

    if (Model.Id == 0)
    {
        Model.ContentScalePercent = 100;
        Model.QCPercent = 0;
    }
    int rangeIndex = 0;
}


<h2 id="myModalLabel">@(Model.Id == 0 ? Html.Raw("Add Document Type Details") : Html.Raw("Edit Document Type Details"))</h2>
<style>
    hr {
        margin-top: 2% !important;
        margin-bottom: 2% !important;
    }

    .frm-control {
        padding: 4px 8px;
    }

    .colmd {
        padding-right: 5px;
        padding-left: 5px;
    }

    .rw {
        border: 1px solid #d9d9d9;
        border-bottom: 1px solid #d9d9d9;
        padding: 8px 4px;
    }

        .rw .colmd {
            border-right: 1px solid #d9d9d9;
        }

    .colmda {
        font-size: 23px;
    }
</style>
<hr />
<form id="doctypeform" action="#" enctype="multipart/form-data">
    <input type="hidden" name="Id" id="Id" value="@Model.Id" />
    <div class="row">
        <div class="row">
            <div class="col-md-12">
                <div class="panel-group">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <div class="panel-title">
                                Basic Configuration
                            </div>
                        </div>
                        <div class="panel-body">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="Description">Document Type Name</label>
                                    <div class="input-group">
                                        <input type="text" id="ClientDocTypesName" class="form-control" placeholder="Document Type Name" name="ClientDocTypesName" required value="@Model.ClientDocTypesName" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="Clients">Clients</label>
                                    @Html.DropDownListFor(model => model.ClientId, ViewBag.Clients as SelectList, "Select Client", htmlAttributes: new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Client" })
                                </div>
                            </div>
                            <div class="clearfix"></div>
                            <div class="col-md-12">
                                <div class="panel panel-default">
                                    <div class="panel-heading">
                                        <div class="panel-title">
                                            Doctype page range configuration
                                            <span class="pull-right">
                                                <button class="btn btn-primary addpagerangebtn" type="button"><i class="fa fa-plus"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="panel-body">
                                        <div class="row" id="PageRangeDiv">
                                            @if (Model.DocTypePageRangeList.Any(m => !m.IsFallBack))
                                            {
                                                foreach (var range in Model.DocTypePageRangeList.Where(m => !m.IsFallBack))
                                                {

                                                    @Html.Action("_DocTypePageRange", "Admin", new { docTypePageRange = range, hasAdd = false, index = rangeIndex, isFallBack = false, shippingServiceType = "" })
                                                    rangeIndex++;
                                                }
                                            }
                                            else
                                            {
                                                @Html.Action("_DocTypePageRange", "Admin", new { docTypePageRange = new AM.Services.DocTypePageRange() { From = 1 }, hasAdd = true, index = rangeIndex, isFallBack = false, shippingServiceType = "" })
                                                rangeIndex++;
                                            }
                                        </div>
                                        <div class="row" id="PageRangeFallBackDiv">
                                            @{
                                                var priorityExp = Model.DocTypePageRangeList.FirstOrDefault(m => m.ShippingServiceType == "PRIORITY_EXPRESS");
                                                var priority = Model.DocTypePageRangeList.FirstOrDefault(m => m.ShippingServiceType == "PRIORITY");
                                                priorityExp = priorityExp ?? new AM.Services.DocTypePageRange(); priorityExp = priorityExp ?? new AM.Services.DocTypePageRange();
                                                priority = priorityExp ?? new AM.Services.DocTypePageRange(); priority = priority ?? new AM.Services.DocTypePageRange();
                                            }

                                            @Html.Action("_DocTypePageRange", "Admin", new { docTypePageRange = priorityExp, hasAdd = false, index = 101, isFallBack = true, shippingServiceType = "PRIORITY_EXPRESS" })

                                            @Html.Action("_DocTypePageRange", "Admin", new { docTypePageRange = priority, hasAdd = false, index = 102, isFallBack = true, shippingServiceType = "PRIORITY" })

                                        </div>
                                    </div>
                                    <br />
                                </div>
                            </div>
