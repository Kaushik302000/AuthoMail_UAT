                                            <option @(Model.SatSLAType == AM.Entities.SLAType.Duration ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.Duration">@AM.Entities.SLAType.Duration</option>
                                            <option @(Model.SatSLAType == AM.Entities.SLAType.FixedTime ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.FixedTime">@AM.Entities.SLAType.FixedTime</option>
