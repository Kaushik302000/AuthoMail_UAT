                        <div class="panel-body">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="Description">Print Size</label>
                                    @Html.DropDownListFor(model => model.PrintSize, (IEnumerable<SelectListItem>)ViewBag.PrintSizedropDown, "Select Print Size", htmlAttributes: new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Print Size" })
