@model ICollection<AM.Services.DocTypeCoverLetterVM>

<h2 id="myModalLabel">Cover Letter for <span id="docTypeCodeModal"></span></h2>

<hr />

<div class="row" style="margin-bottom:10px;">
    <div class="col-md-12">
        <h3>Cover Letter Files</h3>
        <table class="table table-responsive">
            <thead>
                <tr>
                    <th width="70%">File Name</th>
                    <th width="20%">Sequence</th>
                    <th width="10%">Action</th>
                </tr>
            </thead>
            <tbody id="fileList">
                @if (Model.Count() > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CoverLetterTemplatePath</td>
                            <td>@item.SeqId</td>
                            <td><span style='cursor: pointer;' onclick="RemoveCoverLetter(@item.DocTypeId,@item.SeqId,'@item.CoverLetterTemplatePath')" title="Remove Cover Letter">  <i class='fa fa-trash text-blue'></i></span></td>
                        </tr>
                    }

                }
                else
                {
                    <tr>
                        <td colspan="3">No cover letter found for this doctype.</td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>

<hr />
<button type="button" class="btn btn-primary pull-right" data-dismiss="modal"><i class="fa fa-close"></i> Close</button>


