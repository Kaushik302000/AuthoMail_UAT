@{
    ViewBag.Title = "Inventory Stock";
}

<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />

<style>
    #dateFilter .bootstrap-select {
        width: 100% !important;
    }


    .dataTables_wrapper {
        margin-top: -1.5% !important;
    }

    .popover-content {
        word-wrap: break-word;
        color: red;
    }
</style>
<div class="row">
    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="panel-title">
                <i class="fa fa-envelope"></i> Envelope Inventory Stock Details <span class="pull-right">
                    <a href="/Admin/ManageEnvelopesInventory" class="btn btn-primary "> Manage Envelopes Inventory Stock </a>
                </span>
            </div>
        </div>
        <div class="panel-body panel-gray" style="padding:2% 2% 2% 2% !important;min-height: 107px;">
            <div class='alert alert-blue text-center' id="loading" style="display:none"><span> Loading... </span></div>
            <div id="EnvelopeList"></div>

        </div>
    </div>

</div>

<!--Envelope table html template code -->
<div id="EnvelopeTableContent" style="display:none">
    <table class="table table-responsive" style="overflow-x:scroll">
        <thead>
            <tr>
                <th>Action</th>
                @*<th>Stock Added By & On </th>*@
                <th>Envelope Name</th>
                <th>Shipper Name</th>
                <th>Current Quantity</th>
                <th>Reorder Duration</th>
                <th>Is BRE Envelope?</th>
                <th>Stock Remain Days</th>
                <th>Alert Level</th>
            </tr>
        </thead>
        <tbody id="EnvelopebodyContent"></tbody>
    </table>
</div>
<div style="display:none">
    <table>
        <tbody id="EnvelopeBody">
            <tr class="row-small">
                <td>{Action}</td>
                @*<td><span>{LastUpdated}</span></td>*@
                <td><span>{EnvelopeName}</span></td>
                <td><span>{ShipperName}</span></td>
                <td><span>{CurrentQuantity}</span></td>
                <td><span>{ReorderDuration}</span></td>
                <td><span>{IsBREEnvelope}</span></td>
                <td><span>{EnvDays}</span></td>
                <td><span>{AlertLevelFormatted}</span></td>
            </tr>
        </tbody>
    </table>
</div>
<!-- end table template code -->
<div class="modal fade" id="EditReorderModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header" style="margin-top:2%;margin-bottom:2%;">
                <h2 id="myModalLabel">Edit Reorder Duration</h2>
                <hr />
                <form id="envelopeform" action="#">
                    <input type="hidden" id="shipperId" name="shipperId" />
                    <input type="hidden" id="envelopeId" name="envelopeId" />
                    <div class="form-group">
                        <label for="Name">Envelope Name</label>
                        <div class="input-group">
                            <span id="envelopeName"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="Name">Shipper Name</label>
                        <div class="input-group">
                            <span id="shipperName"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="ReorderDuration">Reorder Duration</label>
                        <div class="input-group">
                            <input type="number" id="ReorderDuration" class="form-control" name="ReorderDuration" />
                        </div>
                    </div>

                    <hr />
                    <button type="submit" class="btn btn-primary" id="Save"><i class="fa fa-save"></i> Save</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-close"></i> Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">Envelope Reorder Duration </h1>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")

<script type="text/javascript">
        $(document).ready(function () {
            window.clui.dateTimePickerInit();
            GetData();
            // JSON.useDateParser(false);
        });
        function FormatObject(Model) {
            $(Model).each(function () {
                this.EnvelopeNameFormated = '<a class="viewdetails" style="cursor:pointer" onclick="ViewDetails(this)" data-id="' + this.Id + '">' + this.EnvelopeName + '</a>';
                this.IsBREEnvelope = this.IsBREEnvelope ? '<span  class="label medium label-yellow">Yes</span>' : '<span class="label medium label-success">No</span>';
                this.Action = '<span style="cursor: pointer;font-size:1.2em;" onclick="EditReorderDuration(this)" data-shipperid="' + this.ShipperId + '" data-envelopeid="' + this.EnvelopeId + '" data-envelopename="' + this.EnvelopeName + '" data-duration="' + this.ReorderDuration + '" data-shippername="' + this.ShipperName + '"><i class="padding-left-15 fa fa-edit text-blue" aria-hidden="true" title="Edit"><span class="sr-only">Edit</span></i></span>';
                this.LastUpdated = this.ModifiedBy + " <br />on " + moment(this.ModifiedOn).format("MM/DD/YY HH:mm:ss");
                this.ReorderDuration = (this.ReorderDuration == null || this.ReorderDuration == "") ? "--" : this.ReorderDuration;
                this.EnvDays = (this.EnvDays == null || this.EnvDays == "") ? "-" : this.EnvDays;
                var color = this.AlertLevel == 0 ? "green" : this.AlertLevel == 1 ? "yellow" : "red";
                this.AlertLevelFormatted = '<i class="fa fa-envelope-open" style="color: ' + color + ';"></i>';
            });
            return Model;
    }
    function ValidateForm() {
        window.clui.selectInit();
        init();
        $('#envelopeform').validate({ // initialize the plugin
            errorElement: "span",
            rules: {
                ReorderDuration: {
                    required: true,
                    digits: true,
                }
            },
            submitHandler: function (form) {
                $("#EditReorderModal").modal("hide");
                SaveReduration();
            }
        });

    }
    function SaveReduration() {
           var el = $("#myModal").find(".modal-body");
            el.empty();
            $.ajax({
                type: "POST",
                url: baseUrl + "Admin/UpdateReorderDuration",
                data: { envelopeId: $("#envelopeId").val(), shipperId: $("#shipperId").val(), reorderDuration: $("#ReorderDuration").val() },
                success: function (response) {
                    if (response.Success) {
                        if (response.Object != null) {
                            if (response.Object.Key) {
                                el.html("<div class='alert alert-green'>" + response.Object.Value + "</div>");
                                GetData();
                            }
                            else {
                                el.html("<div class='alert alert-red'>" + response.Object.Value + "</div>");
                            }
                        }
                    }
                    else {

                        el.html("<div class='alert alert-red'>" + response.ErrorMessage + "</div>");
                    }
                    $("#myModal").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#myModal").modal("show");
                }
            });
    }
    function EditReorderDuration(obj) {
        var shipperId = $(obj).data("shipperid");
        var envelopeId = $(obj).data("envelopeid");
        var envelopeName = $(obj).data("envelopename");
        var shipperName = $(obj).data("shippername");
        var duration = $(obj).data("duration");
            //console.log(envelopeName);
        $("#EditReorderModal").modal("show");
        $("#EditReorderModal").find("#envelopeName").text(envelopeName);
        $("#EditReorderModal").find("#shipperName").text(shipperName);
        $("#EditReorderModal").find("#envelopeId").val(envelopeId);
        $("#EditReorderModal").find("#shipperId").val(shipperId);
        $("#EditReorderModal").find("#ReorderDuration").val(duration);
        ValidateForm();
        }

