@model ICollection<AM.Services.ProjectRequest>
@{
    ViewBag.Title = "All Project Setup Details";
}


<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<style>
    #dateFilter .bootstrap-select {
        width: 100% !important;
    }


    .dataTables_wrapper {
        margin-top: -1.5% !important;
    }

    .popover-content {
        word-wrap: break-word;
        color: red;
    }
</style>
<div class="panel panel-default">

    <div class="panel-heading" id="clientHeader">
        <div class="panel-title">
            <i class="fa fa-cogs"></i> All Project Setup Details
            <span class="pull-right" @*style=" margin-right: 11%;" *@>
                <a href="~/Admin/ProjectSetup?id=0" class="btn btn-primary "><i class="fa fa-plus"></i> Add Project Setup</a>
            </span>
        </div>
    </div>
    <div class="panel-body">
        @if (Model.Count == 0)
        {
            <div style='margin-bottom:10px;' class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>
        }
        else
        {
            <table class="table table-responsive" id="sample_2" style="overflow-x:scroll">
                <thead>
                    <tr>
                        <th style="min-width:99px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Action</th>
                        <th>Project Name</th>
                        <th>Submitter</th>
                        <th>Submit Date</th>
                        <th>Project Start Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var projectRequest in Model)
                    {
                        <tr>
                            <td>
                                <a href="~/Admin/ProjectSetup?id=@projectRequest.Id"><i class="padding-left-15 fa fa-edit text-blue" aria-hidden="true" title="Edit"><span class="sr-only">Edit</span></i></a>
                                <a href="~/Admin/DownloadProjectSetupExcelFile?id=@projectRequest.Id"><i class="padding-left-15 fa fa-file-excel-o text-blue" aria-hidden="true" title="Download Excel"><span class="sr-only">Download Excel</span></i></a>
                                <a href="~/Admin/DownloadProjectSetupPdfFile?id=@projectRequest.Id"><i class="padding-left-15 fa fa-file-pdf-o text-blue" aria-hidden="true" title="Download Pdf"><span class="sr-only">Download Pdf</span></i></a>


                            </td>
                            <td>@projectRequest.ClientName</td>
                            <td>@projectRequest.SubmittedBy</td>
                            <td>@(projectRequest.SubmittedOn.HasValue ? projectRequest.SubmittedOn.Value.ToShortDateString() : "--")</td>
                            <td>@(projectRequest.ProdStartOn.HasValue ? projectRequest.ProdStartOn.Value.ToShortDateString() : "--")</td>
                            
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>
</div>

@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")

    <script type="text/javascript">

        $(document).ready(function () {
            applyDataTable();
        });
