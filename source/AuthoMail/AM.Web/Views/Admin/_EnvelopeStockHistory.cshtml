@model ICollection<AM.Services.EnvelopeInventory>

<h2 id="myModalLabel">@ViewBag.Name Envelope Inventory Details</h2>
<hr />
<div class="row">
    <div class="col-md-12">
        <table class="table table-responsive" style="overflow-x:scroll">
            <thead>
                <tr>
                    <th>Stock Added By & On</th>
                    @*<th>Envelope Name</th>*@
                    <th>Shipper Name</th>
                    <th>Quantity</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5">
                            <div style='margin-bottom:10px;' class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var stockModel in Model)
                    {
                        <tr>
                            <td>@stockModel.ModifiedBy <br />on @stockModel.ModifiedOn.ToString("MM/dd/yy HH:mm:ss")</td>
                            @*<td>@stockModel.EnvelopeName</td>*@
                            <td>@stockModel.Shipper</td>
                            <td>@stockModel.ReceivedQuantity</td>
                            <td>@stockModel.Description</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    </div>
</div>