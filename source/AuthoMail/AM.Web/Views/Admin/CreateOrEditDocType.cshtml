</div>

@section Scripts{
    <script src="~/Scripts/jquery.inputmask.js"></script>
    <script src="~/Scripts/jquery.inputmask.date.extensions.js"></script>
    <script src="~/Scripts/jquery.inputmask.extensions.js"></script>
    <script type="text/javascript">
    $(document).ready(function () {
        var index = '@rangeIndex';
        var success = '@ViewBag.Success';
        console.log(success);
        if (success != null && success != undefined && success != "")
            alertMessage("green", success);
        if ($("#Id").val() == "0") {
            $(".daytimespan").val("00:00:00:00");
            $(".timespan").val("00:00:00");
        }
        $(".daytimespan").inputmask('datetime', {
            mask: "X:h:s:s",
            placeholder: "dd:hh:mm:ss",
            separator: ':',
            hourFormat: "24"
        });
        $(".timespan").inputmask('datetime', {
            mask: "h:s:s",
            placeholder: "hh:mm:ss",
            separator: ':',
            hourFormat: "24"
        });
        //var Message = function (id,message) {
        //    var alert = '<div id="message" class="alert alert-yellow">' + message + '</div>';
        //    $(id).append($(alert).delay(5000).fadeOut()).show();
        //}
        var AddNewPageRange = function () {
            $('.addpagerangebtn').unbind('click');
            $('.addpagerangebtn').bind('click', function (e) {
                var idx = index - 1;
                if (idx == 0) {
                    if ($('#To' + idx).val() == 999) {
                        alertMessage("yellow", "Page range limit is over.");
                        return false;
                    }
                    if ($('#To' + idx).val() == 0) {
                        alertMessage("yellow", "Page To range must be larger then 0.");
                        return false;
                    }
                }
                var lastToVal = $('#To' + idx).val();
                if (lastToVal == 999) {
                    alertMessage("yellow", "Page range limit is over.");
                        return false;
                }
                if (lastToVal == 0) {
                        alertMessage("yellow", "Page To range must be larger then 0.");
                        return false;
                }
                if ($('#From' + idx).val() > $('#To' + idx).val()) {
                     alertMessage("yellow", "Page From range can't be smaller than To.");
                        return false;
                }
                $.ajax({
                    type: "GET",
                    url: baseUrl+"Admin/_DocTypePageRangeAjax",
                    data: {index:index},
                    success: function (response) {
                        $('#PageRangeDiv').append(response);
                        $('#From' + index).val(parseInt(lastToVal)+1);
                        index++;
                    },
                    error: function (err) {
                        console.log(err);
                    }
                });
            });
        }
        AddNewPageRange();
    });

    </script>
}