@model AM.Services.ClientDocTypes


@{

    if (Model.Id == 0)
    {
        Model.DocTypes.ContentScalePercent = 100;
        Model.DocTypes.QCPercent = 0;
    }
    int rangeIndex = 2;
    var fallBackShippingServiceType = new List<string>() { "PRIORITY_EXPRESS", "PRIORITY" };
    var pageRangeDocTypes = Model.DocTypes.DocTypePageRangeList.Where(m => !fallBackShippingServiceType.Any(f => f == m.ShippingServiceType)).ToList();
}


<style>
    hr {
        margin-top: 2% !important;
        margin-bottom: 2% !important;
    }

    .frm-control {
        padding: 4px 8px;
    }

    .colmd {
        padding-right: 5px;
        padding-left: 5px;
    }

    .rw {
        border: 1px solid #d9d9d9;
        border-bottom: 1px solid #d9d9d9;
        padding: 8px 4px;
    }

        .rw .colmd {
            border-right: 1px solid #d9d9d9;
        }

    .colmda {
        font-size: 23px;
    }

    .validation-summary-errors {
        color: red;
    }
</style>

<div class="panel panel-default">
    <div class="panel-heading">
        <div class="panel-title">
            @(Model.Id == 0 ? Html.Raw("Add Document Type Details") : Html.Raw("Edit Document Type Details"))
            <span class="pull-right">
                <a href="/Admin/ManageDocumentTypes" class="btn btn-primary" type="button" title="Back to document type"><i class="fa fa-backward"></i> Go Back</a>
            </span>
        </div>
    </div>
    <form id="doctypeform" action="/Admin/CreateOrEditDocType" method="post" enctype="multipart/form-data">
        <div class="panel-body" style="padding:0px;">
            <div>@Html.ValidationSummary()</div>
            @Html.HiddenFor(model => model.Id)
            <div class="row" style="margin-right:-10px;margin-left:-10px;">
                <div class="col-md-12">
                    <div class="panel-group">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="panel-title">
                                    <h3>Basic Configuration</h3>
                                </div>
                            </div>
                            <div class="panel-body">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Document Type Name</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.DocTypeName, htmlAttributes: new { @class = "form-control", @data_title = "DocTypeName", @placeholder = "Document Type Name" })
                                            @*<input type="text" id="Name" class="form-control" placeholder="Document Type Name" name="Name" required value="@Model.Name" />*@
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Client">Client</label>
                                        @Html.DropDownListFor(model => model.ClientId, ViewBag.Clients as SelectList, htmlAttributes: new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Client", @data_title = "Select Client" })
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Shipping Account Code</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.DocTypes.ShippingAccountCode, htmlAttributes: new { @class = "form-control", @data_title = "Shipping Account Code", @placeholder = "Shipping Account Code" })
                                            @*<input type="text" id="ShippingAccountCode" class="form-control" placeholder="Shipping Account Code" name="DocTypes.ShippingAccountCode" value="@Model.DocTypes.ShippingAccountCode" />*@
                                        </div>
                                    </div>
                                </div>
                                <div class="clearfix"></div>
                                <div class="col-md-12">
                                    <div class="panel panel-default">
                                        <div class="panel-heading">
                                            <div class="panel-title">
                                                <h3>
                                                    Doctype page range configuration
                                                    <span class="pull-right">
                                                        <button class="btn btn-primary addpagerangebtn" type="button" title="Add new doctype page range"><i class="fa fa-plus"></i></button>
                                                    </span>
                                                </h3>
                                            </div>
                                        </div>
                                        <div class="panel-body">
                                            <div class="row">
                                                <div class="col-md-2 colmd">
                                                    <div class="col-md-2 colmd">
                                                        <label>#</label>
                                                    </div>
                                                    <div class="col-md-5 colmd">
                                                        <label>From</label>
                                                    </div>
                                                    <div class="col-md-5 colmd">
                                                        <label>To</label>
                                                    </div>
                                                </div>

                                                <div class="col-md-2 colmd">
                                                    <label>Shipping Carrier</label>
                                                </div>
                                                <div class="col-md-2 colmd">
                                                    <label>Shipping Service Type</label>
                                                </div>
                                                <div class="col-md-2 colmd">
                                                    <label>Shipping Special Service</label>
                                                </div>
                                                <div class="col-md-2 colmd">
                                                    <label>Envelope</label>
                                                </div>
                                                <div class="col-md-2 colmd" style="border-right:none;">
                                                    <label>BRE Envelope</label>
                                                </div>
                                            </div>

                                            <div class="clearfix"></div>
                                            <div class="row" id="PageRangeDiv" style="padding-top:0px !important;">
                                                @if (pageRangeDocTypes.Count() > 0)
                                                {
                                                    foreach (var range in pageRangeDocTypes)
                                                    {
                                                        @Html.Action("_DocTypePageRange", "Admin", new { docTypePageRange = range, index = rangeIndex, isFallBack = false, shippingServiceType = "" })
                                                        rangeIndex++;
                                                    }
                                                }
                                                else
                                                {
                                                    @Html.Action("_DocTypePageRange", "Admin", new { docTypePageRange = new AM.Services.DocTypePageRange() { From = 1 }, index = rangeIndex, isFallBack = false, shippingServiceType = "" })
                                                    rangeIndex++;
                                                }
                                            </div>
                                            <h3 style="margin-top:5px;margin-bottom:-5px;">Fallback doctype page range configuration</h3>
                                            <div class="row" id="PageRangeFallBackDiv">
                                                @{
                                                    var priorityExp = Model.DocTypes.DocTypePageRangeList.FirstOrDefault(m => m.ShippingServiceType == "PRIORITY_EXPRESS");
                                                    var priority = Model.DocTypes.DocTypePageRangeList.FirstOrDefault(m => m.ShippingServiceType == "PRIORITY");
                                                    priorityExp = priorityExp ?? new AM.Services.DocTypePageRange();
                                                    priority = priority ?? new AM.Services.DocTypePageRange();
                                                }

                                                @Html.Action("_DocTypePageRange", "Admin", new { docTypePageRange = priorityExp, index = 0, isFallBack = true, shippingServiceType = fallBackShippingServiceType.First() })

                                                @Html.Action("_DocTypePageRange", "Admin", new { docTypePageRange = priority, index = 1, isFallBack = true, shippingServiceType = fallBackShippingServiceType[1] })

                                            </div>
                                        </div>
                                        <br />
                                    </div>
                                </div>

                                <div class="clearfix"></div>
                                <br />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="clearfix"></div>
                <div class="col-md-12">
                    <div class="panel-group">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="panel-title">
                                    <h3>Printing Configuration</h3>
                                </div>
                            </div>
                            <div class="panel-body">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Print Size</label>
                                        @Html.DropDownListFor(model => model.DocTypes.PrintSize, (IEnumerable<SelectListItem>)ViewBag.PrintSizedropDown, "Select Print Size", htmlAttributes: new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Print Size" })
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Print Format</label>
                                        @Html.DropDownListFor(model => model.DocTypes.PrintFormat, (IEnumerable<SelectListItem>)ViewBag.PrintFormatdropDown, "Select Print Format", htmlAttributes: new { @class = " form-control selectpicker", @data_live_search = "true", @data_live_search_placeholder = "Search Print Format" })
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Content Scale Percent</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.DocTypes.ContentScalePercent, htmlAttributes: new { @class = "form-control", @data_title = "Content Scale Percent", @placeholder = "Content Scale Percent" })
                                            @*<input type="text" id="ContentScalePercent" class="form-control" placeholder="Content Scale Percent" name="DocTypes.ContentScalePercent" value="@Model.DocTypes.ContentScalePercent" />*@
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="NoOfCopies">No Of Copies</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.DocTypes.NoOfCopies, htmlAttributes: new { @class = "form-control", @data_title = "No of copies", @placeholder = "No of copies" })
                                            @*<input type="number" id="NoOfCopies" value="@Model.DocTypes.NoOfCopies" class="form-control" placeholder="No Of Copies" name="NoOfCopies" />*@
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">QC Percent</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.DocTypes.QCPercent, htmlAttributes: new { @class = "form-control", @data_title = "QC Percent", @placeholder = "QC Percent" })
                                            @*<input type="text" id="QCPercent" class="form-control" name="QCPercent" placeholder="QC Percent" value="@Model.DocTypes.QCPercent" />*@

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-12">
                    <div class="panel-group">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="panel-title">
                                    <h3>Cutoff Configuration</h3>
                                </div>
                            </div>
                            <div class="panel-body">

                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Bizday SLA Type</label>
                                        <div class="input-group">
                                            <select id="BizdaySLAType" class="form-control" name="DocTypes.BizdaySLAType">
                                                <option @(Model.DocTypes.BizdaySLAType == AM.Entities.SLAType.NA ? "selected='selected'" : "") value="@AM.Entities.SLAType.NA">@AM.Entities.SLAType.NA</option>
                                                <option @(Model.DocTypes.BizdaySLAType == AM.Entities.SLAType.Duration ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.Duration">@AM.Entities.SLAType.Duration</option>
                                                <option @(Model.DocTypes.BizdaySLAType == AM.Entities.SLAType.FixedTime ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.FixedTime">@AM.Entities.SLAType.FixedTime</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Bizday Cut Off</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.DocTypes.BizdayCutOff, htmlAttributes: new { @class = "form-control timespan", @data_title = "Bizday Cut Off", @placeholder = "Bizday Cut Off" })
                                            @*<input type="text" id="BizdayCutOff" value="@Model.DocTypes.BizdayCutOff" class="form-control timespan" placeholder="Bizday Cut Off" name="BizdayCutOff" />*@

                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Bizday Timespan</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.DocTypes.BizdayTimeSpan, htmlAttributes: new { @class = "form-control daytimespan", @data_title = "Bizday Time Span", @placeholder = "Bizday Time Span" })
                                            @*<input type="text" id="BizdayTimeSpan" value="@Model.DocTypes.BizdayTimeSpan" class="form-control daytimespan" placeholder="Bizday Timespan" name="BizdayTimeSpan" />*@

                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Sat SLA Type</label>
                                        <div class="input-group">
                                            <select id="SatSLAType" class="form-control" name="DocTypes.SatSLAType">
                                                <option @(Model.DocTypes.SatSLAType == AM.Entities.SLAType.NA ? "selected='selected'" : "") value="@AM.Entities.SLAType.NA">@AM.Entities.SLAType.NA</option>
                                                <option @(Model.DocTypes.SatSLAType == AM.Entities.SLAType.Duration ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.Duration">@AM.Entities.SLAType.Duration</option>
                                                <option @(Model.DocTypes.SatSLAType == AM.Entities.SLAType.FixedTime ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.FixedTime">@AM.Entities.SLAType.FixedTime</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Sat Cut Off</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.DocTypes.SatCutOff, htmlAttributes: new { @class = "form-control timespan", @data_title = "Sat Cut Off", @placeholder = "Sat Cut Off" })
                                            @*<input type="text" id="SatCutOff" value="@Model.DocTypes.SatCutOff" class="form-control timespan" placeholder="Sat Cut Off" name="SatCutOff" />*@

                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Sat Timespan</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.DocTypes.SatTimeSpan, htmlAttributes: new { @class = "form-control daytimespan", @data_title = "Sat Time Span", @placeholder = "Sat Time Span" })
                                            @*<input type="text" id="SatTimeSpan" value="@Model.DocTypes.SatTimeSpan" class="form-control daytimespan" placeholder="Sat Timespan" name="DocTypes.SatTimeSpan" />*@
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Sun SLA Type</label>
                                        <div class="input-group">
                                            <select id="SunLAType" class="form-control" name="DocTypes.SunSLAType">
                                                <option @(Model.DocTypes.SunSLAType == AM.Entities.SLAType.NA ? "selected='selected'" : "") value="@AM.Entities.SLAType.NA">@AM.Entities.SLAType.NA</option>
                                                <option @(Model.DocTypes.SunSLAType == AM.Entities.SLAType.Duration ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.Duration">@AM.Entities.SLAType.Duration</option>
                                                <option @(Model.DocTypes.SunSLAType == AM.Entities.SLAType.FixedTime ? "selected='selected'" : "") @Model value="@AM.Entities.SLAType.FixedTime">@AM.Entities.SLAType.FixedTime</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Sun Timespan</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.DocTypes.SunTimeSpan, htmlAttributes: new { @class = "form-control daytimespan", @data_title = "Sun Time Span", @placeholder = "Sun Time Span" })
                                            @*<input type="text" id="SunTimeSpan" value="@Model.DocTypes.SunTimeSpan" class="form-control daytimespan" placeholder="Sun Timespan" name="SunTimeSpan" />*@
                                        </div>

                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="Description">Sun Cut Off</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.DocTypes.SunCutOff, htmlAttributes: new { @class = "form-control timespan", @data_title = "Sun Cut Off", @placeholder = "Sun Cut Off" })
                                            @*<input type="text" id="SunCutOff" value="@Model.DocTypes.SunCutOff" class="form-control timespan" placeholder="Sun Cut Off" name="SunCutOff" />*@

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-12">
                    <div class="panel-group">
                        <div class="panel panel-default">
                            <div class="panel-heading" id="headingOne">
                                <a role="button" data-toggle="collapse" aria-expanded="false" id="isreturninfo" class="collapsed" @*onclick="ShowHideReturnInfo(this)" class="@(Model.IsReturnInfoSpecified ? "collapse" : "collapsed")"*@ data-parent="#accordion" href="#tabreturninfo">
                                    <div class="panel-title">
                                        <h3>Click here to fill return info.</h3>
                                        <div class="collapsed-icon pull-right">
                                            <i class="fa fa-caret-left"></i>
                                        </div>
                                        <div class="expanded-icon pull-right">
                                            <i class="fa fa-caret-down"></i>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            <div id="tabreturninfo" class="panel-collapse collapse">
                                @*@(Model.IsReturnInfoSpecified ? "in" : "")*@
                                <div class="panel-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <input type="hidden" id="IsReturnInfoSpecified" value="@(Model.DocTypes.IsReturnInfoSpecified ? "true" : "false")" name="DocTypes. IsReturnInfoSpecified" />
                                            <div class="form-group">
                                                <label for="Description">Prefix</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptPrefix" class="form-control returninfovalidate" placeholder="Prefix" name="DocTypes.RetRcptPrefix" value="@Model.DocTypes.RetRcptPrefix" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">First Name</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptFirstName" class="form-control returninfovalidate" placeholder="First Name" name="DocTypes.RetRcptFirstName" value="@Model.DocTypes.RetRcptFirstName" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">Middle Name</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptMiddleName" placeholder="Middle Name" class="form-control returninfovalidate" name="DocTypes.RetRcptMiddleName" value="@Model.DocTypes.RetRcptMiddleName" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">Last Name</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptLastName" placeholder="Last Name" class="form-control returninfovalidate" name="DocTypes.RetRcptLastName" value="@Model.DocTypes.RetRcptLastName" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">Suffix</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptSuffix" class="form-control returninfovalidate" placeholder="Suffix" name="DocTypes.RetRcptSuffix" value="@Model.DocTypes.RetRcptSuffix" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">Phone</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptPhone" placeholder="Phone" class="form-control returninfovalidate" name="DocTypes.RetRcptPhone" value="@Model.DocTypes.RetRcptPhone" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">Organization</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptOrganization" placeholder="Organization" class="form-control returninfovalidate" name="DocTypes.RetRcptOrganization" value="@Model.DocTypes.RetRcptOrganization" />
                                                </div>

                                            </div>
                                        </div>
                                        <div class="col-md-4">

                                            <div class="form-group">
                                                <label for="Description">Address Line1 Above Street</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptAddrOptionalLine1AboveStreet" class="form-control returninfovalidate" placeholder="Address Line1 Above Street" name="DocTypes.RetRcptAddrOptionalLine1AboveStreet" value="@Model.DocTypes.RetRcptAddrOptionalLine1AboveStreet" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">Address Line2 Above Street</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptAddrOptionalLine2AboveStreet" placeholder="Address Line2 Above Street" class="form-control returninfovalidate" name="DocTypes.RetRcptAddrOptionalLine2AboveStreet" value="@Model.DocTypes.RetRcptAddrOptionalLine2AboveStreet" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">Street</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptAddressStreet" placeholder="Street Address" class="form-control returninfovalidate" name="DocTypes.RetRcptAddressStreet" value="@Model.DocTypes.RetRcptAddressStreet" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">APARTMENT OR SUITE</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptAddressAptOrSuiteOrOther" class="form-control returninfovalidate" placeholder="Apartment Or Suite" name="DocTypes.RetRcptAddressAptOrSuiteOrOther" value="@Model.DocTypes.RetRcptAddressAptOrSuiteOrOther" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">Address Line1 Below Street</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptAddrOptionalLine1BelowStreet" class="form-control returninfovalidate" placeholder="Address Line1 Below Street" name="DocTypes.RetRcptAddrOptionalLine1BelowStreet" value="@Model.DocTypes.RetRcptAddrOptionalLine1BelowStreet" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">Address Line2 Below Street</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptAddrOptionalLine2BelowStreet" class="form-control returninfovalidate" placeholder="Address Line2 Below Street" name="DocTypes.RetRcptAddrOptionalLine2BelowStreet" value="@Model.DocTypes.RetRcptAddrOptionalLine2BelowStreet" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">City</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptAddressCity" class="form-control returninfovalidate" placeholder="City" name="DocTypes.RetRcptAddressCity" value="@Model.DocTypes.RetRcptAddressCity" />
                                                </div>

                                            </div>
                                        </div>
                                        <div class="col-md-4">


                                            <div class="form-group">
                                                <label for="Description">State</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptAddressState" placeholder="State" class="form-control returninfovalidate" name="DocTypes.RetRcptAddressState" value="@Model.DocTypes.RetRcptAddressState" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">Zip Code</label>
                                                <div class="input-group">
                                                    <input type="text" id="RetRcptAddressZIP" class="form-control returninfovalidate" placeholder="Zip code" name="DocTypes.RetRcptAddressZIP" value="@Model.DocTypes.RetRcptAddressZIP" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">Client Emails</label>
                                                <div class="input-group">
                                                    <input type="text" id="ClientEmails" class="form-control returninfovalidate" placeholder="Client Emails" name="DocTypes.ClientEmails" value="@Model.DocTypes.ClientEmails" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="Description">Client Contact No.</label>
                                                <div class="input-group">
                                                    <input type="text" id="ClientContactNo" placeholder="Client Contact No." class="form-control returninfovalidate" name="DocTypes.ClientContactNo" value="@Model.DocTypes.ClientContactNo" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="Description">Support Emails</label>
                                                <div class="input-group">
