@{
    ViewBag.Title = "ManageSFTChannels";
}

<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<style>
    #dateFilter .bootstrap-select {
        width: 100% !important;
    }


    .dataTables_wrapper {
        margin-top: -1.5% !important;
    }

    .popover-content {
        word-wrap: break-word;
        color: red;
    }

    .tooltip-inner {
        /*max-width: 453px !important;*/
        word-wrap: break-word !important;
    }
</style>
<div class="panel panel-default">

    <div class="panel-heading" id="clientHeader">
        <div class="panel-title">
            <i class="fa fa-sitemap"></i> SFT Channel Details
            <span class="pull-right" @*style=" margin-right: 11%;" *@>
                <button type="button" data-id="0" class="btn btn-primary " onclick="AddEditSFTChannel(this)"><i class="fa fa-plus"></i> Add SFT Channel</button>
            </span>
        </div>
    </div>
    <div class="panel-body" id="SFTChannelList">
        <div class='alert alert-blue text-center' id="loading" style="display:none;margin-bottom:10px;"><span> Loading... </span></div>
    </div>
</div>


<div id="SFTChannelTableContent" style="display:none">
    <table class="table table-responsive" style="overflow-x:scroll">
        <thead>
            <tr>
                <th>Action</th>
                <th>Code</th>
                <th>Description</th>
                <th>Title</th>
                <th>IsActive</th>
                <th>Protocol</th>
                <th>Host</th>
                <th>User Name</th>
                <th>Password</th>
                <th>To ADE Dir</th>
                <th>From ADE Dir</th>
                <th>Archive Dir</th>
                <th>Post Download Action</th>
            </tr>
        </thead>
        <tbody id="SFTChannelbodyContent"></tbody>
    </table>
</div>
<div style="display:none">
    <table>
        <tbody id="SFTChannelBody">
            <tr class="row-small">
                <td>{Action}</td>
                <td><span data-id="{Id}">{Code}</span></td>
                <td><span>{Description}</span></td>
                <td><span>{Title}</span></td>
                <td><span>{IsActiveFormatted}</span></td>
                <td><span>{Protocol}</span></td>
                <td><span>{Host}</span></td>
                <td><span>{UserName}</span></td>
                <td><span>{Password}</span></td>
                <td><span data-toggle="tooltip" data-placement="top" data-container="body" title="{ToADEDir}">{ToADEDirShort}</span></td>
                <td><span data-toggle="tooltip" data-placement="top" data-container="body" title="{FromADEDir}">{FromADEDirShort}</span></td>
                <td><span data-toggle="tooltip" data-placement="top" data-container="body" title="{ArchiveDir}">{ArchiveDirShort}</span></td>
                <td><span>{PostDownloadAction}</span></td>
            </tr>
        </tbody>
    </table>
</div>


<div class="modal fade" id="AddEditModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header" style="margin-top:2%;margin-bottom:2%;">

            </div>
        </div>
    </div>
</div>

