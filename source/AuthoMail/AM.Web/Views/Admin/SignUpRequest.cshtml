@{
    ViewBag.Title = "SingUpRequest";
}
<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />

<style>
    #alertContainer {
        z-index: 1101;
    }

    .btnsize {
        padding: 4px 12px !important;
    }

    .dataTables_wrapper {
        margin-top: -1.5% !important;
    }
</style>
<div class="panel panel-default">
    <div class='alert alert-blue text-center' id="loading" style="display:none"><span> Loading... </span></div>
    <div class="panel-heading" id="signUpHeader">
        <div class="panel-title">
            <i class="fa fa-lock"></i>
            Client sign up request.
        </div>
    </div>
    <div class="panel-body" id="signUpRequestList">

    </div>
</div>
<!-- table html template code -->
<div id="signUpTableContent" style="display:none">
    <table class="table table-responsive" style="overflow-x:scroll">
        <thead>
            <tr>
                <th>Action</th>
                <th>User Name</th>
                <th>Email</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Display Name</th>
                <th>Email Confirmed</th>
                <th>Received Date <span class="fontcapitalize">(Local)</span></th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody id="signUpbodyContent"></tbody>
    </table>
</div>
<div style="display:none">
    <table>
        <tbody id="signUpBody">
            <tr class="row-small">
                <td style="padding-right:0px !important;"><span>{button}</span></td>
                <td><span>{UserName}</span></td>
                <td><span>{Email}</span></td>
                <td><span>{FirstName}</span></td>
                <td><span>{LastName}</span></td>
                <td><span>{DisplayName}</span></td>
                <td><span>{IsConfirmed}</span></td>
                <td><span>{RequestedOnFormatted}</span></td>
                <td><span class="label medium label-blue">{Status}</span></td>
            </tr>
        </tbody>
    </table>
</div>
<!-- end table template code -->

<div class="modal fade" id="approveModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-userid="" data-status="">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header" style="margin-top:2%;margin-bottom:2%;">
                @*<h2 id="myModalLabel">Are you sure you want to approve client sign up request? </h2>*@
                <h2>Please select Role & AppCode(s).</h2>
            </div>
            <div class="modal-body">
                <div class="errormsg"></div>
                <input type="hidden" id="auserId" name="auserId" />
                <input type="hidden" id="astatus" name="astatus" />
                <div id="RoleAreaDiv"></div>
                <div id="AppCodeAreaDiv">
                    <div class="form-group">
                        <label class="control-label">AppCode</label>
                        <select data-live-search="true" data-live-search-placeholder="Select AppCode" class="form-control selectpicker" multiple="multiple" id="appcodeselect" title="AppCode">
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="approved"><i class="fa fa-check"></i> Approve</button>
                <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-close"></i> Cancel</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="rejectModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-userid="" data-status="">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header" style="margin-top:2%;margin-bottom:2%;">
                <h2 id="myModalLabel"> Are you sure you want to reject client sign up request?</h2>
                <input type="hidden" id="ruserId" name="ruserId" />
                <input type="hidden" id="rstatus" name="rstatus" />
                <div class="errormsg"></div>
                <hr />
                <button type="button" class="btn btn-primary" id="rejected"><i class="fa fa-check"></i> Yes</button>
                <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-close"></i> No</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">Sign Up Response</h1>

            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script>
        $(document).ready(function () {
            window.clui.dateTimePickerInit();
            FilterData();
        });

        function applyDataTable() {
