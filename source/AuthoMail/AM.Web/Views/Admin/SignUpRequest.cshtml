                    [5, 10, 25, 50, 100, -1],
                    [5, 10, 25, 50, 100, "All"] // change per page values here
                ],
                // set the initial value
                "pageLength": 5,

                "dom": "<'row' <'col-md-12'B>><'row'<'col-md-6 col-sm-12'l><'col-md-6 col-sm-12'f>r><'table-scrollable't><'row'<'col-md-5 col-sm-12'i><'col-md-7 col-sm-12'p>>", // horizobtal scrollable datatable


            });
            //$('.selectpicker').selectpicker('refresh');
            //$('#BatchList').on('change', function () {
            //    var oTable = $('#sample_2').dataTable();
            //    var filterColumn = oTable.api().column(".BatchId").index();
            //    var selected = $(this).find("option:selected").val();
            //    if (!selected) {

            //        oTable.fnFilter('', filterColumn, true);
            //    } else {
            //        oTable.fnFilter("^" + parseInt(selected) + "$", filterColumn, true); //Exact value, column, reg
            //    }
            //});
        }
        function FilterData() {
            $("#signUpHeader").hide();
            $("#signUpRequestList").hide();
            var el = $('#signUpRequestList');
            //var date = $("#date").val();
            //$("#headerdate").html(date + " EST");
            $("#loading").show();
            var el = $('#signUpRequestList');
            // el.html("<div class='alert alert-blue text-center'><span> Loading... </span></div>");
            $.ajax({
                type: "GET",
                url: baseUrl + "Admin/GetSingUpRequestedList",
                //data: JSON.stringify({ date: date, filterBy: $("#filterBy").val(), docType: $("#DocType").val() }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.Success) {
                        if (response.Object != null) {
                            $("#loading").hide();
                            $("#signUpHeader").show();
                            $("#signUpRequestList").show();
                            //console.log(response.Object.model.length);
                            if (response.Object.model.length > 0) {
                                var data = FormatObject(response.Object.model);
                                $("#signUpRequestList").html("");
                                //this.RequestedOnFormatted = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                                BindTemplate(data, "#signUpBody", "#signUpbodyContent", "#signUpTableContent", "#signUpRequestList");
                            }
                            else {
                                $("#signUpRequestList").html(" <div style='margin-bottom:10px;' class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>")
                            }
                        }
                    } else {
                        $("#loading").hide();
                        $("#signUpHeader").show();
                        $("#signUpRequestList").show();
                        $("#signUpRequestList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + response.ErrorMessage + "</span></div>");
                    }


                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("#loading").hide();
                    $("#signUpHeader").show();
                    $("#signUpRequestList").show();
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    $("#signUpRequestList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + msg + "</span></div>");
                }

            });
        }
        function FormatObject(Model) {
            $(Model).each(function () {
                this.RequestedOnFormatted = moment(this.RequestedOn).format("MM/DD/YY HH:mm:ss");
                this.IsConfirmed = this.EmailConfirmed ? '<span  class="label medium label-green">Yes</span>' : '<span class="label medium label-yellow">No</span>';
                this.button = '<a style="cursor: pointer;font-size:1.5em;" onclick="ApproveUser(this)" data-userid="' + this.Id + '" data-status="@AM.Entities.AMUserStatus.Approved"><i class="fa fa-check text-green" aria-hidden="true" title="Approve"></i><span class="sr-only">Approve</span></a><a style="cursor: pointer;font-size:1.5em;" onclick="RejectUserRequest(this)" data-userid="' + this.Id + '" data-status="@AM.Entities.AMUserStatus.Rejected"><i class="padding-left-15 fa fa-times text-red" aria-hidden="true" title="Reject"><span class="sr-only">Reject</span></i></a>';

            });
            return Model;
        }

        function ApproveUser(val) {
            $("#approveModal").find("#auserId").val("");
            $("#approveModal").find("#astatus").val("");
            $("#approveModal").find("#auserId").val($(val).data("userid"));
            $("#approveModal").find("#astatus").val($(val).data("status"));
            BindRole($(val).data("userid"));
            $("#approveModal").modal("show");
        }
        function BindRole(userId) {
            $.ajax({
                type: "GET",
                url: baseUrl + "Admin/GetRoleAndAppCode",
                data: {userId:userId},
                dataType: "json",
                success: function (response) {
                    debugger;
                    $('#RoleAreaDiv').html('');
                    $('#appcodeselect').find('option').remove();
                    if (response.Success) {
                            var roleRadio = '<div class="form-group"> <label class="control-label" style="margin-right:10px">Select Role</label>';
                        $.each(response.Object.roles, function (i, v) {
                            var isChecked = response.Object.isCL ? '' : 'checked';
                            roleRadio += '<input type="radio" ' + isChecked + ' class="radiobtn roleradiocls" name="roleradio" value=' + v + ' />' + ' <label style="margin-right:10px">'+v+'</label>';
                            });
                            roleRadio+='</div>';

                        $('#RoleAreaDiv').html(roleRadio);
                        if (response.Object.isCL) {
                            $('#appcodeselect').append('<option value="all">All</option>');
                            $("#RoleAreaDiv").show();
                        }
                        else {
                            $("#RoleAreaDiv").hide();
                        }

                        var data = response.Object.appCodes;
                        var groupedData = _.groupBy(data, function (d) { return d.GroupAlias });
                        var $select = $('#appcodeselect');

                        $.each(groupedData, function (key, value) {
                            var group = $('<optgroup label="' + key + '" />');
                            $.each(value, function (k, v) {
                                $('<option value="' + v.Id + '" />').html(v.Name).appendTo(group);
                            });
                            group.appendTo($select);
                        });
                        //$.each(response.Object.appCodes, function (i, v) {
                        //    $('#appcodeselect').append('<option value="' + v.Id + '">' + v.NameAppCode+'</option>');
                        //});
                        $('#appcodeselect').selectpicker('refresh');
                        BindRoleEvent();
                    }
                    else {
                        $('#RoleAreaDiv').html('<div class="alert laert-danger text-center"><b>'+response.ErrorMessage+'</b></div>');
                    }
                }
            });
        }
        function BindRoleEvent() {
            $('.radiobtn').unbind('change');
            $('.radiobtn').bind('change', function (e) {
                var role = $(this).val();
                if (role.toLowerCase() == 'client') {
                    $('#AppCodeAreaDiv').show();
                }
                else {
                    $('#AppCodeAreaDiv').hide();
                }
            });
        }
        function RejectUser(val) {
            $("#rejectModal").find("#ruserId").val("");
            $("#rejectModal").find("#rstatus").val("");
            $("#rejectModal").find("#ruserId").val($(val).data("userid"));
            $("#rejectModal").find("#rstatus").val($(val).data("status"));
            $("#rejectModal").modal("show");
        }
        $("#approved").click(function () {
            var role = $("input[name=roleradio]:checked").val();
            var appcode = $('#appcodeselect').val();
            if (role == undefined || role == null || role == "") {
                alertMessage("red", "Please select role.")
                return false;
            }
            //if (appcode == undefined || appcode == null || appcode == "") {
            //    alertMessage("red", "Please select AppCode.");
            //    return false;
            //}
            UpdateUserStatus("approveModal",$("#approveModal").find("#auserId").val(), $("#approveModal").find("#astatus").val(),appcode, role);
        });
        $("#rejected").click(function () {
            //$("#rejectModal").modal("hide");
            UpdateUserStatus("rejectModal",$("#rejectModal").find("#ruserId").val(), $("#rejectModal").find("#rstatus").val(), null, null);
        });

        function UpdateUserStatus(modalid,userId, status,clientIds,role) {
            //console.log(userId+" "+status)
            $("#approved").attr('disabled', 'disabled');
            $("#rejected").attr('disabled', 'disabled');
            var el = $("#" + modalid).find(".errormsg");
            el.html('<div class="alert alert-blue text-center"><b>Please wait...</b></div>');
            $.ajax({
                type: "POST",
                url: baseUrl + "Admin/UpdateUsersRequestSignUp",
                data: JSON.stringify({ userId: userId, status: status, clientIds: clientIds, role: role}),
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (response) {
                    //console.log(response);
                    //Spinners("#pullback", "fa-reply");
                    if (response.Success) {
                        if (response.Object != null) {
                            if (response.Object.Key) {
                                el.html("<div class='alert alert-green'>" + response.Object.Value + "</div>");
                                $("#" + modalid).modal("hide");
                                alertMessage('green', response.Object.Value);
                            }
                            else {
                                el.html("<div class='alert alert-red'>" + response.Object.Value + "</div>");
                            }
                        }
                        FilterData();
                    }
                    else {
                        //console.log(response.ErrorMessage);
                        el.html("<div class='alert alert-red'>" + response.ErrorMessage + "</div>");

                    }
                    $("#approved").removeAttr('disabled');
                    $("#rejected").removeAttr('disabled');
                    //$("#myModal").modal("show");
                },
                error: function (xhr, ajaxOptions, thrownError) {

                    //Spinners(".spinnericon", "faspinner");
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    el.html("<div class='alert alert-red'><span>" + msg + "</span></div>");
                    $("#myModal").modal("show");
                }

            });
        }

        function RejectUserRequest(val) {
             
                var isConfirm = confirm("Are you sure to reject the request?");
                if (isConfirm) {
                    var userId = $(val).data('userid');
                    var status = $(val).data('status');
                    $.ajax({
                        type: "POST",
                        url: baseUrl + "Admin/UpdateUsersRequestSignUp",
                        data: JSON.stringify({userId: userId, status: status, clientIds: null, role: null}),
                        contentType: "application/json; charset=utf-8",
                        dataType: "JSON",
                        success: function (response) {
                            if (response.Success) {
                                alertMessage('green', 'Request has been rejected.');
                                FilterData();
                            }
                            else {
                                alertMessage('red', response.ErrorMessage);
                            }
                        }, error: function (err) {
                            console.log(err);
                        }
                    });
                }
            
        }
        
    </script>
}
