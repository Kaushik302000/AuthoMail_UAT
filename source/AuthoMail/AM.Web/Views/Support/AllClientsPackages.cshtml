@{
    ViewBag.Title = "AllClientsPackages";
    var businessId = Html.Action("GetHeadingForBusinessId", "Common");
}


<style>
    .modal-backdrop.in {
        opacity: .75 !important;
        filter: alpha(opacity=75);
    }

    .bootstrap-select {
        width: 165px !important;
    }

    .popover-content {
        word-wrap: break-word;
        color: red;
    }

    .tooltip-inner {
        /*max-width: 453px !important;*/
        word-wrap: break-word !important;
    }
</style>
<div class="row">
    <div class="col-md-6">
        <div class="panel panel-default ">
            <div class="panel-heading">
                <div class="panel-title">
                    Today's Batch Details
                </div>
            </div>
            <div class="panel-body panel-gray" style="padding:2% 2% 2% 2% !important;" id="todayBody">
                <div id="todayChart"></div>
            </div>

        </div>
    </div>

    <div class="col-md-6">
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <div class="panel-title">Weekly Batch Details</div>
                    </div>
                    <div class="panel-body panel-gray" style="padding:2% 2% 2% 2% !important;">
                        <div id="weeklyChart"></div>

                    </div>
                </div>
            </div>
            <div class="clearfix"></div>

        </div>
    </div>
    <div class="clearfix"></div>


</div>
<div class="clearfix"></div>


<div class="modal fade" id="TodayChartModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg col-md-12" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">Today's Batch Details</h1>
            </div>
            <div class="modal-body" id="TodayChartModalBody">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal -->

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">Pullback Response</h1>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="batchModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg col-md-12" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="batchModalHeader">Batch Details</h1>
            </div>
            <div class="modal-body" id="batchModalModalBody">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="batchMailPieceModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg col-md-12" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="batchMailPieceModalHeader">Batch MailPiece Details</h1>
            </div>
            <div class="modal-body" id="batchMailPieceModalBody">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="WeeklybatchMailPieceModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg col-md-12" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" onclick="showModal()" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="WeeklybatchMailPieceHeader">Batch MailPiece Details</h1>
            </div>
            <div class="modal-body" id="WeeklyChartModalBody">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="showModalESC" onclick="showModal()" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<div id="charDatatable" style="display:none"></div>
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg col-md-12" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h2 id="confirmMsg"> @AM.Services.Config.Web_Msg_PullBackConfirmation</h2>
                <h2 id="mailPieceMsg">MailPiece details of pulled back request</h2>
                <hr />

            </div>
            <div class="modal-body" id="confirmModalBody">

            </div>
            <div class="modal-footer">

                <button type="button" class="btn btn-default" id="yesPullback"><i class="fa fa-check"></i> Yes</button>
                <button type="button" class="btn btn-primary" id="noPullback" data-dismiss="modal"><i class="fa fa-close"></i> No</button>
            </div>
        </div>
    </div>
</div>

