@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js">
    </script>
    <script type="text/javascript">
        $(document).keyup(function (e) {
            if (e.keyCode == 27) { // escape key maps to keycode `27`
                if ($('#WeeklybatchMailPieceModal:visible').length == 1) {

                    $("#showModalESC").click();
                }
            }
        });
        var sumArr = new Array();
        var sumArrDS = new Array();
        Array.prototype.uniquePush = function (item) {
            if (this.indexOf(item) == -1)
                this.push(item);

            this.sort(function (a, b) {
                var a1 = a, b1 = b;
                if (a1 == b1) return 0;
                return a1 > b1 ? 1 : -1;
            });
        };
        var commonmsg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
        function GetChartDataByStatusAndBatchIds(status, ids, clientBatchId, receivedOn) {
            var el = $("#batchMailPieceModal").find('.modal-body');
            el.html("");

            $.ajax({
                type: "POST",
                url: baseUrl + "Support/TodayChartDetails",
                data: JSON.stringify({ status: status, batchId: ids }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.Success) {
                        if (response.Object != null) {
                            if (response.Object.model.length > 0) {
                                var data = FormatObjectToday(response.Object.model);
                                //console.log(data);
                                $("#batchMailPieceModalBody").html("");
                                //this.ReceivedOnFormatted = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                                BindTemplate(data, "#ChartMailPieceBody", "#ChartMailPiecebodyContent", "#ChartMailPieceTableContent", "#batchMailPieceModalBody");
                                if (clientBatchId.length > 31) {
                                    $("#batchMailPieceModalHeader").html("Mailpiece Summary: <button type='button' style='cursor:none !important;' class='btn btn-default normaltext' data-toggle='tooltip' data-placement='bottom' title='" + clientBatchId + "'>Batch Id - " + shortName(clientBatchId) + "</button><button type='button' style='cursor:none !important;margin-left:1%;' class='btn btn-default normaltext'>Received On - " + moment(receivedOn).format("MM/DD/YY HH:mm:ss") + "</button>");

                                } else {
                                    $("#batchMailPieceModalHeader").html("Mailpiece Summary: <button type='button' style='cursor:none !important;' class='btn btn-default normaltext'>Batch Id - " + clientBatchId + "</button><button type='button' style='cursor:none !important;margin-left:1%;' class='btn btn-default normaltext'>Received On - " + moment(receivedOn).format("MM/DD/YY HH:mm:ss") + "</button>");
                                }
                                //$("#batchMailPieceModalHeader").html("Mailpiece Summary: <button type='button' style='cursor:none !important;' class='btn btn-default normaltext'>Batch Id - " + clientBatchId + "</button> <button type='button' style='cursor:none !important;margin-left:1%;' class='btn btn-default normaltext'>Received On - " + receivedOn + "</button>");
                                //, Received On - " + moment(receivedOn).format("MM/DD/YY HH:mm:ss")
                                window.clui.tooltipInit();
                            }
                            else {
                                el.html(" <div class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>")
                            }
                        }
                    }
                    else {
                        el.html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + response.ErrorMessage + "</span></div>");
                    }
                    $("#batchMailPieceModal").modal("show");
                    setModalHeight("batchMailPieceModal");


                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.html("<div class='alert alert-red'><span>" + commonmsg + "</span></div>");
                    $("#batchMailPieceModal").modal("show");
                    setModalHeight("batchMailPieceModal");
                }

            });
        }
        function GetChartDataByStatusAndDate(status, date) {
            var el = $("#batchModal").find('.modal-body');
            $("#batchModalHeader").html("Batch Summary: <button type='button' style='cursor:none !important;' class='btn btn-default normaltext'> Received On - " + moment(date).format("MM/DD/YY") + "</button>");
            $.ajax({
                type: "POST",
                url: baseUrl + "Support/WeeklyChartDetailsChart",
                data: JSON.stringify({ status: status, date: date }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.Success) {
                        if (response.Object != null) {
                            if (response.Object.model.length > 0) {
                                var data = FormatObject(response.Object.model);
                                //console.log(data);
                                $("#batchModalModalBody").html("");
                                //this.ReceivedOnFormatted = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                                BindTemplate(data, "#WeeklyChartBody", "#WeeklyChartbodyContent", "#WeeklyChartTableContent", "#batchModalModalBody");
                                window.clui.tooltipInit();
                            }
                            else {
                                el.html(" <div class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>")
                            }
                        }
                    }
                    else {
                        el.html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + response.ErrorMessage + "</span></div>");
                    }
                    $("#batchModal").modal("show");
                    setModalHeight("batchModal");


                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.html("<div class='alert alert-red'><span>" + commonmsg + "</span></div>");
                    $("#batchModal").modal("show");
                }

            });
        }

        function BindWeeklyChartData() {
            var el = $("#weekluChart");
            $.ajax({
                type: "GET",
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                url: baseUrl + "api/chart/GetAllClientsWeeklyChartData",
                success: function (response) {
                    var chartData = [];
                    //var ticksArr = [];
                    chartData.push(['Date', 'InProgress', 'Failed', 'PulledBack', 'ShippedAll', 'ShippedPartial', 'Dates']);
                    var cnt = 0;
                    var startDate = response[response.length - 1].Date;
                    var endDate = response[0].Date;
                    sumArr = new Array();
                    //console.log(startDate + " " + endDate);
                    for (var i = 1; i <= response.length; i++) {
                        //console.log(moment(response[cnt].Date).format("MM/DD/YYYY") == moment().format("MM/DD/YYYY") + " " + cnt + " " + i);
                        //var day = moment(response[cnt].Date).format("MM/DD/YYYY") == moment().format("MM/DD/YYYY") ? "Today" : moment(response[cnt].Date).format("ddd");
                        var inProgressCount = parseInt(response[cnt].InProgress == 0 ? null : response[cnt].InProgress);
                        var failedCount = parseInt(response[cnt].Failed == 0 ? null : response[cnt].Failed);
                        var pulledBackCount = parseInt(response[cnt].PulledBack == 0 ? null : response[cnt].PulledBack);
                        var shippedAllCount = parseInt(response[cnt].ShippedAll == 0 ? null : response[cnt].ShippedAll);
                        var shippedPartialCount = parseInt(response[cnt].ShippedPartial == 0 ? null : response[cnt].ShippedPartial);

                        chartData.push([response[cnt].Weekday, inProgressCount, failedCount, pulledBackCount, shippedAllCount, shippedPartialCount, moment(response[cnt].Date).format("MM/DD/YYYY hh:mm:ss a")]);
                        sumArr.push(response[cnt].InProgress + response[cnt].Failed + response[cnt].PulledBack + response[cnt].ShippedAll + response[cnt].ShippedPartial);

                        cnt++;
                    }
                    // console.log(chartData);
                    drawChart(chartData, "weeklyChart", 'Batch Details : ' + moment(startDate).format('MM/DD/YYYY') + " - " + moment(endDate).format('MM/DD/YYYY'), 300, 534);

                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.html("<div class='alert alert-red'><span>" + commonmsg + "</span></div>");
                }

            });
        }
        function GetFullChart() {
            var el = $("#TodayChartModalBody");
            $.ajax({
                type: "GET",
                dataType: "JSON",
                url: baseUrl + "api/chart/GetTodayChartData",
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.length == 0) {
                        el.html("<div class='alert alert-yellow'><span>@AM.Services.Config.Web_Msg_NoMailPieceReceivedToday</span></div>");
                        $("#todayBody").css("min-height", "467px");
                        return;
                    }
                    var chartData = [];
                    chartData.push(['BatchName', 'InProgress', 'Error', 'PulledBack', 'Shipped', 'BatchId']);
                    var cnt = 0;
                    for (var i = 1; i <= response.length; i++) {

                        chartData.push([response[cnt].ClientBatchId, response[cnt].InProgress, response[cnt].Error, response[cnt].PulledBack, response[cnt].Shipped, response[cnt].MailBatchId]);
                        cnt++;
                    }
                    //console.log(chartData);
                    $("#TodayChartModal").modal("show");
                    drawChart(chartData, "TodayChartModalBody", 'MailPiece Status', 900, 1400);



                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + commonmsg + "</span></div>");

                }

            });
        }
        function BindTodayChartData() {
            var el = $("#todayChart");
            $.ajax({
                type: "GET",
                dataType: "JSON",
                url: baseUrl + "api/chart/GetAllClientsTodayChartData",
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.length == 0) {
                        el.html("<div class='alert alert-yellow' style='margin-bottom:10px;'><span>@AM.Services.Config.Web_Msg_NoMailPieceReceivedToday</span></div>");
                        $("#todayBody").css("min-height", "488px");
                        return;
                    }
                    var chartData = [];
                    chartData.push(['BatchName', 'InProgress', 'Error', 'PulledBack', 'Shipped', 'BatchId', 'ReceivedOn']);
                    var cnt = 0;
                    //var ticksArr = [];
                    sumArr = new Array();
                    for (var i = 1; i <= response.length; i++) {

                        var inProgressCountBatch = parseInt(response[cnt].InProgress == 0 ? null : response[cnt].InProgress);
                        var errorCountBatch = parseInt(response[cnt].Error == 0 ? null : response[cnt].Error);
                        var pulledBackCountBatch = parseInt(response[cnt].PulledBack == 0 ? null : response[cnt].PulledBack);
                        var shippedCountBatch = parseInt(response[cnt].Shipped == 0 ? null : response[cnt].Shipped);

                        chartData.push([response[cnt].ClientBatchId, inProgressCountBatch, errorCountBatch, pulledBackCountBatch, shippedCountBatch, response[cnt].MailBatchId, moment(response[cnt].ReceivedOn).format("MM/DD/YYYY  HH:mm:ss")]);
                        sumArr.push(response[cnt].InProgress + response[cnt].Error + response[cnt].PulledBack + response[cnt].Shipped);

                        cnt++;
                    }
                    ////console.log(chartData);

                    drawChart(chartData, "todayChart", 'MailPiece Status', 467, 534);



                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + commonmsg + "</span></div>");

                }

            });
        }
        function showModal() {
            $("#batchModal").modal("show");
        }
        function setModalHeight(id) {
            var bodyHeight = $("body").height();
            var count = $("#" + id).find("tr").length;//.find(".modal-body").height();
            ////console.log(bodyHeight + " " + modalHeight);
            if (count > 5) {
                $("#" + id).find(".modal-body").height(bodyHeight - 350);
                $("#" + id).find(".modal-body").css("overflow-y", "scroll");
            }
            else {
                $("#" + id).find(".modal-body").height('auto');

            }

        }

        function GetMailPieceById(batchId, receivedOn, clientBatchId) {
            var el = $("#WeeklybatchMailPieceModal").find(".modal-body");
            $("#WeeklybatchMailPieceHeader").html("");
            if (clientBatchId.length > 31) {
                $("#WeeklybatchMailPieceHeader").html("Mailpiece Summary: <button type='button' style='cursor:none !important;' class='btn btn-default normaltext' data-toggle='tooltip' data-placement='bottom' title='" + clientBatchId + "'>Batch Id - " + shortName(clientBatchId) + "</button><button type='button' style='cursor:none !important;margin-left:1%;' class='btn btn-default normaltext'>Received On - " + moment(receivedOn).format("MM/DD/YY HH:mm:ss") + "</button>");

            } else {
                $("#WeeklybatchMailPieceHeader").html("Mailpiece Summary: <button type='button' style='cursor:none !important;' class='btn btn-default normaltext'>Batch Id - " + clientBatchId + "</button><button type='button' style='cursor:none !important;margin-left:1%;' class='btn btn-default normaltext'>Received On - " + moment(receivedOn).format("MM/DD/YY HH:mm:ss") + "</button>");
            }
            $.ajax({
                type: "POST",
                url: baseUrl + "Support/GetMailPieceByBatchIdChart",
                data: JSON.stringify({ batchId: batchId }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.Success) {
                        if (response.Object != null) {
                            if (response.Object.model.length > 0) {
                                var data = FormatObjectToday(response.Object.model);
                                //console.log(data);
                                $("#WeeklyChartModalBody").html("");
                                //this.ReceivedOnFormatted = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                                BindTemplate(data, "#WeeklyChartMailPieceBody", "#WeeklyChartMailPiecebodyContent", "#WeeklyChartMailPieceTableContent", "#WeeklyChartModalBody");

                                window.clui.tooltipInit();
                                //, Received On - " + moment(receivedOn).format("MM/DD/YY HH:mm:ss")

                            }
                            else {
                                el.html(" <div class='alert alert-yellow' style='margin-bottom:10px;'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>")
                            }
                        }
                    }
                    else {
                        el.html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + response.ErrorMessage + "</span></div>");
                    }
                    $("#batchModal").modal("hide");
                    $("#WeeklybatchMailPieceModal").modal("show");
                    setModalHeight("WeeklybatchMailPieceModal");


                },
                error: function (xhr, ajaxOptions, thrownError) {
                    el.html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + commonmsg + "</span></div>");
                    $("#batchModal").modal("hide");
                    $("#WeeklybatchMailPieceModal").modal("show");
                }

            });
        }


        google.charts.load('current', { packages: ['corechart'] });
        function drawChart(chartData, div, title, height, width) {
            var data = google.visualization.arrayToDataTable(chartData);
            var view = new google.visualization.DataView(data);
            var colors = [];
            var series;
            var hTitle = "Mailpieces";
            var vTitle = "Batch Names";
            if (div == "weeklyChart") {
                view.setColumns([0, 1, 2, 3, 4, 5]);
                series = {
                    0: { color: '#069' },
                    1: { color: '#e03c31' },
                    2: { color: '#e7ab08' },
                    3: { color: '#539536' },
                    4: { color: '#f63' }
                };
                hTitle = "Batches";
                vTitle = "";//"Week Days";
            }
            else {
                view.setColumns([0, 1, 2, 3, 4]);
                //colors = ['#069', '#e03c31', '#e7ab08', '#539536'];
                series = {
                    0: { color: '#069' },
                    1: { color: '#e03c31' },
                    2: { color: '#e7ab08' },
                    3: { color: '#539536' }
                };
            }
            var ticksArr = new Array();
            if (sumArr.length > 0) {
                var maxSum = Math.max.apply(Math, sumArr);
                if (maxSum < 5) {
                    ticksArr = new Array();
                    for (var i = 0; i <= maxSum; i++) {
                        ticksArr[i] = i;
                    }
                }
                else {
                    ticksArr = null;
                }
            }

            var options = {
                title: title,
                isStacked: true,
                'height': height,
                'width': width,

                hAxis: {
                    minValue: 0,
                    ticks: ticksArr,
                    format: 0,
                    title: hTitle,
                    textStyle: {
                        fontSize: 12,
                        bold: true,
                        //color: '#848484'
                    },
                    titleTextStyle: {
                        fontSize: 12,
                        bold: true,
                        //color: '#848484'
                    }
                },
                vAxis: {
                    title: vTitle,

                    titleTextStyle: {
                        fontSize: 12,
                        bold: true,

                    }
                },
                legend: { position: 'top', maxLines: 3 },
                series: series

            };

            // Instantiate and draw the chart.
            var chart = new google.visualization.BarChart(document.getElementById(div));

            google.visualization.events.addListener(chart, 'select', selectHandler);
            chart.draw(view, options);

            function selectHandler() {
                var selectedItem = chart.getSelection()[0];
                if (selectedItem) {
                    var status = data.getColumnLabel(selectedItem.column);
                    if (selectedItem.row != null) {
                        if (div == "todayChart") {
                            var batchId = parseInt(data.getValue(selectedItem.row, 5));
                            var clientBatchId = data.getValue(selectedItem.row, 0);
                            if (batchId != 0) {
                                var receivedOn = data.getValue(selectedItem.row, 6);
                                GetChartDataByStatusAndBatchIds(status, batchId, clientBatchId, receivedOn);
                            }
                        }
                        if (div == "weeklyChart") {
                            var dates = data.getValue(selectedItem.row, 6);
                            GetChartDataByStatusAndDate(status, moment(dates).format("MM/DD/YYYY"));
                        }
                    }

                }
            }
        }
