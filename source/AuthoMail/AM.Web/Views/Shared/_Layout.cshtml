        function ClientSelectEvent() {

            $('#clientselect').unbind('change');
            $('#clientselect').bind('change', function (e) {
                var clientId = $(this).val();
                 if (clientId!="") {
                $.ajax({
                    type: "POST",
                    url: baseUrl + "Common/RefreshDataByClientId",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({ clientId: parseInt(clientId) }),
                    success: function (response) {
                        if (response.Success) {
                            //console.log(response.Object)
                            window.location = baseUrl + "Home/Index";
                        }
                        else {
                            //window.clui.globalAlert({
                            //    message: response.ErrorMessage,
                            //    alertType: 'red',
                            //    timeout: 5000
                            //});
                        }

                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        window.clui.globalAlert({
                            message: "@AM.Services.Config.Web_Msg_Ajax_CommonError",
                            alertType: 'red',
                            timeout: 5000
                        });
                    }

                });
            }
            else
            {
                window.clui.globalAlert({
                    message: "Select client.",
                    alertType: 'red',
                    timeout: 5000
                });
            }
            });



        }
        function GetClientMenu() {

            $('#clientmenu').unbind('click');
            $('#clientmenu').bind('click', function (e) {
            $('#clientmodal').modal('show');
            $.ajax({
                type: "GET",
                url: baseUrl + "Common/GetClientMenu",
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response.Success) {
                        if (response.Object != null) {
                            $("#clientselect").empty();
                            var data = response.Object;
                            var groupedData = _.groupBy(data, function (d) { return d.GroupAlias });
                            var $select = $('#clientselect');
                            $.each(groupedData, function (key, value) {
                                var group = $('<optgroup label="' + key + '" />');
                                $.each(value, function (k,v) {
                                    console.log(value,key)
                                    var sel = $("#ClientName").text() == v.Name ? "selected" : "";
                                    $('<option ' + sel + ' value="' + v.Id +'" />').html(v.Name).appendTo(group);
                                });
                               group.appendTo($select);
                            });
                            $("#clientselect").selectpicker();
                            ClientSelectEvent();
                        }
                    }

                },
                error: function (xhr, ajaxOptions, thrownError) {
                    window.clui.globalAlert({
                        message: "@AM.Services.Config.Web_Msg_Ajax_CommonError",
                        alertType: 'red',
                        timeout: 5000
                    });
                }

            });
            });
        }
        function GetClientNameById() {
            $("#ClientName").text("");
            $.ajax({
                type: "GET",
                url: baseUrl + "Common/GetClientNameById",
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    $("#ClientName").text(response);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("#ClientName").text("");
                }

            });
        }
        function Spinners(selector, className) {
            if ($(selector).find("i").hasClass("fa-circle-o-notch fa-spin")) {
                $(selector).find("i").removeClass("fa-circle-o-notch fa-spin");
                $(selector).find("i").addClass(className);
            }
            else {
                $(selector).find("i").removeClass(className);
                $(selector).find("i").addClass("fa-circle-o-notch fa-spin");
            }
        }
        if (!String.prototype.supplant) {
            String.prototype.supplant = function (o) {
                return this.replace(/{([^{}]*)}/g,
                    function (a, b) {
                        var lst = b.split('.');
                        $obj = o;
                        for (var i = 0; i < (lst.length) ; i++) {
                            var r = $obj[lst[i]];
                            if (r === null || typeof r === "undefined") return "--";
                            if (typeof r === 'object') {
                                $obj = r;
                            }
                            else {
                                return typeof r === 'string' || typeof r === 'number' ? r : a;
                            }
                        }
                    }
                );
            };
        }
