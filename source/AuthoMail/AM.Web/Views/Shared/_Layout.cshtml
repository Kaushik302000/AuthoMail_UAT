                <div class="modal-header">
                    <h1 id="myModalLabel">Please choose client</h1>
                </div>
                <div class="modal-body">
                    <select class="form-control" data-live-search="true" data-live-search-placeholder="Search Client" id="clientselect"></select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
