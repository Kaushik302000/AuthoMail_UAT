            if ($('#clientmenu').length != 0) {
                GetClientMenu();
            }
            jQuery.validator.addMethod("lettersonly", function(value, element) {
                return this.optional(element) || /^[A-z\s]+$/i.test(value);
            }, "Letters only please");
            jQuery.validator.addMethod("domainonly", function(value, element) {
                return this.optional(element) || /^(([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9\-]*[a-zA-Z0-9])\.)*([A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9\-]*[A-Za-z0-9])$/i.test(value);
            }, "Please enter valid domain name.");
            jQuery.validator.addMethod("password",function(value,element){
                return this.optional(element) || /^(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,20}$/i.test(value);
            },"Passwords are 8-20 characters with uppercase letters, lowercase letters and at least one number.");
            jQuery.validator.addMethod("doctypecode",function(value,element){
                //console.log(!(/^[-]+[\s]+$/i.test(value)));
                return this.optional(element) || !(/[-\s]+/i.test(value));
            },"space and dash not allow.");

            var GetAMStatus=function()
            {
                if($('#AMStatusNotification').length!=0)
                {
                    //$.connection.hub.logging = true;
                    var amh = $.connection.aMAlertHub;
                    amh.client.getAMDetailStatus = function (response) {
                        //console.log("res:"+JSON.stringify(response));
                        if (response != null)
                        {
                            var color=response.AlertLevel=="Critical"?"red":response.AlertLevel=="Warning"?"yellow":"white";
                            var pulse=response.IsAMDelay?"blink":"";
                            $('#AMStatusNotification').html('<a href="/AuthoMailHealth/37f9ac3e-40b3-4ae8-ac9a-d84634638065" style="color:'+color+';" class="'+pulse+'"><i class="fa fa-heartbeat fa-2" style="margin:5px;"></i></a>');
                        }
                    };
                    $.connection.hub.start().done(function () {
                        amh.server.getConnection($.connection.hub.id);
                    });
                    $.connection.hub.error(function(error) {
                        console.log('communication error: ' + error);
                    });
                    $.connection.aMAlertHub.client.exceptionHandler = function (error) {
                        console.log('Server Error: ' + error);
                    };
                }
                if($('#InventoryNotificationSpan').length!=0)
                {
                    $('#InventoryNotificationSpan').html();
                    '<a href="#" title="Inventory"><i class="fa fa-hourglass" style="color:white"></i><i class="fa fa-hourglass-half" style="color:yellow"></i><i class="fa fa-hourglass-end" style="color:red"></i></a>'
                }
            }
            GetAMStatus();

            //var AMHealth=function(){
            //    $.ajax({
