@using AM.Entities;
@using Microsoft.AspNet.Identity;
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
    {
        @Html.AntiForgeryToken()
        <ul class="nav navbar-nav navbar-right">
            @*<li>
                    @Html.ActionLink("Hello " + User.Identity.GetUserName() + "!", "Index", "Manage", routeValues: null, htmlAttributes: new { title = "Manage" })
                </li>
                <li><a href="javascript:document.getElementById('logoutForm').submit()">Log off</a></li>*@
            <li class="dropdown">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">@string.Join(string.Empty, User.Identity.DisplayName().Take(20)) <span class="caret"></span></a>
                <ul class="dropdown-menu">
                    <li>@Html.ActionLink("Change Password", "ChangePassword", "Manage")</li>
                    @if (User.IsInRole(AMRoles.Admin))
                    {
                        <li>@Html.ActionLink("AMUsers", "AMUsers", "Account")</li>
                    }
                    <li title="Last Login Time (EST)" style="background-color:#eee;"><a class="disabled" id="LastLoginLi">Last Login(UTC): @User.Identity.LastLoginTime().ToString("MM/dd/yy hh:mm:ss tt")</a></li>
                    <li><a href="javascript:document.getElementById('logoutForm').submit()">Log off</a></li>
                </ul>
            </li>
        </ul>

        <script src="~/Scripts/jquery-1.10.2.js"></script>
        <script src="~/Scripts/notify.js"></script>
        <!--Reference the SignalR library. -->
        <script src="~/Scripts/jquery.signalR-2.3.0.min.js"></script>
        <!--Reference the autogenerated SignalR hub script. -->
        <script src="~/signalr/hubs"></script>
        <!--SignalR script to update the chat page and send messages.-->
        <script type="text/javascript">
            var NotifyMessageVM = function (TotalErrors, HasNotify, HasErrors, Message) {
                this.TotalErrors = TotalErrors;
                this.HasNotify = HasNotify;
                this.HasErrors = HasErrors;
                this.Message = Message;
            }
            $(document).ready(function () {
                var LastLogin = function () {
                    $.ajax({
                        type: "GET",
                        url: baseUrl + "Account/GetLastLoginDate",
                        data: { timezoneoffset: new Date().getTimezoneOffset() },
                        dataType: "json",
                        success: function (response) {
                            $('#LastLoginLi').html("Last Login(Local): " + response);
                        }
                    });
                };

                var NotificationHub = function () {
                    var userId = '@User.Identity.GetUserId()';

                    var amhub = $.connection.aMErrorNotificationHub;

                    amhub.client.getAMErrors = function (response) {
                        InventoryAlert(response.stocklevel);
                        FilterData(response.errorsData);
                    };
                    $.connection.hub.start().done(function () {
                        amhub.server.initialConnection($.connection.hub.id);
                    });
                    $.connection.hub.error(function (error) {
                        console.log('communication error: ' + error);
                    });
                    $.connection.aMAlertHub.client.exceptionHandler = function (error) {
                        console.log('Server Error: ' + error);
                    };
                }
                var FilterData = function (response) {
                    //if (response == null || response == "") return false;
                    var notifyObj = FilterAndStorage(response);
                        //console.log(notifyObj);
                    if (notifyObj.HasErrors) {
                        $('#ErrorNotificationSpan').html('<a href="'+baseUrl+'Report/ErrorsReport" title="Errors"><i class="fa fa-exclamation-triangle" style="color:red;"></i></a>');
                        if (notifyObj.HasNotify)
                            notify(notifyObj.Message);
                    }
                    else {
                        $('#ErrorNotificationSpan').html("");
                        //$('#ErrorNotificationSpan').html('<a href="'+baseUrl+'Report/ErrorsReport" title="Errors"><i class="fa fa-exclamation-triangle" style="color:white;"></i></a>');
                    }
                }
                NotificationHub();
                LastLogin();
            });
            var notify = function (body) {

                function onShowNotification() {
                    console.log('notification is shown!');
                }

                function onCloseNotification() {
                    console.log('notification is closed!');
                }

                function onClickNotification() {
                    window.location.replace(baseUrl + "Report/ErrorsReport");
                }

                function onErrorNotification() {
                    console.error('Error showing notification. You may need to request permission.');
                }

                function onPermissionGranted() {
                    console.log('Permission has been granted by the user');
                    doNotification();
                }

                function onPermissionDenied() {
                    console.warn('Permission has been denied by the user');
                }

                function doNotification() {
                    var myNotification = new Notify("AuthoMail Validation Alert", {
                        body: body,
                        tag: "AMError",
                        silent: false,
                        dir: "ltr",
                        //sound:"",
                        icon: baseUrl + "clui/images/corelogic.png",
                        //notifyShow: onShowNotification,
                        //notifyClose: onCloseNotification,
                        notifyClick: onClickNotification,
                        //notifyError: onErrorNotification,
                        //timeout: 10
                    });

                    myNotification.show();
                }

                if (!Notify.needsPermission) {
                    doNotification();
                } else if (Notify.isSupported()) {
                    Notify.requestPermission(onPermissionGranted, onPermissionDenied);
                }
            }

            var FilterAndStorage = function (data) {
                var clientId = '@User.Identity.GetClientId()';
                var isAdmin = '@User.IsInRole(AMRoles.Admin)';
                if (typeof (Storage) !== "undefined") {
                    var lastErrorsIds = localStorage.getItem("LastErrorsIds");
                    var IdsArr = new Array();
                    var totalErrors = 0;
                    var hasError = false;
                    var msg = "";
                    for (var i = 0; i < data.length; i++) {
                        if (isAdmin == "True") {
                            IdsArr.push(data[i].Id);
                            totalErrors += data[i].ErrorMPsCount;
                        }
                        else {
                            if (clientId == data[i].ClientId) {
                                IdsArr.push(data[i].Id);
                                totalErrors++;
                            }
                        }
                    }
                        //totalErrors += (isAdmin || clientId == data[i].ClientId) ? data[i].ErrorMPsCount : 0;
                        hasError = totalErrors != 0;
                        //if (hasError) msg = "Total " + totalErrors + " new errors has been found.";

                    if (hasError) {

                        // msg = "Total " + totalErrors + " new errors has been found.";
                        if (totalErrors > 1) {
                            msg = totalErrors + " new errors.";
                        }
                        else {
                            msg = totalErrors + " new error.";
                        }
                        
                        if (lastErrorsIds == undefined || lastErrorsIds == null || lastErrorsIds == "") {
                            localStorage.setItem("LastErrorsIds", IdsArr);
                            return new NotifyMessageVM(totalErrors, true, hasError, msg);
                        }
                        else {
                            var oldData = GetFromSessionStorage();
                            if (oldData == IdsArr) {
                                return new NotifyMessageVM(totalErrors, false, hasError, msg);
                            }
                            else {
                                localStorage.setItem("LastErrorsIds", IdsArr);
                                return new NotifyMessageVM(totalErrors, true, hasError, msg);
                            }
                        }
                    }
                    else {
                        localStorage.setItem("LastErrorsIds", IdsArr);
                        return new NotifyMessageVM(totalErrors, false, hasError, msg);
                    }
                } else {
                    console.log("Sorry! No Web Storage support.");
                }
            }
            var GetFromSessionStorage = function () {
                return localStorage.getItem("LastErrorsIds");
            }
            var InventoryAlert = function (stocklevel) {
                if ($('#InventoryNotificationSpan').length > 0) {
                    console.log(stocklevel);
                    var color = stocklevel == 0 ? "white" : stocklevel == 1 ? "yellow" : "red";
                    $('#InventoryNotificationSpan').html('<a href="'+baseUrl+'Admin/ManageEnvelopes" title="Envelope Inventory"><i class="fa fa-envelope-open" style="color:'+color+';margin:5px;"></i></a>');
                }
            }
        </script>
    }
}
