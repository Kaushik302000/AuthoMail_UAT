@section Scripts{
    @Styles.Render("~/bundles/datatablescss")
    @Scripts.Render("~/bundles/datatables")

    <script type="text/javascript">
        $(document).ready(function () {
            //window.clui.dateTimePickerInit();
            var dateTemplate = '<div class="daterangepicker dropdown-menu">' + '<div class="calendar left">' + '<div class="calendar-table"></div>' + '</div>' + '<div class="calendar right">' + '<div class="calendar-table"></div>' + '</div>' + '<div class="ranges">' + '<div class="range_inputs">' + '<button class="applyBtn" disabled="disabled" type="button"></button> ' + '<button class="cancelBtn" type="button"></button>' + '</div>' + '</div>' + '</div>';
            $("#receivedOn").daterangepicker({
                autoApply: true,
                template: dateTemplate,
                showCustomRangeLabel: false,
                autoUpdateInput: false
            });

            $('#receivedOn').on('apply.daterangepicker', function (ev, picker) {
                $(this).val(picker.startDate.format('MM/DD/YYYY') + ' - ' + picker.endDate.format('MM/DD/YYYY'));
            });

            FilterData();
            $('#searchform').validate({ // initialize the plugin
                errorElement: "span",
                rules: {
                    BatchId: {
                        number: true,
                        min: 1,
                        maxlength: 8
                    },
                    MailPieceId: {
                        number: true,
                        min: 1,
                        maxlength: 8
                    }
                }
            });
            // JSON.useDateParser(false);
        });

        function ViewDetails(obj) {
            //alert("call");
            var mailPieceId = $(obj).data("mailpieceid");
            //console.log(mailPieceId);
            $("#databind").html("");
            $("#ViewInfo").modal("show");
            $("#loadingModal").show();
            $.ajax({
                type: "GET",
                url: baseUrl + "Home/GetMailPieceByUniqueId",
                data: {
                    mailPieceId: mailPieceId
                },
                //contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.Success) {
                        if (response.Object != null) {
                            if (response.Object.model != null) {
                                $("#loadingModal").hide();
                                var data = FormatMailPieceObject(response.Object.model);
                                var bodyHtml = $("#templatemodal").html();
                                $("#databind").html("");
                                bodyHtml = bodyHtml.supplant(data);
                                $("#databind").html(bodyHtml);
                                $('[data-toggle="popover"]').popover({
                                    'trigger': 'hover',
                                    'placement': 'auto left',
                                    'container': 'body'
                                });
                                window.clui.tooltipInit();
                            }
                            else {
                                $("#loadingModal").hide();
                                $("#databind").html("");
                                $("#showerror").show();
                                $("#showerror").html(" <div style='margin-bottom:10px;' class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>");

                            }
                        }
                    } else {
                        $("#loadingModal").hide();
                        $("#databind").html("");
                        $("#showerror").show();
                        $("#searchMailPieceList").show();
                        $("#showerror").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + response.ErrorMessage + "</span></div>");
                        // $("#ViewInfo").modal("show");
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("#showerror").show();
                    $("#loadingModal").hide();
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    $("#showerror").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + msg + "</span></div>");
                    $("#ViewInfo").modal("show");
                }

            });
        }
        function shortName(str) {
            //console.log(str);
            if (typeof str != 'undefined' && str != null && str != "")
                return str.length > 31 ? str.substring(0, 31) + '...' : str;
        }
        function MakeYesNoLabel(isbool) {
            var val = (isbool == true || isbool == 1) ? '<span  class="label medium label-yellow">Yes</span>' : '<span class="label medium label-success">No</span>';
            return val;
        }
        function FormatMailPieceObject(Model) {
            console.log(Model);
            $(Model).each(function () {
                this.ReceivedOnFormatted = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.IsPrinted = MakeYesNoLabel(this.IsPrinted);
                this.IsShipped = MakeYesNoLabel(this.IsShipped);
                this.IsQCRequested = MakeYesNoLabel(this.IsQCRequested);
                this.IsQCPerformed = MakeYesNoLabel(this.IsQCPerformed);
                this.IsPullBackRequested = MakeYesNoLabel(this.IsPullBackRequested);
                this.IsPulledBack = MakeYesNoLabel(this.IsPulledBack);
                this.IsRcptInfoSpecified = MakeYesNoLabel(this.IsRcptInfoSpecified);
                this.SLADays = parseInt(this.SLADays / 86400);
                this.ShortBatchName = shortName(this.BatchName);
                this.ShortFileName = shortName(this.FileName);
                this.ShortPrintFileName = shortName(this.PrintFileName);
                //this.ShippedOnFormatted = this.ShippedOn == null ? "--" : moment(this.ShippedOn).format("MM/DD/YY HH:mm:ss");

                this.PickedUpOnFormatted = this.PickedUpOn == null ? "--" : moment(this.PickedUpOn).format("MM/DD/YY HH:mm:ss");
                //this.PrintedOnFormatted = this.PrintedOn == null ? "--" : moment(this.PrintedOn).format("MM/DD/YY HH:mm:ss");
                this.DueDateFormatted = this.DueDate == null ? "--" : moment(this.DueDate).format("MM/DD/YY HH:mm:ss");
                this.PulledBackOnFormatted = this.PulledBackOn == null ? "--" : moment(this.PulledBackOn).format("MM/DD/YY HH:mm:ss");
                this.ShipmentStatusUpdatedOnFormatted = this.ShipmentStatusUpdatedOn == null ? "--" : moment(this.ShipmentStatusUpdatedOn).format("MM/DD/YY HH:mm:ss");
                this.RcptName = this.RcptName == null || this.RcptName == "" ? "--" : this.RcptName.trim();
                var cityStateZip = this.RcptAddressCity + " " + this.RcptAddressState + " " + this.RcptAddressZIP;
                this.RcptAddress = this.RcptAddress == null || this.RcptAddress.trim() == "" ? "--" : this.RcptAddress.trim() + (cityStateZip != "" ? ", " + cityStateZip : "");
                this.RcptCountry = this.Country == null || this.Country.trim() == "" ? "--" : this.Country.trim();

                var returnCityStateZip = this.RetRcptAddressCity + " " + this.RetRcptAddressState + " " + this.RetRcptAddressZIP;
                this.RetRcptName = this.RetRcptName == null || this.RetRcptName.trim() == "" ? "--" : this.RetRcptName.replace(/null/g, "").trim();
                this.RetRcptAddress = this.RetRcptAddress == null || this.RetRcptAddress.trim() == "" ? "--" : this.RetRcptAddress.replace(/null/g, "").trim() + (returnCityStateZip != "" ? ", " + returnCityStateZip : "");

                var shippedOnDate = "";
                var esignedOnDate = "";
                if (this.ShippedOn == null || this.ShippingStatus == 'eSigned') {
                    shippedOnDate = "--";
                }
                else {
                    shippedOnDate = moment(this.ShippedOn).format("MM/DD/YY HH:mm:ss");
                    esignedOnDate = "--";
                }

                if (this.ShippingStatus == 'eSigned') {
                    esignedOnDate = moment(this.ShippedOn).format("MM/DD/YY HH:mm:ss");
                }
                else {
                    esignedOnDate = "--";
                }

                this.ShippedOnFormatted = shippedOnDate;
                this.PrintedOnFormatted = shippedOnDate;
                this.EsignedOnFormatted = esignedOnDate;


                switch (this.ShippingStatus) {

                    case "PulledBack":
                        status = '<span class="label medium label-yellow">' + this.ShippingStatus + '</span>';
                        break;
                    case "Error":
                        status = '<span class="label medium label-red">' + this.ShippingStatus + '</span>';
                        break;
                    case "Shipped":
                        status = '<span class="label medium label-success">' + this.ShippingStatus + '</span>';
                        break;
                    case "InProgress":
                        status = '<span class="label medium label-blue">' + this.ShippingStatus + '</span>';
                        break;
                    case "eDelivered":
                        status = '<span class="label medium label-Edelivery">' + this.ShippingStatus + '</span>';
                        break;
                    case "eSigned":
                        status = '<span class="label medium label-Esign">' + this.ShippingStatus + '</span>';
                        break;
                }
                this.ShippingStatus = status;

                this.IsEDeliveryRequestedFormatted = this.IsEDeliveryRequested && !this.IsESignRequested ? '<span class="label medium label-success">E-Delivery</span>' : this.IsEDeliveryRequested && this.IsESignRequested ? '<span class="label medium label-success">E-Sign</span>' : '<span class="label medium label-blue">P&S</span>';



                var trackingNo = "";
                if (this.TrackingNo == null || this.TrackingNo == "") {
                    trackingNo = "--";
                }
                else {
                    trackingNo = '<a id="' + this.TrackingNo + '" style="width:185px;" class="btn btn-transparent-blue btn-sm" href="/track/' + this.TrackingNo + '" target="_blank"><i class="fa faspinner"></i> ' + this.TrackingNo + '</a>';
                }
                this.TrackingNoFormatted = trackingNo;

                var eSignTracking = "";
                if (this.ExpiryDate == null || this.ExpiryDate == "") {
                    eSignTracking = "--";

                }
                else {
                    eSignTracking = '<a id="' + this.MailBatchId + '" style="width:185px;" class="btn btn-transparent-blue btn-sm" href="/track?id=' + this.MailBatchId + '&IsEdelivery=true" target="_blank"><i class="fa faspinner"></i> ' + this.MailBatchId + '</a>';
                }
                this.ESignTrackingFormatted = eSignTracking;

                var eddDesc = '<span id="popoverError" data-toggle="popover" data-original-title="Error Code: <ErrorCode>" data-html="true" data-content="<dataContent>" data-placement="left"><a> <ErrorCode> </a></span>'.replace(/<ErrorCode>/g, this.ErrorCode).replace("<dataContent>", this.ErrorDesc == null ? "--" : this.ErrorDesc);
                this.ErrorDescPopover = this.ErrorCode == "No_Error" ? '<span>' + this.ErrorCode + '</span>' : eddDesc;
            });
            //console.log(Model);
            return Model;
        }
        function FormatObject(Model) {
            //console.log(Model);
            $(Model).each(function () {
                this.ReceivedOnFormatted = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.PickedUpOnFormatted = this.PickedUpOn == null ? "--" : moment(this.PickedUpOn).format("MM/DD/YY HH:mm:ss");
                this.DueDateFormatted = this.DueDate == null ? "--" : moment(this.DueDate).format("MM/DD/YY HH:mm:ss");
                this.RcptNameFormatted = (this.FirstName==null || this.FirstName=="" ? "--" : this.FirstName) + " " +(this.LastName==null || this.LastName=="" ? "" : this.LastName);
                this.CityFormatted =(this.City==null || this.City=="" ? "--" : this.City) + " " + (this.State==null || this.State==""?"":this.State) + " " + (this.ZIP==null || this.ZIP=="" ?"":this.ZIP);
                var status = "";
                this.View = (this.LoanNumber != null ? '<a class="viewdetails" style="cursor:pointer" onclick="ViewDetails(this)" data-mailpieceid="' + this.UniqueId + '">' + this.LoanNumber + '</a>' : "--");
                this.ErrorDesc = this.ErrorDesc != null ? this.ErrorDesc.replace(/"/g, '\'') : "";
                switch (this.Status) {

                    case "PulledBack":
                        status = '<span class="label medium label-yellow">' + this.Status + '</span>';
                        break;
                    case "Error":
                        status = '<span class="label medium label-red" data-toggle="popover" data-original-title="Error Code: ' + this.ErrorCode + '" data-html="true" data-content="' + this.ErrorDesc + '" data-placement="left">' + this.Status + '</span>';
                        break;
                    case "Shipped":
                        status = '<span class="label medium label-success">' + this.Status + '</span>';
                        break;
                    case "InProgress":
                        status = '<span class="label medium label-blue">' + this.Status + '</span>';
                        break;
                    case "eDelivered":
                        status = '<span class="label medium label-Edelivery">' + this.Status + '</span>';
                        break;
                    case "eSigned":
                        status = '<span class="label medium label-Esign">' + this.Status + '</span>';
                        break;
                }
                this.ShippingStatusFormatted = status;

                var shippedOnDate = "";
                var esignedOnDate = "";
                if (this.ShippedOn == null || this.Status == 'eSigned') {
                    shippedOnDate = "--";
                }
                else {
                    shippedOnDate = moment(this.ShippedOn).format("MM/DD/YY HH:mm:ss");
                    esignedOnDate = "--";
                }

                if (this.Status == 'eSigned') {
                    esignedOnDate = moment(this.ShippedOn).format("MM/DD/YY HH:mm:ss");
                }
                else {
                    esignedOnDate = "--";
                }

                this.ShippedOnFormatted = shippedOnDate;
                this.EsignedOnFormatted = esignedOnDate;

                var trackingNo = "";
                if ((this.TrackingNo == null || this.TrackingNo == "") && this.IsEDeliveryRequested == true && this.IsESignRequested == false && this.ShippingStatus != "Error") {
                    trackingNo = '<a id="' + this.MailBatchId + '" style="width:185px;" class="btn btn-transparent-blue btn-sm" href="/track?id=' + this.MailBatchId + '&IsEdelivery=true" target="_blank"><i class="fa faspinner"></i> E-Delivery</a>';
                }
                else if ((this.TrackingNo == null || this.TrackingNo == "") && this.IsEDeliveryRequested == true && this.IsESignRequested == true && this.ShippingStatus != "Error")
                {
                    trackingNo = '<a id="' + this.MailBatchId + '" style="width:185px;" class="btn btn-transparent-blue btn-sm" href="/track?id=' + this.MailBatchId + '&IsEdelivery=true" target="_blank"><i class="fa faspinner"></i> E-Sign</a>';
                }
                else if (this.TrackingNo == null || this.TrackingNo == "") {
                    trackingNo = "--";
                }
                else {
                    trackingNo = '<a id="' + this.TrackingNo + '" data-toggle="tooltip" data-container="body" data-placement="top" title="' + this.TrackingNo + '" class="btn btn-transparent-blue btn-sm" href="/track/' + this.TrackingNo + '" target="_blank"><i style="margin-top: 2px;" class="fa fa-map-marker fa-2x"></i> </a>';
                }
                this.TrackingNoFormatted = trackingNo;

                if (this.IsEDeliveryEnabled) {
                    $('.cl_eSignRequest').show();
                }
                else {
                    $('.cl_eSignRequest').hide();
                }
                this.IsESignRequestedFormatted = this.ExpiryDate == null ? '<span class="label medium label-red">False</span>' : '<span class="label medium label-success">True</span>';

                this.IsEDeliveryRequestedFormatted = this.IsEDeliveryRequested && !this.IsESignRequested ? '<span class="label medium label-success">E-Delivery</span>' : this.IsEDeliveryRequested && this.IsESignRequested ? '<span class="label medium label-success">E-Sign</span>' : '<span class="label medium label-blue">P&S</span>';

                this.FileFormatted = this.IsWithinRetentionPeriod && this.RequestedPdf != null ? '<a href="' + baseUrl + 'Common/DownloadPdf?uniqueId=' + this.UniqueId + '"  style="cursor: pointer;font-size:1.2em;margin-right:10%;" class="btn btn-transparent-red btn-sm" data-filename="' + this.RequestedPdf + '" ><i class=" fa fa-file-pdf-o"></i> </a>' : '--';
                

            });
            return Model;
    }
        function applyDataTable() {
