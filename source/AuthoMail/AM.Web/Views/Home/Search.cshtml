@{
    ViewBag.Title = "Search";
}

<link href="~/clui/dist/css/datatablecustom.css" rel="stylesheet" />
<style>
    .col-md-1, .col-md-2, .col-md-3 {
        padding-left: 10px !important;
        padding-right: 10px !important;
    }

    #businessIddiv .bootstrap-select {
        width: 165px !important;
    }

    .popover-content {
        word-wrap: break-word;
        color: red;
    }

    .tooltip-inner {
        /*max-width: 453px !important;*/
        word-wrap: break-word !important;
    }

    .show-calendar {
        width: 484px !important;
    }

    hr {
        margin-top: 20px;
        margin-bottom: 4px;
    }

    .margin-bottom-2 {
        margin-bottom: 2px !important;
    }

    .label.label-Edelivery {
        background-color: #20c997;
    }

    .label.label-Esign {
        background-color: #6f42c1;
    }
</style>
<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" id="headingOne">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseThree">
                <div class="panel-title">

                    <i class="fa fa-search"></i> Search
                    <div class="collapsed-icon pull-right">
                        <i class="fa fa-caret-left"></i>
                    </div>
                    <div class="expanded-icon pull-right">
                        <i class="fa fa-caret-down"></i>
                    </div>

                </div>
            </a>

        </div>
        <div id="collapseThree" class="panel-collapse collapse in">
            <div class="panel-body">
                <form action="#" id="searchform">
                    <div class="row">
                        <div class="col-md-@(ViewBag.BusinessId.Count > 1?"4":"3")" id="businessIddiv">
                            @if (ViewBag.BusinessId.Count == 1)
                            {
                                <label for="BusinessFriendlyIdValue">@ViewBag.BusinessId[0]</label>
                                <div class="input-group">
                                    <i class="fa fa-search left-icon"></i>
                                    <input class="form-control" name="BusinessFriendlyIdValue" value="@ViewBag.BusinessFriendlyIdValue" placeholder="@ViewBag.BusinessId[0]" id="BusinessFriendlyIdValue">
                                    <input type="hidden" value="@ViewBag.BusinessId[0]" name="BusinessFriendlyIdName" id="BusinessFriendlyIdName" />
                                </div>
                                <div class="text-red pull-left" style="display:none" id="BusinessFriendlyIdValueError">This field is required.</div>
                            }
                            else if (ViewBag.BusinessId.Count > 1)
                            {
                                <label for="BusinessFriendlyIdName">Select Business ID</label>
                                <div class="input-group">

                                    <select id="BusinessFriendlyIdName" class="selectpicker" data-live-search="true" data-live-search-placeholder="Search Business ID">
                                        <option value="">Select BusinessId</option>
                                        @foreach (var item in ViewBag.BusinessId)
                                        {
                                            <option value="@item.ToString()">@item.ToString()</option>
                                        }
                                    </select>
                                    <input class="form-control" name="BusinessFriendlyIdValue" placeholder="" id="BusinessFriendlyIdValue">

                                </div>
                            }
                            else
                            {
                                <br />
                                <div class='alert alert-yellow'><div>No business friendly id found!</div></div>
                            }
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="DocType">Document Type</label>
                                @Html.DropDownList("DocType", ViewBag.DocType as SelectList, htmlAttributes: new { @class = "selectpicker", @multiple = "multiple", @data_live_search = "true", @data_live_search_placeholder = "Search Document Type" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="Status">Status</label>
                                <select class="selectpicker" id="Status" data-live-search="true" data-live-search-placeholder="Search Status">
                                    <option value="">
                                        Select Status
                                    </option>
                                    <option value="InProgress">In Progress</option>
                                    <option value="PulledBack">Pulledback</option>
                                    <option value="Error">Error</option>
                                    <option value="Shipped">Shipped</option>
                                    <option value="eDelivered">E-Delivered</option>
                                    <option value="eSigned">E-Signed</option>
                                </select>
                            </div>

                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="Channel">Channel</label>
                                @Html.Action("_Channel", "Common")
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="receivedOn">Received  On (EST)</label>
                                <div class="input-group " id="datepicker4">
                                    <input type="text" class="form-control" autocomplete="off" placeholder="Select Date" id="receivedOn">
                                    <span class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </span>
                                </div>
                            </div>

                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="TrackingNumber">Tracking Number</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" name="TrackingNumber" placeholder="Tracking Number" id="TrackingNumber">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="ErrorCode">Error Code</label>
                                <select class="selectpicker" id="ErrorCode" multiple="multiple">
                                    <option value="Invalid_XML_File">Invalid_XML_File</option>
                                    <option value="Missing_PDF_File">Missing_PDF_File</option>
                                    <option value="Invalid_PackageType">Invalid_PackageType</option>
                                    <option value="Mailing_Address_Missing_Or_Invalid">Mailing_Address_Missing_Or_Invalid</option>
                                    <option value="Recipient_Details_Missing_Or_Invalid">Recipient_Details_Missing_Or_Invalid</option>
                                    <option value="Unknown_Error">Unknown_Error</option>
                                    <option value="Invalid_PackageType">Invalid_PackageType</option>
                                    <option value="Invalid_ShippingDetail">Invalid_ShippingDetail</option>
                                    <option value="Invalid_DuplicateKey">Invalid_DuplicateKey</option>
                                    <option value="Mailing_Address_Missing_Or_Invalid">Mailing_Address_Missing_Or_Invalid</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="MailPieceUniqueId">MailPiece Unique Id</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" name="MailPieceUniqueId" placeholder="Mail Piece Unique Id" id="MailPieceUniqueId">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        @if (User.IsInRole(AM.Entities.AMRoles.Admin) || User.IsInRole(AM.Entities.AMRoles.BA) || User.IsInRole(AM.Entities.AMRoles.BAOffShore))
                        {
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="BatchId">Client Batch Id</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" name="ClientBatchId" placeholder="Client Batch Id" id="ClientBatchId">
                                    </div>
                                </div>
                            </div>
                            <div class=" col-md-1" style="width:10%">
                                <div class="form-group">
                                    <label for="BatchName">Batch Id</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control batchidnumber" name="BatchId" placeholder="Batch Id" id="BatchId">
                                    </div>
                                </div>
                            </div>
                            <div class=" col-md-1" style="width:10%">
                                <div class="form-group">
                                    <label for="MailPiece">MailPiece Id</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" name="MailPieceId" placeholder="MailPiece Id" id="MailPieceId">
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input class="form-control" value="" type="hidden" name="ClientBatchId" id="ClientBatchId">
                            <input class="form-control" value="" name="BatchId" type="hidden" id="BatchId">
                            <input class="form-control" value="" name="MailPieceId" type="hidden" id="MailPieceId">
                        }
                    </div>
                    <div class="row">
                        <div class="col-md-1">
                            <div class="form-group " style="padding-top:27px;">
                                <label for="filterData">  &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</label>
                                <button type="button" id="filterData" class="btn btn-primary" title="Search">
                                    <span class="sr-only">Filter</span>
                                    <i class="fa fa-search"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-1" style="margin-left: -2%;">
                            <div class="form-group " style="padding-top:27px;">
                                <label for="filterData"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</label>
                                <button type="button" id="downloadFilter" title="Download Search Output" class="btn btn-primary">
                                    <i class="fa fa-download"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-1" style="margin-left: -2%;">
                            <div class="form-group " style="padding-top:27px;">
                                <label for="filterData"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</label>
                                <button type="button" id="resetFilter" title="Reset" class="btn btn-transparent-blue">
                                    <i class="fa fa-undo"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>

</div>
<div class="panel panel-default">
    <div class='alert alert-blue text-center' id="loading" style="display:none"><span> Loading... </span></div>
    <div class="panel-heading" id="searchHeader">
        <div class="panel-title">
            Search Details : <span class="normaltext" id="headerdate"></span>

        </div>
    </div>
    <div class="panel-body" id="searchMailPieceList" style="margin-top:20px;"></div>
</div>
<!--Search table html template code -->
<div id="SearchTableContent" style="display:none">
    <table class="table table-responsive" style="overflow-x:scroll">
        <thead>
            <tr>
                @if (!User.IsInRole(AM.Entities.AMRoles.BAOffShore))
                {
                    <th>File</th>

                }
                <th>@Html.Action("GetHeadingForBusinessId", "Common")</th>
                <th>Status</th>
                @if (!User.IsInRole(AM.Entities.AMRoles.BAOffShore))
                {
                    <th>Borrower Name</th>
                    <th>Street</th>
                    <th>City/State/Zip</th>
                }
                <th class="TrackingNoHide">Tracking Number</th>
                <th class="TrackingNo">Tracking Number</th>
                <th>Received <span class="fontcapitalize">(Local)</span></th>
                <th>Due <span class="fontcapitalize">(Local)</span></th>
                <th>Shipped <span class="fontcapitalize">(Local)</span></th>
                <th>Esigned <span class="fontcapitalize">(Local)</span></th>
                <th>PickedUp <span class="fontcapitalize">(Local)</span></th>
                <th>Shipment Status</th>
                <th>Document Type</th>
                <th class="cl_eSignRequest">IsEsignRequested</th>
                <th>Delivery Type</th>
                <th>Channel</th>
                <th>Impression Count</th>
                <th>Shipping Method<span class="fa fa-question-circle" title="Shipping Carrier / Service type"></span></th>
                <th class="ErrorCode">Error Code</th>
                <th class="ErrorText">Error Text</th>
            </tr>
        </thead>
        <tbody id="SearchbodyContent"></tbody>
    </table>
</div>
<div style="display:none">
    <table>
        <tbody id="SearchBody">
            <tr class="row-small">
                @if (!User.IsInRole(AM.Entities.AMRoles.BAOffShore))
                {
                    <td><span>{FileFormatted}</span></td>

                }
                <td data-businessidvalue="{LoanNumber}"><span>{View}</span></td>
                <td><span>{ShippingStatusFormatted}</span></td>
                @if (!User.IsInRole(AM.Entities.AMRoles.BAOffShore))
                {
                    <td><span>{RcptNameFormatted}</span></td>
                    <td><span>{RcptAddress}</span></td>
                    <td><span>{CityFormatted}</span></td>
                }
                <td><span>{TrackingNo}</span></td>
                <td><span>{TrackingNoFormatted}</span></td>
                <td><span>{ReceivedOnFormatted}</span></td>
                <td><span>{DueDateFormatted}</span></td>
                <td><span>{ShippedOnFormatted}</span></td>
                <td><span>{EsignedOnFormatted}</span></td>
                <td><span>{PickedUpOnFormatted}</span></td>
                <td><span>{ShipmentStatus}</span></td>
                <td><span>{DocType}</span></td>
                <td class="cl_eSignRequest"><span>{IsESignRequestedFormatted}</span></td>
                <td><span>{IsEDeliveryRequestedFormatted}</span></td>
                <td><span>{Channel}</span></td>
                <td><span>{ImpressionCount}</span></td>
                <td>{ShippingCarrierOrMethod}</td>
                <td>{ErrorCode}</td>
                <td>{ErrorDesc}</td>
            </tr>
        </tbody>
    </table>
</div>
<!-- end table template code -->
<!-- Modal -->
<div class="modal fade" id="TrackingInfo" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg col-md-10" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">Tracking Details</h1>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
                @*<button type="button" class="btn btn-primary">View All</button>*@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ViewInfo" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg col-md-12" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="modal-header">
                <h1 id="myModalLabel">MailPiece Details</h1>
                <hr />
            </div>
            <div class="modal-body">
                <div id="showerror" style="display:none"></div>
                <div class='alert alert-blue text-center' id="loadingModal" style="display:none"><span> Loading... </span></div>
                <div class="row" id="databind">

                </div>
            </div>
            <div class="modal-footer">
                <hr />
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>

            </div>
        </div>
    </div>
</div>

