        function FilterData() {
            $("#searchHeader").hide();
            $("#searchMailPieceList").hide();
            var el = $('#searchMailPieceList');
            var startDate = "";
            var endDate = "";
            if ($("#receivedOn").val() != "") {
                var selectedData = $("#receivedOn").val().split('-');
                startDate = moment(selectedData[0].trim()).format("MM/DD/YY");
                endDate = moment(selectedData[1].trim()).format("MM/DD/YY");
                //console.log(selectedData)
                $("#headerdate").html(startDate + " to " + endDate + " EST");
            } else {
                $("#receivedOn").val("");
                $("#headerdate").empty();
                startDate = "";
                endDate = "";
            }
            $("#loading").show();
            //$("#headerdate").html(startDate + " to " + endDate + " EST");

            $.ajax({
                type: "POST",
                url: baseUrl + "Home/_GetSearchData",
                data: JSON.stringify({
                    BusinessFriendlyIdName: $("#BusinessFriendlyIdName").val(),
                    BusinessFriendlyIdValue: $("#BusinessFriendlyIdValue").val(),
                    MailPieceUniqueId: $("#MailPieceUniqueId").val(),
                    DocType: $("#DocType").val(),
                    Status: $("#Status").val(),
                    Channel: $("#Channel").val(),
                    receivedOnStart: startDate,
                    receivedOnEnd: endDate,
                    trackingNumber: $("#TrackingNumber").val(),
                    clientBatchId: $("#ClientBatchId").val(),
                    batchId: $("#BatchId").val(),
                    mailPieceId:$("#MailPieceId").val(),
                    errorCode: $("#ErrorCode").val()
                }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    // //console.log(response);
                    if (response.Success) {
                        $("#loading").hide();
                        $("#searchHeader").show();
                        $("#searchMailPieceList").show();
                        if (response.Object != null) {
                            //console.log(response.Object.model);
                            if (response.Object.model.Key <= '@(AM.Services.Config.Web_Search_DisplayLimit)') {
                                if (response.Object.model.Value.length > 0) {
                                    $("#searchMailPieceList").html("");
                                    var data = FormatObject(response.Object.model.Value);
                                    $.each(data, function (index, value) {
                                        if (value.ShippingCarrier == "E-Delivery") {
                                            value.ShippingCarrierOrMethod = value.ShippingCarrier;
                                        }
                                        else {
                                            value.ShippingCarrierOrMethod = value.ShippingCarrier+" / "+ value.ShippingMethod;
                                        }
                                    });
                                    BindTemplate(data, "#SearchBody", "#SearchbodyContent", "#SearchTableContent", "#searchMailPieceList");
                                    window.clui.tooltipInit();
                                    $("#downloadFilter").removeAttr("disabled");
                                }
                                else {
                                    $("#searchMailPieceList").html(" <div style='margin-bottom:10px;' class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>");
                                }
                            } else if (response.Object.model.Key > '@(AM.Services.Config.Web_Search_DisplayLimit)' && response.Object.model.Key <= '@(AM.Services.Config.Web_Search_DownloadLimit)') {
                                $("#searchMailPieceList").html(" <div style='margin-bottom:10px;' class='alert alert-blue'><span class='sbold'>Your query is returning " + response.Object.model.Key + " records which is more than the display limit of '@(AM.Services.Config.Web_Search_DisplayLimit)' records. You may click on <span  title='Download'  style='width: 4%;padding-left: 15px;pointer-events: none;' class='btn btn-primary btn-sm'><i class='fa fa-download'></i></span> to download results.</span></div>");
                                $("#downloadFilter").removeAttr("disabled");
                            } else {
                                $("#downloadFilter").attr("disabled", true);
                                $("#searchMailPieceList").html(" <div style='margin-bottom:10px;' class='alert alert-blue'><span class='sbold'>Your query is returning " + response.Object.model.Key + " records which is more than the display limit of '@(AM.Services.Config.Web_Search_DisplayLimit)' and download limit of '@(AM.Services.Config.Web_Search_DownloadLimit)'. Please use more filters or fine tune your query.</span></div>");
                            }

                        }
                    } else {
                        $("#loading").hide();
                        $("#searchHeader").show();
                        $("#searchMailPieceList").show();
                        $("#searchMailPieceList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + response.ErrorMessage + "</span></div>");
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("#loading").hide();
                    $("#searchHeader").show();
                    $("#searchMailPieceList").show();
                    var msg = '@AM.Services.Config.Web_Msg_Ajax_CommonError';
                    $("#searchMailPieceList").html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + msg + "</span></div>");
                }

            });
        }

        $("#filterData").click(function () {
            if ($("#BatchId").val().trim() != "") {
                if ($("#searchform").valid()) {
                    FilterData();
                }
                else {
                    return false;
                }

            }
            else {
                FilterData();

            }
        });
        $("#resetFilter").click(function () {
            $("#Status").val("");
            $("#DocType").val("");
            $("#Channel").val("");
            $("#BusinessFriendlyIdValue").val("");
            $("#ClientBatchId").val("");
            $("#BatchId").val("");
            $("#MailPieceId").val("");
            $("#TrackingNumber").val("");
            $("#ErrorCode").val("");
            $('.selectpicker').selectpicker('refresh');
            $("#receivedOn").val("");
        });
        $("#downloadFilter").click(function () {
            var startDate = "";
            var endDate = "";
            if ($("#receivedOn").val() != "") {
                var selectedData = $("#receivedOn").val().split('-');
                startDate = moment(selectedData[0].trim()).format("MM/DD/YY");
                endDate = moment(selectedData[1].trim()).format("MM/DD/YY");
            } else {
                $("#receivedOn").val("");
                startDate = "";
                endDate = "";
            }

            $.ajax({
                type: "POST",
                url: baseUrl + "Home/_DownloadSearchData",
                data: JSON.stringify({
                    BusinessFriendlyIdName: $("#BusinessFriendlyIdName").val(),
                    BusinessFriendlyIdValue: $("#BusinessFriendlyIdValue").val(),
                    DocType: $("#DocType").val(),
                    Status: $("#Status").val(),
                    Channel: $("#Channel").val(),
                    receivedOnStart: startDate,
                    receivedOnEnd: endDate,
                    trackingNumber: $("#TrackingNumber").val(),
                    clientBatchId: $("#ClientBatchId").val(),
                    batchId: $("#BatchId").val(),
                    mailPieceId: $("#MailPieceId").val(),
                    errorCode: $("#ErrorCode").val(),
                    timezoneOffset: new Date().getTimezoneOffset(),
                    clientName: $("#ClientName").text().trim()
                }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.Success) {
                        if (response.Object != null) {
                              const fileName = encodeURIComponent(response.Object.model.FileName);
                              window.location = baseUrl + 'Home/DownloadSearch?fileGuid=' + response.Object.model.FileGuid
                            + '&filename=' + fileName;
                        }
                        else {
                            window.clui.globalAlert({
                                message: "@AM.Services.Config.Web_Msg_NoRecordFound",
                                alertType: 'red',
                                timeout: 5000
                            });
                        }
                    } else {

                        if (isNaN(response.ErrorMessage)) {
                            window.clui.globalAlert({
                                message: response.ErrorMessage,
                                alertType: 'red',
                                timeout: 5000
                            });
                        }
                        else {
                            var key = parseInt(response.ErrorMessage);
                            if (key <= 0) {
                                $("#searchMailPieceList").html(" <div style='margin-bottom:10px;' class='alert alert-yellow'><span class='sbold'>@AM.Services.Config.Web_Msg_NoRecordFound</span></div>");
                            }
                            else if (key > '@(AM.Services.Config.Web_Search_DisplayLimit)' && key <= '@(AM.Services.Config.Web_Search_DownloadLimit)') {
                                $("#searchMailPieceList").html(" <div style='margin-bottom:10px;' class='alert alert-blue'><span class='sbold'>Your query is returning " + key + " records which is more than the display limit of '@(AM.Services.Config.Web_Search_DisplayLimit)' records. You may click on <span  title='Download'  style='width: 4%;padding-left: 15px;pointer-events: none;' class='btn btn-primary btn-sm'><i class='fa fa-download'></i></span> to download results.</span></div>");
                            }
                            else {
                                $("#searchMailPieceList").html(" <div style='margin-bottom:10px;' class='alert alert-blue'><span class='sbold'>Your query is returning " + key + " records which is more than the display limit of '@(AM.Services.Config.Web_Search_DisplayLimit)' and download limit of '@(AM.Services.Config.Web_Search_DownloadLimit)'. Please use more filters or fine tune your query.</span></div>");
                            }
                        }
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    window.clui.globalAlert({
                        message: "@AM.Services.Config.Web_Msg_Ajax_CommonError",
                        alertType: 'red',
                        timeout: 5000
                    });

                }

            });
        });
    </script>
}


