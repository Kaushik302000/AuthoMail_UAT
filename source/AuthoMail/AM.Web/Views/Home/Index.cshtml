        });

        function DailySummaryChartFunction() {
            $.ajax({
                type: "GET",
                url: baseUrl + "api/chart/DailySummaryChart",
                contentType: "application/json; charset=utf-8",
                success: function (response) {

                    if (response.length == 0) {
                        $('#DailySummaryByDocType').html("<div class='alert alert-yellow' style='margin-bottom:10px;'><span>@AM.Services.Config.Web_Msg_NoMailPieceReceivedToday</span></div>");
                        $('#DailySummaryByDocType').parent().css("min-height", "488px");
                        return;
                    }
                    var chartData = [];
                    chartData.push(['DocTypeCode', 'InProgress', 'Error', 'PulledBack', 'Shipped','eDelivered', 'eSigned']);
                    var cnt = 0;
                    //var ticksArr = [];
                    sumArrDS = new Array();
                    for (var i = 1; i <= response.length; i++) {

                        var inProgressCountBatch = parseInt(response[cnt].InProgress == 0 ? null : response[cnt].InProgress);
                        var errorCountBatch = parseInt(response[cnt].Error == 0 ? null : response[cnt].Error);
                        var pulledBackCountBatch = parseInt(response[cnt].PulledBack == 0 ? null : response[cnt].PulledBack);
                        var shippedCountBatch = parseInt(response[cnt].Shipped == 0 ? null : response[cnt].Shipped);
                        var eDeliveredCountBatch = parseInt(response[cnt].eDelivered == 0 ? null : response[cnt].eDelivered);
                        var eSignedCountBatch = parseInt(response[cnt].eSigned == 0 ? null : response[cnt].eSigned);

                        chartData.push([response[cnt].DocTypeCode, inProgressCountBatch, errorCountBatch, pulledBackCountBatch, shippedCountBatch, eDeliveredCountBatch, eSignedCountBatch]);
                        sumArrDS.push(response[cnt].InProgress + response[cnt].Error + response[cnt].PulledBack + response[cnt].Shipped, response[cnt].eDelivered, response[cnt].eSigned);

                        cnt++;
                    }

                    drawDailySummaryChart(chartData, "DailySummaryByDocType", 'MailPiece Status', 467, 620);
                }, error: function (err) {
                    $('#DailySummaryByDocType').html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + commonmsg + "</span></div>");
                }
            });
        }
        function drawDailySummaryChart(chartData, div, title, height, width) {
            var data = google.visualization.arrayToDataTable(chartData);
            var view = new google.visualization.DataView(data);
            var colors = [];
            var series;
            var hTitle = "Mailpieces";
            var vTitle = "Doc Types";
            view.setColumns([0, 1, 2, 3, 4, 5, 6]);
            //colors = ['#069', '#e03c31', '#e7ab08', '#539536'];
            series = {
                0: { color: '#069' },
                1: { color: '#e03c31' },
                2: { color: '#e7ab08' },
                3: { color: '#539536' },
                4: { color: '#20c997' },
                5: { color: '#6f42c1'}
            };
            var ticksArr = new Array();
            if (sumArr.length > 0) {
                var maxSum = Math.max.apply(Math, sumArrDS);
                if (maxSum < 6) {
                    ticksArr = new Array();
                    for (var i = 0; i <= maxSum; i++) {
                        ticksArr[i] = i;
                    }
                }
                else {
                    ticksArr = null;
                }
            }

            var options = {
                title: title,
                isStacked: true,
                'height': height,
                //'width': width,

                hAxis: {
                    minValue: 0,
                    ticks: ticksArr,
                    format: 0,
                    title: hTitle,
                    textStyle: {
                        fontSize: 12,
                        bold: true,
                        //color: '#848484'
                    },
                    titleTextStyle: {
                        fontSize: 12,
                        bold: true,
                        //color: '#848484'
                    }
                },
                vAxis: {
                    title: vTitle,

                    titleTextStyle: {
                        fontSize: 12,
                        bold: true,

                    }
                },
                legend: { position: 'top', maxLines: 3 },
                series: series

            };

            // Instantiate and draw the chart.
            var chart = new google.visualization.BarChart(document.getElementById(div));

            google.visualization.events.addListener(chart, 'select', selectHandler);
            chart.draw(view, options);

            function selectHandler() {
                var selectedItem = chart.getSelection()[0];
                if (selectedItem) {
                    var status = data.getColumnLabel(selectedItem.column);
                    if (selectedItem.row != null) {
                        var docTypeCode = data.getValue(selectedItem.row, 0);
                        // console.log(status);
                        //console.log(docTypeCode);
                        GetChartDataByStatusAndDocTypeCode(status, docTypeCode);
                    }

                }
            }
        }
        google.charts.setOnLoadCallback(DailySummaryChartFunction);
    </script>
}
