                    var el = $("#myModal").find('.modal-body');
                    el.html("<div class='alert alert-red'><span>" + commonmsg + "</span></div>");
                    $("#myModal").modal("show");
                }

            });
            $("#BusinessFriendlyIdNameError").hide();
            $("#BusinessFriendlyIdValueError").hide();
        }
        function FormatObjectToday(Model) {
            $(Model).each(function () {
                var requestedPullback = this.IsPullBackRequested ? '<span class="label medium label-yellow">Yes</span>' : '<span class="label medium label-success">No</span>';
                var status = "";
                this.ErrorDesc = this.ErrorDesc != null ? this.ErrorDesc.replace(/"/g, '\'') : "";
                switch (this.Status) {

                    case "PulledBack":
                        status = '<span class="label medium label-yellow">' + this.Status + '</span>';
                        break;
                    case "Error":
                        status = '<span class="label medium label-red" data-toggle="popover" data-original-title="Error : ' + this.ErrorCode + '" data-html="true" data-content="' + this.ErrorDesc + '" data-placement="left">' + this.Status + '</span>';
                        break;
                    case "Shipped":
                        status = '<span class="label medium label-success">' + this.Status + '</span>';
                        break;
                    case "InProgress":
                        status = '<span class="label medium label-blue">' + this.Status + '</span>';
                        break;
                    case "eDelivered":
                        status = '<span class="label medium label-Edelivery">' + this.Status + '</span>';
                        break;
                    case "eSigned":
                        status = '<span class="label medium label-Esign">' + this.Status + '</span>';
                        break;
                }
                // \''+this.TrackingNo+'\',\''+this.ShippingMethod+'\'
                this.MailPieceReceivedOn = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                //this.ReceivedOnFormatted = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.DueDateFormatted = this.DueDate == null ? "--" : moment(this.DueDate).format("MM/DD/YY HH:mm:ss");
                this.ErrorDescPopover = this.ErrorDesc == null ? "--" : '<span id="popoverError" data-toggle="popover" data-original-title="Error" data-html="true" data-content="' + this.ErrorDesc + '" data-placement="left"><a>Error Details</a></span>';
                this.ShippingStatusFormatted = status;
                this.FileNameFormatted = shortName(this.FileName);
                //this.RcptNameFormatted = this.RcptFirstName + " " + this.RcptLastName;

                this.IsPullBackRequestedFormatted = requestedPullback;
                this.IsEDeliveryRequested = this.IsEDeliveryRequested && !this.IsESignRequested ? '<span class="label medium label-success">E-Delivery</span>' : this.IsEDeliveryRequested && this.IsESignRequested ? '<span class="label medium label-success">E-Sign</span>' : '<span class="label medium label-blue">P&S</span>';
            });
            return Model;
            //console.log(Model);
        }
        function shortName(str) {
            //console.log(str);
            if (typeof str != 'undefined' && str != null && str != "")
                return str.length > 31 ? str.substring(0, 31) + '...' : str;
        }
        function FormatObject(Model) {
            //console.log(Model);
            $(Model).each(function () {
                var requestedPullback = this.IsPullBackRequested ? '<span class="label medium label-yellow">Yes</span>' : '<span class="label medium label-success">No</span>';
                var status = "";
                this.BatchNameFormatted = shortName(this.BatchName);
                this.ClientBatchIdFormatted = shortName(this.ClientBatchId);
                this.ErrorDesc = this.ErrorDesc != null ? this.ErrorDesc.replace(/"/g, '\'') : "";
                this.FileNameFormatted = shortName(this.FileName);
                switch (this.Status) {

                    case "PulledBack":
                        status = '<span class="label medium label-yellow">' + this.Status + '</span>';

                        break;
                    case "Error":
                        status = '<span class="label medium label-red" data-toggle="popover" data-original-title="Error Code: ' + this.ErrorCode + '" data-html="true" data-content="' + this.ErrorDesc + '" data-placement="left">' + this.Status + '</span>';
                        break;
                    case "Shipped":
                        status = '<span class="label medium label-success">' + this.Status + '</span>';
                        break;
                    case "InProgress":
                        status = '<span class="label medium label-blue">' + this.Status + '</span>';
                        break;
                    case "eDelivered":
                        status = '<span class="label medium label-Edelivery">' + this.Status + '</span>';
                        break;
                    case "eSigned":
                        status = '<span class="label medium label-Esign">' + this.Status + '</span>';
                        break;
                }
                // \''+this.TrackingNo+'\',\''+this.ShippingMethod+'\'
                //this.MailPieceReceivedOn = moment(this.MailBatches.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.ReceivedOnFormatted = moment(this.ReceivedOn).format("MM/DD/YY HH:mm:ss");
                this.DueDateFormatted = this.DueDate == null ? "--" : moment(this.DueDate).format("MM/DD/YY HH:mm:ss");
                this.ErrorDescPopover = this.ErrorDesc == null ? "--" : '<span id="popoverError" data-toggle="popover" data-original-title="Error" data-html="true" data-content="' + this.ErrorDesc + '" data-placement="left"><a>Error Details</a></span>';
                this.ShippingStatusFormatted = status;
                //this.RcptNameFormatted = this.RcptFirstName + " " + this.RcptLastName;
