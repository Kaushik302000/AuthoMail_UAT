        function drawChart(chartData, div, title, height, width) {
            var data = google.visualization.arrayToDataTable(chartData);
            var view = new google.visualization.DataView(data);
            var colors = [];
            var series;
            var hTitle = "Mailpieces";
            var vTitle = "Batch Names";
            if (div == "weeklyChart") {
                view.setColumns([0, 1, 2, 3, 4, 5, 6, 7]);
                series = {
                    0: { color: '#069' },
                    1: { color: '#e03c31' },
                    2: { color: '#e7ab08' },
                    3: { color: '#539536' },
                    4: { color: '#f63' },
                    5: { color: '#20c997' },
                    6: { color: '#6f42c1' }
                };
                hTitle = "Batches";
                vTitle = "";//"Week Days";
            }
            else {
                view.setColumns([0, 1, 2, 3, 4, 5, 6]);
                //colors = ['#069', '#e03c31', '#e7ab08', '#539536'];
                series = {
                    0: { color: '#069' },
                    1: { color: '#e03c31' },
                    2: { color: '#e7ab08' },
                    3: { color: '#539536' },
                    4: { color: '#20c997' },
                    5: { color: '#6f42c1'}
                };
            }
            var ticksArr = new Array();
            if (sumArr.length > 0) {
                var maxSum = Math.max.apply(Math, sumArr);
                if (maxSum < 6) {
                    ticksArr = new Array();
                    for (var i = 0; i <= maxSum; i++) {
                        ticksArr[i] = i;
                    }
                }
                else {
                    ticksArr = null;
                }
            }

            var options = {
                title: title,
                isStacked: true,
                'height': height,
                //'width': width,

                hAxis: {
                    minValue: 0,
                    ticks: ticksArr,
                    format: 0,
                    title: hTitle,
                    textStyle: {
                        fontSize: 12,
                        bold: true,
                        //color: '#848484'
                    },
                    titleTextStyle: {
                        fontSize: 12,
                        bold: true,
                        //color: '#848484'
                    }
                },
                vAxis: {
                    title: vTitle,

                    titleTextStyle: {
                        fontSize: 12,
                        bold: true,

                    }
                },
                legend: { position: 'top', maxLines: 3 },
                series: series

            };

            // Instantiate and draw the chart.
            var chart = new google.visualization.BarChart(document.getElementById(div));

            google.visualization.events.addListener(chart, 'select', selectHandler);
            chart.draw(view, options);

            function selectHandler() {
                var selectedItem = chart.getSelection()[0];
                if (selectedItem) {
                    var status = data.getColumnLabel(selectedItem.column);
                    if (selectedItem.row != null) {
                        if (div == "todayChart") {
                            var batchId = parseInt(data.getValue(selectedItem.row, 5));
                            var clientBatchId = data.getValue(selectedItem.row, 0);
                            if (batchId != 0) {
                                var receivedOn = data.getValue(selectedItem.row, 6);
                                GetChartDataByStatusAndBatchIds(status, batchId, clientBatchId, receivedOn);
                            }
                        }
                        if (div == "weeklyChart") {
                            var dates = data.getValue(selectedItem.row, 8);
                            console.log(data);
                            GetChartDataByStatusAndDate(status, moment(dates).format("MM/DD/YYYY"));
                        }
                    }

                }
            }
        }
        google.charts.setOnLoadCallback(BindWeeklyChartData);
        google.charts.setOnLoadCallback(BindTodayChartData);

