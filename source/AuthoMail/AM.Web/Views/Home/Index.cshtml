        function RequestPullback() {
            if ($("#BusinessFriendlyIdName").val() == "") {
                $("#BusinessFriendlyIdNameError").show();
                return;
            }

            if ($("#BusinessFriendlyIdValue").val() == "") {
                $("#BusinessFriendlyIdValueError").show();
                return;
            }
            else {
                $("#BusinessFriendlyIdValueError").hide();
            }


            $.ajax({
                type: "POST",
                url: baseUrl + "Home/GetMailPieceIdByLoanNumber",
                data: JSON.stringify({ BusinessFriendlyIdName: $("#BusinessFriendlyIdName").val().trim(), BusinessFriendlyIdValue: $("#BusinessFriendlyIdValue").val().trim() }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    //console.log(response);
                    if (response.Success) {
                        if (response.Object != null) {
                            if (response.Object == "PullBack") {
                                window.location = baseUrl + 'RequestPullBack/PullBack?BusinessFriendlyIdName=' + $("#BusinessFriendlyIdName").val() + '&BusinessFriendlyIdValue=' + $("#BusinessFriendlyIdValue").val();
                                return;
                            } else if (response.Object == "AdvancePullBack") {
                                var el = $("#myModal").find('.modal-body');
                                var htmlstr = "<div class='alert alert-red'><span>@AM.Services.Config.Web_Msg_NoRecordFound</span></h1></div>";
                                htmlstr += '<br><blockquote class=""><p><u><i class="fa fa-search"></i> @Html.ActionLink("Advance Search", "PullBack", "RequestPullBack") </u></p></blockquote>';
                                el.html(htmlstr);

                                $("#myModal").modal("show");
                                return;
                            } else if (response.Object.model.length == 1) {
                                var data = FormatObject(response.Object.model);
                                //console.log(data[0].IsPullBackRequested);
                                $("#confirmModalBody").html("");
                                BindTemplate(data, "#pullbackBody", "#pullbackbodyContent", "#pullbackTableContent", "#confirmModalBody");
                                //var IsPullbackRequested = $("#sample_2").find(".ispullbackr").text().trim();
                                switch (data[0].Status) {

                                    case "PulledBack":
                                    case "Error":
                                    case "Shipped":
                                        $("#yesPullback").hide();
                                        $("#noPullback").html("Close");
                                        $("#confirmMsg").hide();
                                        $("#noPullback").removeClass("btn-primary");
                                        $("#noPullback").addClass("btn-primary");
                                        break;
                                    case "InProgress":
                                        if (data[0].IsPullBackRequested == 1) {
                                            $("#confirmMsg").hide();
                                            $("#yesPullback").hide();
                                            $("#noPullback").html("Close");
                                            $("#noPullback").removeClass("btn-primary");
                                            $("#noPullback").addClass("btn-primary");
                                        }
                                        else {
                                            $("#confirmMsg").show();
                                            $("#yesPullback").show();
                                            $("#noPullback").html("<i class='fa fa-close'></i> No");
                                            $("#noPullback").removeClass("btn-default");
                                            $("#noPullback").addClass("btn-primary");
                                        }
                                        //$("#yesPullback").show();
                                        //$("#noPullback").html("<i class='fa fa-close'></i> No");
                                        //$("#noPullback").removeClass("btn-primary");
                                        //$("#noPullback").addClass("btn-default");
                                        break;
                                }
                                $("#confirmModal").modal("show");
                                window.clui.tooltipInit();
                                return;
                            }
                            else {
                                var el = $("#myModal").find('.modal-body');
                                el.html("<div class='alert alert-yellow' ><span>@AM.Services.Config.Web_Msg_NoRecordInTodayAndPendingBatches</span></div>");
                                $("#myModal").modal("show");
                            }
                        }
                    }
                    else {
                        var el = $("#myModal").find('.modal-body');
                        el.html("<div class='alert alert-red' style='margin-bottom:10px;'><span>" + response.ErrorMessage + "</span></div>");
                        $("#myModal").modal("show");
                    }

                },
