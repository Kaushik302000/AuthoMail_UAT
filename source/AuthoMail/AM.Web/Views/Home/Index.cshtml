                        break;
                    case "Failed":
                        batchStatus = '<span class="label medium label-red" data-toggle="popover" data-original-title="Error" data-html="true" data-content="' + (this.ValidationErrors == null ? "--" : this.ValidationErrors) + '" data-placement="left">' + this.BatchStatus + '</span>';
                        break;
                    case "ShippedPartial":
                        batchStatus = '<span class="label medium label-orange">' + this.BatchStatus + '</span>';
                        break;
                    case "ShippedAll":
                        batchStatus = '<span class="label medium label-green">' + this.BatchStatus + '</span>';
                        break;

                }
                this.BatchStatusFormatted = batchStatus;
                this.IsEDeliveryRequested = this.IsEDeliveryRequested && !this.IsESignRequested ? '<span class="label medium label-success">E-Delivery</span>' : this.IsEDeliveryRequested && this.IsESignRequested ? '<span class="label medium label-success">E-Sign</span>' : '<span class="label medium label-blue">P&S</span>';
            });
            return Model;
            //console.log(Model);
        }
        function applyDataTable() {
            $('[data-toggle="popover"]').popover({
                'trigger': 'hover',
                'placement': 'auto left',
                'container': 'body'
            });
        }
