@{
    ViewBag.Title = "Home Page";
    var businessId = Html.Action("GetHeadingForBusinessId", "Common");
}

<style>
    .modal-backdrop.in {
        opacity: .75 !important;
        filter: alpha(opacity=75);
    }

    /*.bootstrap-select {
        width: 165px !important;
    }*/

    .popover-content {
        word-wrap: break-word;
        color: red;
    }

    .tooltip-inner {
        /*max-width: 453px !important;*/
        word-wrap: break-word !important;
    }

    .label.label-Edelivery {
        background-color: #20c997;
    }

    .label.label-Esign {
        background-color: #6f42c1;
    }

    .bootstrap-select {
        width: 45% !important;
    }
</style>
<div class="row">
    @*<div class="col-md-6">
            <div class="panel panel-default ">
                <div class="panel-heading">
                    <div class="panel-title">
                        Today's Batch Details
                    </div>
                </div>
                <div class="panel-body panel-gray" style="padding:2% 2% 2% 2% !important;" id="todayBody">
                    <div id="todayChart"></div>
                </div>

            </div>
        </div>*@

    <div class="col-md-6">
        <div class="panel panel-default ">
            <div class="panel-heading">
                <div class="panel-title">
                    Daily Summary Details
                </div>
            </div>
            <div class="panel-body panel-gray" style="        padding: 2% 2% 2% 2% !important;">
                <div id="DailySummaryByDocType"></div>
            </div>

        </div>
    </div>

    <div class="col-md-6">
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <div class="panel-title">Weekly Batch Details</div>
                    </div>
                    <div class="panel-body panel-gray" style="        padding: 2% 2% 2% 2% !important;">
                        <div id="weeklyChart"></div>

                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="col-md-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <div class="panel-title"><i class="fa fa-reply"></i> Quick Pullback</div>
                    </div>
                    <div class="panel-body panel-gray" @(ViewBag.BusinessId.Count == 0 ? Html.Raw("style='padding: 2% 0% 0% 0% !important;height:95px;'") : Html.Raw(""))>
                        <div class="form-group col-md-@(ViewBag.BusinessId.Count==0?"12":ViewBag.BusinessId.Count>1?"9":"8")">

                            @if (ViewBag.BusinessId.Count == 1)
                            {
                                <label for="BusinessFriendlyIdValue">@ViewBag.BusinessId[0]</label>
                                <div class="input-group">
                                    <i class="fa fa-search left-icon"></i>
                                    <input class="form-control" name="loanNumber" placeholder="@ViewBag.BusinessId[0]" required id="BusinessFriendlyIdValue">
                                    <input type="hidden" value="@ViewBag.BusinessId[0]" name="BusinessFriendlyIdName" id="BusinessFriendlyIdName" />
                                </div>
                                <div class="text-red pull-left" style="        display: none" id="BusinessFriendlyIdValueError">This field is required.</div>
                            }
                            else if (ViewBag.BusinessId.Count > 1)
                            {
                                <label for="BusinessFriendlyIdName">Select Business ID</label>
                                <div class="input-group">

                                    <select id="BusinessFriendlyIdName" class="selectpicker" data-live-search="true" data-live-search-placeholder="Search Business ID">
                                        <option value="">Select BusinessId</option>
                                        @foreach (var item in ViewBag.BusinessId)
                                        {
                                            <option value="@item.ToString()">@item.ToString()</option>
                                        }
                                    </select>
                                    <input class="form-control" name="BusinessFriendlyIdValue" placeholder="" required id="BusinessFriendlyIdValue">

                                </div>
                                <div class="text-red pull-left" style="        display: none" id="BusinessFriendlyIdNameError">This field is required.</div>
                                <div class="text-red pull-right" style="        display: none" id="BusinessFriendlyIdValueError">This field is required.</div>
                            }
                            else
                            {
                                <style>
                                    #pullback {
                                        display: none;
                                    }
                                </style>
                                <div class='alert alert-yellow'><span>No business friendly id found!</span></div>
                            }


                        </div>
                        <div class="form-group text-center col-md-1">

                            <label for="pullback">&nbsp;&nbsp;&nbsp;</label>
                            <button type="button" id="pullback" class="btn btn-primary ">
                                <span class="sr-only"></span>
                                <i class="fa fa-reply fa-2x" style="        margin-top: 24%;"></i>

                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>


</div>
<div class="clearfix"></div>


