            RequestPullback();
        });

        $("#yesPullback").unbind("click").click(function (e) {
            e.preventDefault();
            $("#confirmModal").modal("hide");
            var mailpieceId = $("#pullbackbodyContent").find(".mailpieceid").data("mailpieceid");
