<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="log4net" type="System.Configuration.IgnoreSectionHandler" />
	</configSections>

	<log4net>
		<root>
			<level value="ALL" />
			<!--<appender-ref ref="CitiVMAgent" />-->
		</root>

		<logger name="PCI.Service.Program">
			<level value="DEBUG" />
			<appender-ref ref="Program" />
		</logger>
		<logger name="PCI.Service.PnSJobMonitor">
			<level value="DEBUG" />
			<appender-ref ref="PnSJobMonitor" />
		</logger>
		<logger name="PCI.Service.PnSCoreService">
			<level value="DEBUG" />
			<appender-ref ref="PnSCoreService" />
		</logger>
		<logger name="PCI.Service.PCIJobMonitor">
			<level value="DEBUG" />
			<appender-ref ref="PCIJobMonitor" />
		</logger>

		<!--Define some output appenders-->
		<appender name="Program" type="log4net.Appender.RollingFileAppender">
			<file value="\\Cmsuw1gefiler01\pns\AuthoMail\APPLICATIONS_FILES\PnSService\" />
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<datePattern type="log4net.Util.PatternString" value="'logs'\\yyyyMMdd\\'Program-%property{args}.log'" />
			<staticLogFileName value="false" />
			<layout type="log4net.Layout.PatternLayout">
				<header value="[APP START]%newline" type="log4net.Util.PatternString" />
				<footer value="[APP END]%newline" type="log4net.Util.PatternString" />
				<conversionPattern value="%date [%thread] %-5level - %message%newline" />
			</layout>
		</appender>

		<appender name="PnSJobMonitor" type="log4net.Appender.RollingFileAppender">
			<file value="\\Cmsuw1gefiler01\pns\AuthoMail\APPLICATIONS_FILES\PnSService\" />
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<datePattern type="log4net.Util.PatternString" value="'logs'\\yyyyMMdd\\'PnSJobMonitor-%property{args}.log'" />
			<staticLogFileName value="false" />
			<layout type="log4net.Layout.PatternLayout">
				<header value="[APP START]%newline" type="log4net.Util.PatternString" />
				<footer value="[APP END]%newline" type="log4net.Util.PatternString" />
				<conversionPattern value="%date [%thread] %-5level - %message%newline" />
			</layout>
		</appender>

		<appender name="PnSCoreService" type="log4net.Appender.RollingFileAppender">
			<file value="\\Cmsuw1gefiler01\pns\AuthoMail\APPLICATIONS_FILES\PnSService\" />
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<datePattern type="log4net.Util.PatternString" value="'logs'\\yyyyMMdd\\'PnSCoreService-%property{args}.log'" />
			<staticLogFileName value="false" />
			<layout type="log4net.Layout.PatternLayout">
				<header value="[APP START]%newline" type="log4net.Util.PatternString" />
				<footer value="[APP END]%newline" type="log4net.Util.PatternString" />
				<conversionPattern value="%date [%thread] %-5level - %message%newline" />
			</layout>
		</appender>

		<appender name="PCIJobMonitor" type="log4net.Appender.RollingFileAppender">
			<file value="\\Cmsuw1gefiler01\pns\AuthoMail\APPLICATIONS_FILES\PnSService\" />
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<datePattern type="log4net.Util.PatternString" value="'logs'\\yyyyMMdd\\'PCIJobMonitor-%property{args}.log'" />
			<staticLogFileName value="false" />
			<layout type="log4net.Layout.PatternLayout">
				<header value="[APP START]%newline" type="log4net.Util.PatternString" />
				<footer value="[APP END]%newline" type="log4net.Util.PatternString" />
				<conversionPattern value="%date [%thread] %-5level - %message%newline" />
			</layout>
		</appender>
	</log4net>
</configuration>