<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="dataConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Data.Configuration.DatabaseSettings, Microsoft.Practices.EnterpriseLibrary.Data, Version=6.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" requirePermission="true" />
	</configSections>
	<dataConfiguration defaultDatabase="PCIPnS" />
	<connectionStrings>
		<!--<add name="PCIPnS" connectionString="Data Source=cet_01_ps_sq_uw1_reg.data.solutions.corelogic.com;Initial Catalog=AuthoMail;User Id=AuthomailUser;Password=Authomail@User;pooling=true;Connection Timeout=120;" providerName="System.Data.SqlClient" />-->
    <!--<add name="PCIPnS" connectionString="Data Source=cet_01_ps_sq_uw1_reg.data.solutions.corelogic.com;Initial Catalog=AuthoMail;User Id=AuthomailUser;Password=Authomail@User;pooling=true;Connection Timeout=120;" providerName="System.Data.SqlClient" />-->
    <add name="PCIPnS" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=AuthoMail;Integrated Security=True" providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
    <add key="UseUSPSV3API" value="true"/>
		<!--log4net configuration-->
		<add key="log4net.Config" value="log4net.config" />
		<add key="log4net.Config.Watch" value="True" />

		<!--Barcode Location and Size Details-->
		<add key="BarcodeTopMargin" value="1.4"/>
		<add key="BarcodeBottomMargin" value="1.20"/>
		<add key="BarcodeLeftMargin" value="1.20"/>
		<add key="BarcodeRightMargin" value="2.35"/>

		<!--Sequence Numbering Position details-->
		<add key="TopMargin" value="0.625" />
		<add key="BottomMargin" value="0.625" />
		<add key="LeftMargin" value="0.625" />
		<add key="RightMargin" value="0.625" />
		<add key="TemplateSize" value="24" />
		<add key="ActualSizeInch" value="0.3125" />
		<add key="WhiteSpace" value="5" />

		<!--Email Notification Template-->
		<add key="SubmitBatchEmailTemplate" value="\\cmsuw1gefiler01\pns\AuthoMail\APPLICATIONS_FILES\PnSService\Templates\SubmitBatch.html" />
		<add key="SuspendBatchEmailTemplate" value="\\cmsuw1gefiler01\pns\AuthoMail\APPLICATIONS_FILES\PnSService\Templates\SuspendedBatch.html" />

		<!-- Send Mail To PCI Team -->
		<add key="SubmitBatchEmailSubject" value="Batch Submitted To {0} : {1} at {2} Total Files : {3} Total Page Count : {4}" />
		<add key="Email_ToPCI" value="CoreLogic.PrintProduction@pcigroup.com,opsmail@pcigroup.com" />
		<add key="Email_CcPCI" value="ramin@corelogic.com,avala@corelogic.com,vmungara@corelogic.com,brpatel@corelogic.com,rmcfarlane@corelogic.com,psatishkumar@corelogic.com,psatishkumar@corelogic.com,trreese@corelogic.com,MiWood@corelogic.com,SStubbs@corelogic.com,bkeyur@corelogic.com,mmrutyunjaya@corelogic.com,spavan@corelogic.com,smanikonda@corelogic.com,geofernandez@corelogic.com" />

		<!-- Send Mail To Dallas CoreLogic Team -->
		<add key="Email_ToCL" value="hsbcprint&amp;ship.slx@corelogic.com" />
		<add key="Email_CcCL" value="avala@corelogic.com,ramin@corelogic.com,vmungara@corelogic.com,mmrutyunjaya@corelogic.com,spavan@corelogic.com" />

		<!-- Suspend Email Notification -->
		<add key="SuspendBatchEmailSubject" value="URGENT: Batch Suspended For Batch-ID: " />
		<add key="SuspendEmail_To" value="vmungara@corelogic.com" />
		<add key="SuspendEmail_Cc" value="ramin@corelogic.com,avala@corelogic.com" />

		<!-- MRDF Validations -->
		<add key="MRDFResponseLength" value="915" />
		<add key="NoRecordsInMRDFSubject" value="INCOMPLETE RETURN MAP : PRODUCTION"/>

		<!-- PCI Email Notification -->
		<add key="PCI_Issue_Email_To" value="CoreLogic.PrintProduction@pcigroup.com,D.Rojas@pcigroup.com" />
		<add key="PCI_Issue_Email_Cc" value="ramin@corelogic.com,avala@corelogic.com,khupatel@corelogic.com,vmungara@corelogic.com,brpatel@corelogic.com" />

		<!-- NORDIS Email Notification -->
		<add key="NORDIS_Issue_Email_To" value="ramin@corelogic.com" />
		<add key="NORDIS_Issue_Email_Cc" value="avala@corelogic.com,vmungara@corelogic.com,brpatel@corelogic.com,dipen.dave@msdgtl.com" />

		<!-- Unexpected Error Email Notification -->
		<add key="UnexpectedEmail_Subject" value="PROD : Unexpected Error Occured in PnSCore Service"/>
		<add key="UnexpectedEmail_ToEmail" value="ramin@corelogic.com,brpatel@corelogic.com,printandshipescalation.slx@corelogic.com"/>
		<add key="UnexpectedEmailInternal_CcEmail" value="ramin@corelogic.com,dchhatriwala@corelogic.com"/>
		<add key="UnexpectedEmail_CcEmail" value="ramin@msdgtl.com,dipen.dave@msdgtl.com"/>

	</appSettings>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
	</startup>
	<system.net>
		<mailSettings>
			<smtp deliveryMethod="Network" from="donotreply@corelogic.com">
				<network host="smtp.solutions.corelogic.com" defaultCredentials="true" />
			</smtp>
		</mailSettings>
	</system.net>
</configuration>